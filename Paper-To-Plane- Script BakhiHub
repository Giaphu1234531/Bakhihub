			local function searchInWorkspace()
				local npcsFolder = workspace:FindFirstChild("AirplaneShopNPCs")
				if npcsFolder then
					local directNpc = npcsFolder:FindFirstChild("Shop_W" .. tostring(wantedWorld))
					local directHrp = extractNpcRoot(directNpc)
					if directHrp then
						return directHrp
					end

					for _, npc in ipairs(npcsFolder:GetChildren()) do
						local hrp = extractNpcRoot(npc)
						if hrp then
							local npcWorld = tonumber(npc:GetAttribute("ShopWorld")) or tonumber(npc:GetAttribute("World"))
							local hasTalkPrompt = false
							for _, desc in ipairs(npc:GetDescendants()) do
								if desc:IsA("ProximityPrompt") and (desc:GetAttribute("ShowroomTalk") == true or desc.Name:lower():find("paper") or desc.ActionText:lower():find("paper")) then
									hasTalkPrompt = true
									npcWorld = npcWorld or tonumber(desc:GetAttribute("ShopWorld")) or tonumber(desc:GetAttribute("World"))
									break
								end
							end
							if not npcWorld and gameApi.WorldConfig and type(gameApi.WorldConfig.AtPosition) == "function" then
								local w = gameApi.WorldConfig.AtPosition(hrp.Position)
								npcWorld = w and tonumber(w.WorldId)
							end
							if npcWorld == wantedWorld and (hasTalkPrompt or npc.Name:find("Shop", 1, true)) then
								return hrp
							end
						end
					end
				end

				-- Kiểm tra tham chiếu PlaneShop trong World <id>.Gameplay
				local worldFolder = workspace:FindFirstChild("World " .. tostring(wantedWorld))
				local gameplayFolder = worldFolder and worldFolder:FindFirstChild("Gameplay")
				local planeShopRef = gameplayFolder and gameplayFolder:FindFirstChild("PlaneShop")
				if planeShopRef then
					for _, desc in ipairs(planeShopRef:GetDescendants()) do
						if desc:IsA("ProximityPrompt") and (desc:GetAttribute("ShowroomTalk") == true or desc.ActionText:lower():find("paper")) then
							local model = desc:FindFirstAncestorWhichIsA("Model")
							local hrp = extractNpcRoot(model) or (desc.Parent and desc.Parent:IsA("BasePart") and desc.Parent)
							if hrp then
								return hrp
							end
						end
					end
				end

				return nil
			end

			local bestHrp = searchInWorkspace()
			if not bestHrp then
				-- Khi đứng xa NPC trên Training map, dịch chuyển theo chặng tới khu vực Shop/Spawn của World hiện tại để nạp Instance NPC thực tế
				local anchors = getWorldAnchorCandidates(wantedWorld)
				for _, anchor in ipairs(anchors) do
					if not state.isRunning or not state.isAutoBuyPaperOn then
						break
					end

					character, _, root = findAliveCharacter()
					if character and root then
						safeTeleport(character, anchor + Vector3.new(0, 3, 0), anchor + Vector3.new(0, 3, 5), 12, false)
					end

					for _ = 1, 10 do
						bestHrp = searchInWorkspace()
						if bestHrp then
							break
						end
						task.wait(0.15)
					end
					if bestHrp then
						break
					end
				end
			end

			if bestHrp then
				local npcCF = bestHrp.CFrame
				local npcPos = npcCF.Position
				local lookDir = Vector3.new(npcCF.LookVector.X, 0, npcCF.LookVector.Z)
				lookDir = if lookDir.Magnitude > 0.05 then lookDir.Unit else Vector3.new(0, 0, 1)
				-- Đứng trước mặt NPC 5.5 studs (nằm gọn trong bán kính 17 studs của PaperShopUI)
				local standPos = groundStandPos(character, npcPos + lookDir * 5.5, npcPos.Y + 3)
