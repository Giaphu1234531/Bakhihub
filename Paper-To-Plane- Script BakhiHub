		state.leash.anchorPos = nil
		state.leash.lookPos = nil
		if state.heartbeatConn and not state.isAutoThrowOn then
			pcall(state.heartbeatConn.Disconnect, state.heartbeatConn)
			state.heartbeatConn = nil
		end
