	local function restoreTableTriggers()
		for part, saved in pairs(state.suppressedTriggers) do
			if typeof(part) == "Instance" and part.Parent then
				pcall(function()
					if type(saved) == "table" then
						part.Size = saved.Size
						part.CanTouch = saved.CanTouch
					else
						part.Size = saved
						part.CanTouch = true
					end
				end)
			end
			state.suppressedTriggers[part] = nil
		end
	end

	local function suppressTableTriggers(tableModel)
		if not tableModel then return end
		local t1 = tableModel:FindFirstChild("FoldingTrigger")
		local slotParts = tableModel:FindFirstChild("FoldSlotParts")
		local t2 = slotParts and slotParts:FindFirstChild("FoldingTriggerFar")
		for _, part in ipairs({t1, t2}) do
			if part and part:IsA("BasePart") then
				if not state.suppressedTriggers[part] and part.Size.Magnitude > 0.01 then
					state.suppressedTriggers[part] = {
						Size = part.Size,
						CanTouch = part.CanTouch,
					}
				end
				part.CanTouch = false
				part.Size = Vector3.zero
			end
		end
	end

