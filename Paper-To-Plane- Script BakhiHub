		if type(mapName) == "string" and catalog.MapNameToId[mapName] then
			return catalog.MapNameToId[mapName]
		end
		for wid, name in pairs(catalog.MapNamesById) do
			if name == mapName then
				return wid
			end
		end
		return tonumber(tostring(mapName or ""):match("(%d+)")) or 1
	end

