		local function findBestFoldingTable(worldId, refPosition)
			local character = localPlayer.Character
			local maxSlots = (gameApi.FoldingSlots and gameApi.FoldingSlots.Max) or 4
			local myName = localPlayer.Name
			local myDisplayName = localPlayer.DisplayName

			local candidateModels = {}
			local seenModels = {}

			local function registerTable(tableModel)
				if not tableModel or not tableModel:IsA("Model") or seenModels[tableModel] or not tableModel:IsDescendantOf(workspace) then
					return
				end
				seenModels[tableModel] = true
				local tWorld = tonumber(tableModel:GetAttribute("World"))
				if not tWorld and gameApi.WorldConfig and type(gameApi.WorldConfig.AtPosition) == "function" then
					local w = gameApi.WorldConfig.AtPosition(tableModel:GetPivot().Position)
					tWorld = w and tonumber(w.WorldId)
				end
				if tWorld == nil or tWorld == worldId then
					table.insert(candidateModels, tableModel)
				end
			end

			local worldFolder = workspace:FindFirstChild("World " .. tostring(worldId))
			local gameplayFolder = worldFolder and worldFolder:FindFirstChild("Gameplay")
			local tablesFolder = gameplayFolder and gameplayFolder:FindFirstChild("PaperFoldingTables")
			if tablesFolder then
				for _, child in ipairs(tablesFolder:GetChildren()) do
					if child:IsA("Model") then
						registerTable(child)
					end
				end
			end

			for _, tagged in ipairs(CollectionService:GetTagged("FoldingTable")) do
				local tableModel = tagged:IsA("Model") and tagged or tagged:FindFirstAncestorWhichIsA("Model")
				if tableModel then
					registerTable(tableModel)
				end
			end

			if #candidateModels == 0 then
				local anchor = getMapAnchorPosition(worldId)
				if anchor then
					pcall(function()
						localPlayer:RequestStreamAroundAsync(anchor, 3)
					end)
					task.wait(0.25)
					for _, tagged in ipairs(CollectionService:GetTagged("FoldingTable")) do
						local tableModel = tagged:IsA("Model") and tagged or tagged:FindFirstAncestorWhichIsA("Model")
						if tableModel then
							registerTable(tableModel)
						end
					end
				end
			end

			local bestTable = nil
			local bestFreeSlot = 1
			local bestScore = math.huge

			for _, tableModel in ipairs(candidateModels) do
				local slotsUsed = tonumber(tableModel:GetAttribute("SlotsUsed")) or 0
				local mySlot = nil
				local freeSlot = nil

				for s = 1, maxSlots do
					local occupant = tableModel:GetAttribute("Slot" .. tostring(s) .. "Name")
					if occupant == myName or occupant == myDisplayName then
						mySlot = s
						break
					elseif (occupant == nil or occupant == "") and not freeSlot then
						freeSlot = s
					end
				end

				local chosenSlot = mySlot or freeSlot or 1
				local isFullForMe = (mySlot == nil) and (slotsUsed >= maxSlots or freeSlot == nil)

				local refPart = tableModel:FindFirstChild("FoldingPlayerPosition")
					or tableModel:FindFirstChild("StandPoint")
					or tableModel:FindFirstChild("PaperCenter")
					or tableModel:FindFirstChild("TablePad")
				local pos = (refPart and refPart.Position) or tableModel:GetPivot().Position
				local dist = (pos - refPosition).Magnitude
				local fullPenalty = isFullForMe and 50000 or 0
				local mySeatBonus = mySlot and -500 or 0
				local score = dist + fullPenalty + mySeatBonus

				if score < bestScore then
					bestScore = score
					bestTable = tableModel
					bestFreeSlot = chosenSlot
				end
			end

			if not bestTable then
				return nil, nil, nil
			end

			-- Tele trực tiếp lên ngay trên / sát bề mặt mặt bàn (không tele vào ghế, không xuyên dưới bàn)
			local tableTop = bestTable:FindFirstChild("TableTop")
				or bestTable:FindFirstChild("PaperCenter")
				or bestTable:FindFirstChild("TablePad")
			local paperCenter = bestTable:FindFirstChild("PaperCenter") or tableTop

			local standPos, lookTarget
			if tableTop and tableTop:IsA("BasePart") then
				local centerPos = (paperCenter and paperCenter:IsA("BasePart") and paperCenter.Position) or tableTop.Position
				local surfaceTopY = tableTop.Position.Y + (tableTop.Size.Y * 0.5)
				-- Cao hơn mặt trên cùng của bàn đúng 3.0 studs (chiều cao chân đứng), không xuyên bàn
				standPos = Vector3.new(centerPos.X, surfaceTopY + 3.0, centerPos.Z)
				local forward = tableTop.CFrame.LookVector
				local flatForward = Vector3.new(forward.X, 0, forward.Z)
				flatForward = if flatForward.Magnitude > 0.05 then flatForward.Unit else Vector3.new(0, 0, 1)
				lookTarget = standPos + flatForward * 3
			else
				local standPart = bestTable:FindFirstChild("FoldingPlayerPosition") or bestTable:FindFirstChild("StandPoint")
				local tablePivot = bestTable:GetPivot()
				local basePos = (standPart and standPart.Position) or tablePivot.Position
				standPos = Vector3.new(basePos.X, basePos.Y + 3.0, basePos.Z)
				lookTarget = standPos + tablePivot.LookVector * 3
			end

			return bestTable, standPos, lookTarget
		end

