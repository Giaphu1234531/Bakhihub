		local function engageLeash(standPos, lookPos, maxDist)
			local _, humanoid, root = findAliveCharacter()
			state.leash.active = true
			state.leash.anchorPos = standPos
			state.leash.lookPos = lookPos
			state.leash.maxDist = maxDist or 8
			ensureLeashHeartbeat()

			if humanoid then
				if humanoid.Sit then
					humanoid.Sit = false
				end
				if humanoid.WalkSpeed <= 0 and not localPlayer:GetAttribute("IsTraining") then
					humanoid.WalkSpeed = 16
				end
				humanoid.AutoRotate = true
			end
			if root then
				root.Anchored = false
				local flatDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
				if flatDist > state.leash.maxDist or (root.Position - standPos).Magnitude > state.leash.maxDist + 4 then
					local targetLook = Vector3.new(lookPos.X, standPos.Y, lookPos.Z)
					root.AssemblyLinearVelocity = Vector3.zero
					root.CFrame = CFrame.lookAt(standPos, targetLook)
				else
					local targetLook = Vector3.new(lookPos.X, root.Position.Y, lookPos.Z)
					if (targetLook - root.Position).Magnitude > 0.1 then
						root.CFrame = CFrame.lookAt(root.Position, targetLook)
					end
				end
			end
		end

		function paperSys.LeashHeartbeat()
			if not state.isRunning then
				return
			end
			if not state.isAutoBuyPaperOn and not state.isAutoFoldPaperOn then
				if state.leash.active then
					clearLeash()
				end
				return
			end
			if not state.leash.active or not state.leash.anchorPos or not state.leash.lookPos then
				return
			end
			local _, humanoid, root = findAliveCharacter()
			if not humanoid or not root then
				return
			end
			if root.Anchored then
				root.Anchored = false
			end
			if humanoid.Sit then
				humanoid.Sit = false
			end
			if humanoid.WalkSpeed <= 0 and not localPlayer:GetAttribute("IsTraining") then
				humanoid.WalkSpeed = 16
			end
			local anchor = state.leash.anchorPos
			local look = state.leash.lookPos
			local horizDist = Vector3.new(root.Position.X - anchor.X, 0, root.Position.Z - anchor.Z).Magnitude
			if horizDist > state.leash.maxDist or math.abs(root.Position.Y - anchor.Y) > 12 then
				local targetLook = Vector3.new(look.X, anchor.Y, look.Z)
				root.AssemblyLinearVelocity = Vector3.zero
				root.CFrame = CFrame.lookAt(anchor, targetLook)
			end
		end

