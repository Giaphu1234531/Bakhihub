	end
	local character, _, root = findAliveCharacter()
	if not root or not character then
		return false
	end

	local worldId = getCurrentWorldId(root.Position)
	local currentCoins = getPlayerCoins()
	local currentCycle = (gameApi.PaperShopConfig and type(gameApi.PaperShopConfig.Cycle) == "function")
		and gameApi.PaperShopConfig.Cycle(gameApi.PaperShopConfig.Now()) or 0

	if lastBuyCheck.world == worldId and lastBuyCheck.cycle == currentCycle and currentCoins <= lastBuyCheck.coins then
		return false
	end

	local standPos, npcPos, isExactNpc = findPaperSellerNPC(worldId)
	if not standPos or not npcPos then
		return false
	end

	if not safeTeleport(character, standPos, npcPos) then
		return false
	end

	if not isExactNpc then
		task.wait(0.25)
		local exactStand, exactNpc, found = findPaperSellerNPC(worldId)
		if found and exactStand and exactNpc then
			standPos, npcPos = exactStand, exactNpc
			if not safeTeleport(character, standPos, npcPos) then
				return false
			end
		end
	end

	local okState, shopState = pcall(gameApi.BackendClient.Call, "PaperFolding", "GetShopState", worldId)
	if not okState or type(shopState) ~= "table" or not shopState.ok or type(shopState.Items) ~= "table" then
		clearLeash()
		return false
	end

	local canBuyAnything = false
	for _, rarity in ipairs(state.buyPaperRarities) do
		local paperKey = toInternalPaperKey(rarity)
		local item = shopState.Items[paperKey]
		if item and (tonumber(item.Remaining) or 0) > 0 and getPlayerCoins() >= (tonumber(item.Price) or math.huge) then
			canBuyAnything = true
			break
		end
	end

	if not canBuyAnything then
		lastBuyCheck.world = worldId
		lastBuyCheck.cycle = shopState.Cycle or currentCycle
		lastBuyCheck.coins = getPlayerCoins()
		clearLeash()
		return false
	end

	engageLeash(standPos, npcPos, 8)

	local boughtAny = false
	for _, rarity in ipairs(state.buyPaperRarities) do
		if not state.isRunning or not state.isAutoBuyPaperOn then
			break
		end
		local paperKey = toInternalPaperKey(rarity)
		local item = shopState.Items[paperKey]
		while state.isRunning and state.isAutoBuyPaperOn and item and (tonumber(item.Remaining) or 0) > 0 do
			local price = tonumber(item.Price) or math.huge
			if getPlayerCoins() < price then
				break
			end

			local currentDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
			if currentDist > 10 then
				if not safeTeleport(character, standPos, npcPos) then
					break
				end
			end

			local guid = hs:GenerateGUID(false)
			local okBuy, buyRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "BuyPaper", paperKey, 1, guid, shopState.Cycle)
			if not okBuy or type(buyRes) ~= "table" then
				break
			end
			if type(buyRes.State) == "table" and type(buyRes.State.Items) == "table" then
				shopState = buyRes.State
				item = shopState.Items[paperKey]
			else
				item.Remaining = (tonumber(item.Remaining) or 1) - 1
			end
			if buyRes.ok then
				boughtAny = true
				if gameApi.BackendClient.Profile and type(gameApi.BackendClient.Profile.Papers) == "table" and item and item.PaperId and tonumber(item.Owned) then
					gameApi.BackendClient.Profile.Papers[item.PaperId] = tonumber(item.Owned)
				end
				task.wait(0.2)
			else
				break
			end
		end
	end

	lastBuyCheck.world = worldId
	lastBuyCheck.cycle = shopState.Cycle or currentCycle
	lastBuyCheck.coins = getPlayerCoins()
	clearLeash()
	return boughtAny
end

local function foldSinglePaper(tableModel, standPos, lookPos, paperKey)
	if not state.isRunning or not state.isAutoFoldPaperOn or not gameApi.BackendClient then
		return false
	end

	suppressTableTriggers(tableModel)

	local okSt, stRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "GetState")
	if okSt and type(stRes) == "table" and stRes.ok and type(stRes.Pending) == "table" and stRes.Pending.SessionId then
		pcall(gameApi.BackendClient.Call, "PaperFolding", "Ack", stRes.Pending.SessionId)
	end

	if not state.inFoldTable then
		local okEnt, enterRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Enter")
		if not okEnt or type(enterRes) ~= "table" or not enterRes.ok then
			local _, _, root = findAliveCharacter()
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
				root.CFrame = CFrame.lookAt(standPos, Vector3.new(lookPos.X, standPos.Y, lookPos.Z))
			end
			task.wait(0.25)
			okEnt, enterRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Enter")
			if not okEnt or type(enterRes) ~= "table" or not enterRes.ok then
				return false
			end
		end
		state.inFoldTable = true
	end

	local okStart, startRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Start", paperKey)
	if not okStart or type(startRes) ~= "table" or not startRes.ok or not startRes.SessionId then
		state.inFoldTable = false
		return false
	end

	local sessionId = startRes.SessionId
	state.activeFoldSessionId = sessionId
	local planCount = #gameApi.PaperFoldingConfig.ChallengePlan(paperKey)

	for _ = 1, math.max(planCount, 12) do
		if not state.isRunning or not state.isAutoFoldPaperOn then
			cleanupFoldSession()
			return false
		end

		local ch = nil
		for _ = 1, 30 do
			if not state.isRunning or not state.isAutoFoldPaperOn then
				cleanupFoldSession()
				return false
			end
			local okCh, res = pcall(gameApi.BackendClient.Call, "PaperFolding", "Challenge", sessionId)
			if okCh and type(res) == "table" then
				ch = res
				if ch.ok or not ch.wait then
					break
				end
				task.wait(math.clamp(tonumber(ch.retryIn) or 0.2, 0.05, 1))
			else
				break
			end
		end

		if not ch or not ch.ok then
			cleanupFoldSession()
			return false
		end

		local waitLead = (tonumber(ch.Start) or 0) - workspace:GetServerTimeNow()
		if waitLead > 0 then
			task.wait(waitLead + 0.02)
		end

		if not state.isRunning or not state.isAutoFoldPaperOn then
			cleanupFoldSession()
			return false
		end

		local hitServerTime
		if ch.Kind == "Circle" then
			local targetRadius = ch.TargetRadius
			hitServerTime = ch.Start + (ch.StartRadius - targetRadius) * ch.Duration / ch.StartRadius
		else
			local targetCenter = ch.Center or 0.5
			local t = math.max(workspace:GetServerTimeNow(), ch.Start) + 0.02
			for _ = 1, 4000 do
				if math.abs(gameApi.PaperFoldingConfig.TimingPos(ch, t) - targetCenter) < 0.004 then
					break
				end
				t += 0.001
			end
			hitServerTime = t
		end

		local waitHit = hitServerTime - workspace:GetServerTimeNow()
		if waitHit > 0 then
			task.wait(waitHit)
		end

		if not state.isRunning or not state.isAutoFoldPaperOn then
			cleanupFoldSession()
			return false
		end

		local okHit, hitRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Hit", sessionId, ch.Index, hitServerTime)
		if not okHit or type(hitRes) ~= "table" or not hitRes.ok then
			if type(hitRes) == "table" and hitRes.expired then
				cleanupFoldSession()
				return false
			end
		elseif hitRes.Done then
			state.activeFoldSessionId = nil
			local ackId = (type(hitRes.Result) == "table" and hitRes.Result.SessionId) or sessionId
			pcall(gameApi.BackendClient.Call, "PaperFolding", "Ack", ackId)
			return true
		end
	end

	state.activeFoldSessionId = nil
	return true
end

local function performAutoFoldPhase()
	if not state.isAutoFoldPaperOn or #state.foldPaperRarities == 0 or not gameApi.BackendClient then
		return false
	end
	local character, _, root = findAliveCharacter()
	if not root or not character then
		return false
	end

	local worldId = getCurrentWorldId(root.Position)
	if not hasSelectedFoldablePaper(worldId) then
		return false
	end

	local tableModel, standPos, lookPos = findNearestFoldingTable(worldId, root.Position)
	if not tableModel or not standPos or not lookPos then
		return false
	end

	if not safeTeleport(character, standPos, lookPos) then
		return false
	end

	engageLeash(standPos, lookPos, 5)

	local foldedAny = false
	while state.isRunning and state.isAutoFoldPaperOn do
		local nextPaperKey = nil
		for _, rarity in ipairs(state.foldPaperRarities) do
			local pKey = toInternalPaperKey(rarity)
			if getOwnedPaperCount(worldId, pKey) > 0 then
				nextPaperKey = pKey
				break
			end
		end

		if not nextPaperKey then
			break
		end

		local currentDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
		if currentDist > 7 then
			if not safeTeleport(character, standPos, lookPos) then
				break
			end
		end

		local success = foldSinglePaper(tableModel, standPos, lookPos, nextPaperKey)
		if success then
			foldedAny = true
			task.wait(0.15)
		else
			task.wait(0.4)
			break
		end
	end

	if state.inFoldTable and (not state.isAutoFoldPaperOn or state.isAutoBuyPaperOn or not hasSelectedFoldablePaper(worldId)) then
		cleanupFoldSession()
	end

	clearLeash()
	restoreTableTriggers()
	return foldedAny
end

local function runFoldAndBuyJob(job)
	while isJobRunning(job) do
		if not gameApi.Ready then
			task.wait(0.5)
			continue
		end

		if state.isAutoBuyPaperOn and state.isAutoFoldPaperOn then
			pcall(performAutoBuyPhase)
			if state.isRunning and state.isAutoFoldPaperOn then
				pcall(performAutoFoldPhase)
			end
			task.wait(0.5)
		elseif state.isAutoBuyPaperOn then
			if state.inFoldTable then cleanupFoldSession() end
			pcall(performAutoBuyPhase)
			task.wait(0.8)
		elseif state.isAutoFoldPaperOn then
			pcall(performAutoFoldPhase)
			task.wait(0.8)
		else
			if state.leash.active then clearLeash() end
			task.wait(0.4)
		end
	end
end

-- ================= HỆ THỐNG AUTO OPEN EGG HỢP NHẤT (MAP + BALO) =================
local function getOwnedEggCount(eggId)
	if not gameApi.BackendClient or type(gameApi.BackendClient.Profile) ~= "table" then
		return 0
	end
	local eggs = gameApi.BackendClient.Profile.Eggs
	if type(eggs) ~= "table" then
		return 0
	end
	return math.floor(tonumber(eggs[eggId]) or 0)
end

local function syncProfileFromResponse(res)
	if type(res) ~= "table" or not gameApi.BackendClient then
		return
	end
	if type(res.data) == "table" then
		gameApi.BackendClient.Profile = res.data
	elseif type(res.Profile) == "table" then
		gameApi.BackendClient.Profile = res.Profile
	end
end

local function isEggActionBlocked(character)
	if not character then return true end
	if character:GetAttribute("PlaneThrowPhase") ~= nil then return true end
	if localPlayer:GetAttribute("IsTraining") == true then return true end
	if localPlayer:GetAttribute("WorldTransition") == true then return true end
	if localPlayer:GetAttribute("IsFolding") == true then return true end
	if localPlayer:GetAttribute("CutscenePreviewing") == true then return true end
	return false
end

local function getMapAnchorPosition(worldId)
	if gameApi.WorldConfig and type(gameApi.WorldConfig.Worlds) == "table" then
		for _, world in pairs(gameApi.WorldConfig.Worlds) do
			if tonumber(world.WorldId) == worldId and type(world.LaunchZone) == "string" then
				local zone = resolveInstancePath(world.LaunchZone)
				local region = zone and zone:FindFirstChild("LaunchRegion")
				if region and region:IsA("BasePart") then
					return region.Position
				end
			end
		end
	end
	if gameApi.WorldAirplaneShopConfig and type(gameApi.WorldAirplaneShopConfig.Get) == "function" then
		local shopCfg = gameApi.WorldAirplaneShopConfig.Get(worldId)
		if shopCfg and shopCfg.Exterior and shopCfg.Exterior.Position then
			return shopCfg.Exterior.Position
		end
	end
	return nil
end

local function moveToMapEgg(character, root, eggId, targetWorldId)
	local eggModel = gameApi.PetEggConfig and type(gameApi.PetEggConfig.WorldEgg) == "function"
		and gameApi.PetEggConfig.WorldEgg(eggId, root.Position) or nil

	if not eggModel then
		local mapAnchor = getMapAnchorPosition(targetWorldId)
		if mapAnchor then
			pcall(function()
				localPlayer:RequestStreamAroundAsync(mapAnchor, 3)
			end)
			if (root.Position - mapAnchor).Magnitude > 120 then
				local anchorStand = groundStandPos(character, mapAnchor, mapAnchor.Y)
				root.Anchored = false
				root.AssemblyLinearVelocity = Vector3.zero
				character:PivotTo(CFrame.new(anchorStand))
				task.wait(0.45)
			end
		end
		eggModel = gameApi.PetEggConfig and type(gameApi.PetEggConfig.WorldEgg) == "function"
			and gameApi.PetEggConfig.WorldEgg(eggId, root.Position) or nil
	end

	if not eggModel then
		return nil
	end

	local eggPivot = eggModel:GetPivot()
	local eggPos = eggPivot.Position
	local hatchRange = (gameApi.PetEggConfig and tonumber(gameApi.PetEggConfig.HatchRange)) or 20
	local flatDist = ((eggPos - root.Position) * Vector3.new(1, 0.5, 1)).Magnitude

	if flatDist <= (hatchRange - 5) then
		return eggModel
	end

	local offsetDir = Vector3.new(root.Position.X - eggPos.X, 0, root.Position.Z - eggPos.Z)
	if offsetDir.Magnitude < 0.1 then
		offsetDir = -eggPivot.LookVector * Vector3.new(1, 0, 1)
	end
	offsetDir = if offsetDir.Magnitude > 0.05 then offsetDir.Unit else Vector3.new(0, 0, 1)

	local rawStand = eggPos + offsetDir * 6
	local standPos = groundStandPos(character, rawStand, eggPos.Y)
	if safeTeleport(character, standPos, eggPos) then
		return eggModel
	end
	return nil
end

local function getPreferredMapHatchCount(eggDef, coins)
	local price = tonumber(eggDef.Price) or 0
	if price <= 0 then return 1 end
	local petEggCfg = gameApi.PetEggConfig
	if petEggCfg and type(petEggCfg.Products) == "table" then
		local bestCount = 1
		for _, prod in ipairs(petEggCfg.Products) do
			local cnt = tonumber(prod.Count) or 1
			if prod.Key and localPlayer:GetAttribute("Pass_" .. tostring(prod.Key)) == true then
				if cnt > bestCount and coins >= price * cnt then
					bestCount = cnt
				end
			end
		end
		if bestCount > 1 then
			return bestCount
		end
	end
	if petEggCfg and type(petEggCfg.Counts) == "table" and petEggCfg.Counts[2] == true then
		local multi = tonumber(petEggCfg.MultiCount) or 2
		if multi > 1 and coins >= price * multi then
			return multi
		end
	end
	return 1
end

local function getActiveSelectedEggsForMap(targetWorldId)
	local list = {}
	local mapSelected = state.selectedEggsByMap[targetWorldId] or {}
	for _, eggId in ipairs(eggCatalog.Order) do
		if mapSelected[eggId] or state.selectedEggIds[eggId] then
			local info = eggCatalog.ById[eggId]
			if info and (info.World == targetWorldId or info.Event) then
				table.insert(list, info)
			end
		end
	end
	return list
end

local function getAutoOpenStatusText()
	local targetWorldId = getMapIdByName(state.selectedEggMap)
	local mapName = getMapNameById(targetWorldId)
	local activeEggs = getActiveSelectedEggsForMap(targetWorldId)
	if #activeEggs == 0 then
		return string.format("%s | Selected Eggs: None", mapName)
	end
	local items = {}
	local totalOwned = 0
	for _, info in ipairs(activeEggs) do
		local owned = getOwnedEggCount(info.Id)
		totalOwned += owned
		table.insert(items, string.format("%s (%d)", info.Name, owned))
	end
	return string.format("%s | Bag: %d\n%s", mapName, totalOwned, table.concat(items, " | "))
end

local function runUnifiedAutoOpenEgg(job)
	local triedProfile = false
	while isJobRunning(job) do
		if not gameApi.Ready or not state.isAutoOpenEggOn or not gameApi.BackendClient then
			task.wait(0.35)
			continue
		end

		if type(gameApi.BackendClient.Profile) ~= "table" and not triedProfile then
			triedProfile = true
			local okProf, profRes = pcall(gameApi.BackendClient.Call, "GetProfile")
			if okProf and type(profRes) == "table" and profRes.ok and type(profRes.data) == "table" then
				gameApi.BackendClient.Profile = profRes.data
			end
		end

		local character, _, root = findAliveCharacter()
		if not character or not root or isEggActionBlocked(character) then
			task.wait(0.4)
			continue
		end

		local targetWorldId = getMapIdByName(state.selectedEggMap)
		local activeEggs = getActiveSelectedEggsForMap(targetWorldId)
		if #activeEggs == 0 then
			task.wait(0.5)
			continue
		end

		local didAction = false
		local cooldown = (gameApi.PetEggConfig and tonumber(gameApi.PetEggConfig.Cooldown)) or 0.6

		for _, eggInfo in ipairs(activeEggs) do
			if not isJobRunning(job) or not state.isAutoOpenEggOn then
				break
			end

			local eggId = eggInfo.Id

			-- 1. Mở toàn bộ trứng có sẵn trong balo (Owned Eggs) qua HatchOwnedEgg
			while isJobRunning(job) and state.isAutoOpenEggOn do
				local ownedCount = getOwnedEggCount(eggId)
				if ownedCount <= 0 then
					break
				end

				local okCall, res = pcall(gameApi.BackendClient.Call, "HatchOwnedEgg", eggId)
				if not okCall or type(res) ~= "table" then
					task.wait(0.4)
					break
				end
				if res.busy then
					task.wait(0.2)
					continue
				end
				if res.ok then
					didAction = true
					syncProfileFromResponse(res)
					if type(gameApi.BackendClient.Profile) == "table" and type(gameApi.BackendClient.Profile.Eggs) == "table" then
						if getOwnedEggCount(eggId) >= ownedCount then
							gameApi.BackendClient.Profile.Eggs[eggId] = math.max(0, ownedCount - 1)
						end
					end
					task.wait(math.max(0.25, cooldown))
				else
					task.wait(0.6)
					break
				end
			end

			if not isJobRunning(job) or not state.isAutoOpenEggOn then
				break
			end

			-- 2. Tự động di chuyển đến map đã chọn và mở đúng loại trứng tại map qua HatchEgg
			local eggDef = gameApi.PetEggConfig and gameApi.PetEggConfig.Eggs and gameApi.PetEggConfig.Eggs[eggId]
			if eggDef and not eggDef.RobuxOnly and (tonumber(eggDef.Price) or 0) > 0 and gameApi.HatchEgg then
				local coins = getPlayerCoins()
				if coins >= eggDef.Price then
					character, _, root = findAliveCharacter()
					if character and root and not isEggActionBlocked(character) then
						local eggModel = moveToMapEgg(character, root, eggId, targetWorldId)
						if eggModel then
							local hatchCount = getPreferredMapHatchCount(eggDef, coins)
							local okInvoke, hatchRes = pcall(gameApi.HatchEgg.InvokeServer, gameApi.HatchEgg, eggId, hatchCount)
							if okInvoke and type(hatchRes) == "table" and hatchRes.ok then
								didAction = true
								syncProfileFromResponse(hatchRes)
								task.wait(math.max(0.25, cooldown))
							elseif hatchCount > 1 then
								local okSingle, singleRes = pcall(gameApi.HatchEgg.InvokeServer, gameApi.HatchEgg, eggId, 1)
								if okSingle and type(singleRes) == "table" and singleRes.ok then
									didAction = true
									syncProfileFromResponse(singleRes)
									task.wait(math.max(0.25, cooldown))
								else
									task.wait(0.5)
								end
							else
								task.wait(0.5)
							end
						end
					end
				end
			end
		end

		if not didAction then
			task.wait(0.45)
		end
	end
end

-- Main Automation Job for Auto Farm & Auto Rebirth
local function runAutoFarmLogic(job)
	local requestCount = 90000
	local lastRebirthAttempt = 0
	local lastTrainActionTime = 0
	
	while isJobRunning(job) do
		task.wait(0.5)
		
		-- AUTO REBIRTH
		if state.isAutoRebirthOn and os.clock() - lastRebirthAttempt > 3 then
			local canRebirth = localPlayer:GetAttribute("CanRebirth")
			local capped = localPlayer:GetAttribute("RebirthCapped")
			local lvl = localPlayer:GetAttribute("Level") or 0
			local maxLvl = localPlayer:GetAttribute("MaxLevel") or 1
			
			if canRebirth and not capped and lvl >= maxLvl then
				lastRebirthAttempt = os.clock()
				pcall(function()
					if gameApi.RebirthRemote:IsA("RemoteFunction") then
						gameApi.RebirthRemote:InvokeServer()
					elseif gameApi.RebirthRemote:IsA("RemoteEvent") then
						gameApi.RebirthRemote:FireServer()
					end
				end)
			end
		end
		
		-- AUTO BEST TRAINING
		if state.isAutoTrainOn and os.clock() - lastTrainActionTime > 1.5 then
			local playerRebirths = 0
			if localPlayer:FindFirstChild("leaderstats") and localPlayer.leaderstats:FindFirstChild("Rebirths") then
				playerRebirths = localPlayer.leaderstats.Rebirths.Value
			end
			
			local unlockedWorld = localPlayer:GetAttribute("UnlockedWorld") or 1
			local bestZoneId = 1
			local bestMult = 0
			
			if gameApi.TrainingConfig and gameApi.TrainingConfig.Zones then
				for id, zone in pairs(gameApi.TrainingConfig.Zones) do
					if zone.WorldId <= unlockedWorld then
						local isUnlocked = true
						if zone.Premium then
							isUnlocked = localPlayer:GetAttribute("Pass_" .. zone.PassKey) == true
						else
							isUnlocked = playerRebirths >= (zone.RequiredRebirths or 0)
						end
						
						if isUnlocked then
							local mult = zone.TrainingMultiplier or zone.PremiumMultiplier or 0
							if mult > bestMult then
								bestMult = mult
								bestZoneId = zone.Id
							end
						end
					end
				end
			end
			
			local tState = localPlayer:GetAttribute("TrainingClientState")
			local character = localPlayer.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			local currentZone = localPlayer:GetAttribute("TrainingZone")
			
			if hrp then
				if tState == "OUTSIDE" or tState == "WAIT_FOR_REENTRY" or tState == nil or (currentZone ~= bestZoneId and currentZone ~= nil) then
					local zoneModel = gameApi.TrainingConfig.Model(bestZoneId)
					if zoneModel then
						local targetPart = zoneModel:FindFirstChild("Region") or zoneModel:FindFirstChild("Pad")
						if targetPart then
							hrp.CFrame = targetPart.CFrame
							lastTrainActionTime = os.clock()
						end
					end
				elseif tState == "READY" then
					requestCount += 1
					pcall(function()
						gameApi.TrainingRemote:FireServer("Start", requestCount)
					end)
					lastTrainActionTime = os.clock()
				end
			end
		end
	end
end

