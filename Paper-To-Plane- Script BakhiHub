		end

		local requestCount = 90000
		local lastRebirthAttempt = 0
		local lastTrainActionTime = 0
		local arrivedAtZoneAt = 0
		local arrivedZoneId = nil
		local activeTrainedZoneId = nil
		local lastObservedWorldId = nil
		local lastObservedProgressSig = ""
		local unusableZoneUntil = {}
		local zoneEntryAttempts = {}
		local isRearPauseRunning = false

		function trainSys.ExitIfTraining()
			local tState = localPlayer:GetAttribute("TrainingClientState")
			local isTrainingAttr = localPlayer:GetAttribute("IsTraining") == true
			if (isTrainingAttr or tState == "TRAINING" or tState == "ACTIVE") and gameApi.TrainingRemote then
