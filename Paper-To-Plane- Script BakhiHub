			local currentCycle = gameApi.PaperShopConfig and type(gameApi.PaperShopConfig.Cycle) == "function"
				and type(gameApi.PaperShopConfig.Now) == "function"
				and gameApi.PaperShopConfig.Cycle(gameApi.PaperShopConfig.Now()) or nil
			local currentCoins = getPlayerCoins()

			-- Nếu trong cùng đợt restock (Cycle) này shop đã hết hàng hoặc người chơi chưa đủ tiền -> dừng kiểm tra & không Tele lặp
			if shopSkipCache.worldId == worldId
				and shopSkipCache.cycle ~= nil
				and shopSkipCache.cycle == currentCycle
				and shopSkipCache.raritiesSig == raritiesSig
			then
				if shopSkipCache.outOfStock then
					if state.leash.active and not state.isAutoFoldPaperOn then
						clearLeash()
					end
					return false
				end
				local canAffordNow = shopSkipCache.minNeededPrice ~= nil and currentCoins >= shopSkipCache.minNeededPrice
				if not canAffordNow then
					if state.leash.active and not state.isAutoFoldPaperOn then
						clearLeash()
					end
					return false
				end
			end

			-- Kiểm tra nhanh giá tối thiểu theo cấu hình trước khi gọi Server hoặc Tele
			local cfgMinPrice = getMinSelectedConfigPrice(worldId)
			if cfgMinPrice and currentCoins < cfgMinPrice then
				shopSkipCache.worldId = worldId
				shopSkipCache.cycle = currentCycle
				shopSkipCache.raritiesSig = raritiesSig
				shopSkipCache.minNeededPrice = cfgMinPrice
				shopSkipCache.outOfStock = false
				shopSkipCache.checkedAt = os.clock()
				if state.leash.active and not state.isAutoFoldPaperOn then
					clearLeash()
				end
				return false
			end

			-- Thử kiểm tra trạng thái shop trước khi dịch chuyển; nếu server từ chối do khoảng cách xa thì vẫn tiến hành Tele tới NPC trước rồi kiểm tra lại
			local okState, shopState = pcall(gameApi.BackendClient.Call, "PaperFolding", "GetShopState", worldId)
			if okState and type(shopState) == "table" and shopState.ok and type(shopState.Items) == "table" then
				local checkWorldId = tonumber(shopState.World) or worldId
				local preQueueCount = 0
				local minPriceInStock = nil
				for _, rarity in ipairs(state.buyPaperRarities) do
					local paperKey = toInternalPaperKey(rarity)
					local item = shopState.Items[paperKey]
					if type(item) == "table" then
						local remaining = tonumber(item.Remaining) or 0
						local price = tonumber(item.Price)
							or (gameApi.PaperFoldingConfig and type(gameApi.PaperFoldingConfig.Price) == "function" and gameApi.PaperFoldingConfig.Price(checkWorldId, paperKey))
						if remaining > 0 and price and price >= 0 then
							if not minPriceInStock or price < minPriceInStock then
								minPriceInStock = price
							end
							if currentCoins >= price then
								preQueueCount += 1
							end
						end
					end
				end

				-- Nếu không đủ tiền hoặc NPC không có giấy bán -> dừng ngay, không Tele
				if preQueueCount == 0 then
					shopSkipCache.worldId = worldId
					shopSkipCache.cycle = shopState.Cycle or currentCycle
					shopSkipCache.raritiesSig = raritiesSig
					shopSkipCache.minNeededPrice = minPriceInStock
					shopSkipCache.outOfStock = (minPriceInStock == nil)
					shopSkipCache.checkedAt = os.clock()
					if state.leash.active and not state.isAutoFoldPaperOn then
						clearLeash()
					end
					return false
				end
			else
				shopState = nil
			end

			shopSkipCache.cycle = nil

			-- Bước 2: Thoát Training/bàn gấp (nếu có) rồi Tele từ khoảng cách xa đến đúng NPC
			exitTrainingIfNeeded()

			if state.inFoldTable or state.activeFoldSessionId then
				cleanupFoldSession()
				restoreTableTriggers()
				task.wait(0.15)
			end

			local standPos, npcPos, npcHrp = findPaperSellerNPC(worldId)
			if not standPos or not npcPos then
				return false
			end

			character, _, root = findAliveCharacter()
			if not character or not root then
				return false
			end

			if not safeTeleport(character, standPos, npcPos, 2.5, true) then
				return false
			end

			-- Đảm bảo đứng đủ gần (< 15 studs) theo điều kiện PaperShopUI (< 17 studs)
			if npcHrp and npcHrp.Parent then
				local liveNpcPos = npcHrp.Position
				if (liveNpcPos - root.Position).Magnitude >= 15 then
					local npcCF = npcHrp.CFrame
					local lookDir = Vector3.new(npcCF.LookVector.X, 0, npcCF.LookVector.Z)
					lookDir = if lookDir.Magnitude > 0.05 then lookDir.Unit else Vector3.new(0, 0, 1)
					local fallbackStand = groundStandPos(character, liveNpcPos + lookDir * 5.0, liveNpcPos.Y + 3)
					safeTeleport(character, fallbackStand, liveNpcPos, 2.0, true)
					standPos = fallbackStand
				end
				npcPos = npcHrp.Position
			end

			engageLeash(standPos, npcPos, 7)
			task.wait(0.15)

			-- Nếu lúc đứng xa GetShopState bị từ chối do khoảng cách, giờ đã đứng sát NPC -> gọi lại GetShopState
			if not shopState then
				okState, shopState = pcall(gameApi.BackendClient.Call, "PaperFolding", "GetShopState", worldId)
				if not okState or type(shopState) ~= "table" or not shopState.ok or type(shopState.Items) ~= "table" then
					clearLeash()
					return false
				end
			end

			local shopWorldId = tonumber(shopState.World) or worldId
			currentCoins = getPlayerCoins()
			local buyQueue = {}
			local minPriceAfterArrive = nil
			for _, rarity in ipairs(state.buyPaperRarities) do
				local paperKey = toInternalPaperKey(rarity)
				local item = shopState.Items[paperKey]
				if type(item) == "table" then
					local remaining = tonumber(item.Remaining) or 0
					local price = tonumber(item.Price)
						or (gameApi.PaperFoldingConfig and type(gameApi.PaperFoldingConfig.Price) == "function" and gameApi.PaperFoldingConfig.Price(shopWorldId, paperKey))
					if remaining > 0 and price and price >= 0 then
						if not minPriceAfterArrive or price < minPriceAfterArrive then
							minPriceAfterArrive = price
						end
						if currentCoins >= price then
							table.insert(buyQueue, paperKey)
						end
					end
				end
			end

			if #buyQueue == 0 then
				shopSkipCache.worldId = worldId
				shopSkipCache.cycle = shopState.Cycle or currentCycle
				shopSkipCache.raritiesSig = raritiesSig
				shopSkipCache.minNeededPrice = minPriceAfterArrive
				shopSkipCache.outOfStock = (minPriceAfterArrive == nil)
				shopSkipCache.checkedAt = os.clock()
				clearLeash()
				return false
			end

			-- Bước 3: Mua hết toàn bộ giấy đủ điều kiện & xác nhận thực tế đã nhận giấy vào túi
			local totalVerifiedBought = 0
			for _, paperKey in ipairs(buyQueue) do
				if not state.isRunning or not state.isAutoBuyPaperOn then
					break
				end
				local item = shopState.Items[paperKey]
				while state.isRunning and state.isAutoBuyPaperOn and type(item) == "table" and (tonumber(item.Remaining) or 0) > 0 do
					local price = tonumber(item.Price) or math.huge
					if getPlayerCoins() < price then
						break
					end

					character, _, root = findAliveCharacter()
					if not character or not root then
						break
					end
					local distToNpc = (npcPos - root.Position).Magnitude
					if distToNpc > 14 then
						if not safeTeleport(character, standPos, npcPos, 2.5, true) then
							break
						end
					end

					local beforeOwned = getOwnedPaperCount(shopWorldId, paperKey)
					local guid = hs:GenerateGUID(false)
					local okBuy, buyRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "BuyPaper", paperKey, 1, guid, shopState.Cycle)
					if not okBuy or type(buyRes) ~= "table" then
						break
					end

					syncProfileFromResponse(buyRes)
					if type(buyRes.State) == "table" and type(buyRes.State.Items) == "table" then
						shopState = buyRes.State
						item = shopState.Items[paperKey]
					elseif buyRes.ok then
						item.Remaining = math.max(0, (tonumber(item.Remaining) or 1) - 1)
					end

					if buyRes.ok then
						if item and tonumber(item.Owned) then
							setOwnedPaperCountLocal(shopWorldId, paperKey, tonumber(item.Owned))
						elseif getOwnedPaperCount(shopWorldId, paperKey) <= beforeOwned then
							setOwnedPaperCountLocal(shopWorldId, paperKey, beforeOwned + 1)
						end

						local afterOwned = getOwnedPaperCount(shopWorldId, paperKey)
						if afterOwned <= beforeOwned then
							ensureProfileLoaded(true)
							afterOwned = getOwnedPaperCount(shopWorldId, paperKey)
						end

						if afterOwned > beforeOwned then
							totalVerifiedBought += (afterOwned - beforeOwned)
						end
						task.wait(0.18)
					else
						break
					end
				end
			end

			-- Kiểm tra sau khi mua xong còn tờ nào mua được không để dừng Tele & trả quyền di chuyển bình thường
			local nextMinPrice = nil
			local coinsAfter = getPlayerCoins()
			local canStillBuy = false
			for _, rarity in ipairs(state.buyPaperRarities) do
				local pKey = toInternalPaperKey(rarity)
				local it = shopState.Items and shopState.Items[pKey]
				if type(it) == "table" and (tonumber(it.Remaining) or 0) > 0 then
					local p = tonumber(it.Price)
						or (gameApi.PaperFoldingConfig and type(gameApi.PaperFoldingConfig.Price) == "function" and gameApi.PaperFoldingConfig.Price(shopWorldId, pKey))
					if p and p >= 0 then
						if not nextMinPrice or p < nextMinPrice then
							nextMinPrice = p
						end
						if coinsAfter >= p then
							canStillBuy = true
						end
					end
				end
			end

			if not canStillBuy then
				shopSkipCache.worldId = worldId
				shopSkipCache.cycle = shopState.Cycle or currentCycle
				shopSkipCache.raritiesSig = raritiesSig
				shopSkipCache.minNeededPrice = nextMinPrice
				shopSkipCache.outOfStock = (nextMinPrice == nil)
				shopSkipCache.checkedAt = os.clock()
			end

			-- Mua xong -> dừng Tele ngay lập tức và trả quyền di chuyển bình thường
			clearLeash()
			return totalVerifiedBought > 0
		end

		local function foldSinglePaper(tableModel, standPos, lookPos, paperKey, worldId)
			if not state.isRunning or not state.isAutoFoldPaperOn or not gameApi.BackendClient then
				return false
			end

			suppressTableTriggers(tableModel)
			clickPaperFoldingContinueButton()

			local okSt, stRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "GetState")
			if okSt and type(stRes) == "table" and stRes.ok and type(stRes.Pending) == "table" and stRes.Pending.SessionId then
				pcall(gameApi.BackendClient.Call, "PaperFolding", "Ack", stRes.Pending.SessionId)
			end

			if not state.inFoldTable then
				local okEnt, enterRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Enter")
				if not okEnt or type(enterRes) ~= "table" or not enterRes.ok then
					local character, _, root = findAliveCharacter()
					if character and root then
						safeTeleport(character, standPos, lookPos, 1.5)
					end
					task.wait(0.2)
					okEnt, enterRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Enter")
					if not okEnt or type(enterRes) ~= "table" or not enterRes.ok then
						if type(enterRes) == "table" and enterRes.full and root then
							local altTable, altStand, altLook = findBestFoldingTable(worldId, root.Position)
							if altTable and altTable ~= tableModel and altStand and altLook then
								suppressTableTriggers(altTable)
								safeTeleport(character, altStand, altLook, 1.5)
								engageLeash(altStand, altLook, 4)
								okEnt, enterRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Enter")
							end
						end
						if not okEnt or type(enterRes) ~= "table" or not enterRes.ok then
							return false
						end
					end
				end
				state.inFoldTable = true
			end

			local beforeOwned = getOwnedPaperCount(worldId, paperKey)
			local okStart, startRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Start", paperKey)
			if not okStart or type(startRes) ~= "table" or not startRes.ok or not startRes.SessionId then
				state.inFoldTable = false
				pcall(gameApi.BackendClient.Call, "PaperFolding", "Leave")
				return false
			end

			local sessionId = startRes.SessionId
			state.activeFoldSessionId = sessionId
			local planCount = #gameApi.PaperFoldingConfig.ChallengePlan(paperKey)

			for _ = 1, math.max(planCount, 12) do
				if not state.isRunning or not state.isAutoFoldPaperOn then
					cleanupFoldSession()
					return false
				end

				local ch = nil
				for _ = 1, 30 do
					if not state.isRunning or not state.isAutoFoldPaperOn then
						cleanupFoldSession()
						return false
					end
					local okCh, res = pcall(gameApi.BackendClient.Call, "PaperFolding", "Challenge", sessionId)
					if okCh and type(res) == "table" then
						ch = res
						if ch.ok or not ch.wait then
							break
						end
						task.wait(math.clamp(tonumber(ch.retryIn) or 0.2, 0.05, 1))
					else
						break
					end
				end

				if not ch or not ch.ok then
					cleanupFoldSession()
					return false
				end

				local waitLead = (tonumber(ch.Start) or 0) - workspace:GetServerTimeNow()
				if waitLead > 0 then
					task.wait(waitLead + 0.02)
				end

				if not state.isRunning or not state.isAutoFoldPaperOn then
					cleanupFoldSession()
					return false
				end

				local targetServerTime
				if ch.Kind == "Circle" then
					local targetRadius = ch.TargetRadius
					targetServerTime = ch.Start + (ch.StartRadius - targetRadius) * ch.Duration / ch.StartRadius
				else
					local targetCenter = ch.Center or 0.5
					local t = math.max(workspace:GetServerTimeNow(), ch.Start) + 0.02
					for _ = 1, 4000 do
						if math.abs(gameApi.PaperFoldingConfig.TimingPos(ch, t) - targetCenter) < 0.004 then
							break
						end
						t += 0.001
					end
					targetServerTime = t
				end

				local waitHit = targetServerTime - workspace:GetServerTimeNow()
				if waitHit > 0 then
					task.wait(waitHit)
				end

				if not state.isRunning or not state.isAutoFoldPaperOn then
					cleanupFoldSession()
					return false
				end

				local actualHitTime = workspace:GetServerTimeNow()
				local okHit, hitRes = pcall(gameApi.BackendClient.Call, "PaperFolding", "Hit", sessionId, ch.Index, actualHitTime)
				if not okHit or type(hitRes) ~= "table" or not hitRes.ok then
					if type(hitRes) == "table" and hitRes.expired then
						cleanupFoldSession()
						return false
					end
				elseif hitRes.Done then
					state.activeFoldSessionId = nil
					local ackId = (type(hitRes.Result) == "table" and hitRes.Result.SessionId) or sessionId
					pcall(gameApi.BackendClient.Call, "PaperFolding", "Ack", ackId)
					syncProfileFromResponse(hitRes)
					if getOwnedPaperCount(worldId, paperKey) >= beforeOwned then
						setOwnedPaperCountLocal(worldId, paperKey, math.max(0, beforeOwned - 1))
					end
					clickPaperFoldingContinueButton()
					return true
				end
			end

			state.activeFoldSessionId = nil
			if getOwnedPaperCount(worldId, paperKey) >= beforeOwned then
				setOwnedPaperCountLocal(worldId, paperKey, math.max(0, beforeOwned - 1))
			end
			clickPaperFoldingContinueButton()
			return true
		end

		local function performAutoFoldPhase()
			if not state.isAutoFoldPaperOn or #state.foldPaperRarities == 0 or not gameApi.BackendClient then
				return false
			end
			local character, _, root = findAliveCharacter()
			if not root or not character then
				return false
			end

			ensureProfileLoaded(false)
			local worldId = getCurrentWorldId(root.Position)
			if not hasSelectedFoldablePaper(worldId) then
				ensureProfileLoaded(true)
				if not hasSelectedFoldablePaper(worldId) then
					return false
				end
			end

			exitTrainingIfNeeded()

			local tableModel, standPos, lookPos = findBestFoldingTable(worldId, root.Position)
			if not tableModel or not standPos or not lookPos then
				return false
			end

			suppressTableTriggers(tableModel)
			if not safeTeleport(character, standPos, lookPos, 1.5) then
				restoreTableTriggers()
				return false
			end

			engageLeash(standPos, lookPos, 4)

			local foldedAny = false
			while state.isRunning and state.isAutoFoldPaperOn do
				local nextPaperKey = getNextFoldablePaperKey(worldId)
				if not nextPaperKey then
					ensureProfileLoaded(true)
					nextPaperKey = getNextFoldablePaperKey(worldId)
					if not nextPaperKey then
						break
					end
				end

				character, _, root = findAliveCharacter()
				if not character or not root then
					break
				end

				local currentDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
				if currentDist > 5 then
					if not safeTeleport(character, standPos, lookPos, 1.5) then
						break
					end
				end

				local success = foldSinglePaper(tableModel, standPos, lookPos, nextPaperKey, worldId)
				if success then
					foldedAny = true
					task.wait(0.15)
				else
					task.wait(0.35)
					break
				end
			end

			clickPaperFoldingContinueButton()
			if state.inFoldTable then
				cleanupFoldSession()
			end
			clearLeash()
			restoreTableTriggers()
			return foldedAny
		end

		function paperSys.CanPotentiallyBuy()
			if not state.isAutoBuyPaperOn or #state.buyPaperRarities == 0 or not gameApi.BackendClient then
				return false
			end
			local _, _, root = findAliveCharacter()
			if not root then
				return false
			end
			local worldId = getCurrentWorldId(root.Position)
			local raritiesSig = getRaritiesSignature(state.buyPaperRarities)
			local currentCycle = gameApi.PaperShopConfig and type(gameApi.PaperShopConfig.Cycle) == "function"
				and type(gameApi.PaperShopConfig.Now) == "function"
				and gameApi.PaperShopConfig.Cycle(gameApi.PaperShopConfig.Now()) or nil
			local currentCoins = getPlayerCoins()

			if shopSkipCache.worldId == worldId
				and shopSkipCache.cycle ~= nil
				and shopSkipCache.cycle == currentCycle
				and shopSkipCache.raritiesSig == raritiesSig
			then
				if shopSkipCache.outOfStock then
					return false
				end
				if shopSkipCache.minNeededPrice == nil or currentCoins < shopSkipCache.minNeededPrice then
					return false
				end
			end

			local cfgMinPrice = getMinSelectedConfigPrice(worldId)
			if cfgMinPrice and currentCoins < cfgMinPrice then
				shopSkipCache.worldId = worldId
				shopSkipCache.cycle = currentCycle
				shopSkipCache.raritiesSig = raritiesSig
				shopSkipCache.minNeededPrice = cfgMinPrice
				shopSkipCache.outOfStock = false
				shopSkipCache.checkedAt = os.clock()
				return false
			end
			return true
		end

		function paperSys.HasFoldableWork()
			if not state.isAutoFoldPaperOn or #state.foldPaperRarities == 0 or not gameApi.BackendClient then
				return false
			end
			local _, _, root = findAliveCharacter()
			if not root then
				return false
			end
			local worldId = getCurrentWorldId(root.Position)
			return hasSelectedFoldablePaper(worldId)
		end

		function paperSys.RunBuyStep()
			if not paperSys.CanPotentiallyBuy() then
				return false
			end
			if state.inFoldTable or state.activeFoldSessionId then
				cleanupFoldSession()
				restoreTableTriggers()
			end
			local ok, bought = pcall(performAutoBuyPhase)
			return ok and bought == true
		end

		function paperSys.RunFoldStep()
			if not state.isAutoFoldPaperOn or #state.foldPaperRarities == 0 or not gameApi.BackendClient then
				return false
			end
			local ok, folded = pcall(performAutoFoldPhase)
			return ok and folded == true
		end
		return paperSys
	end)()

	-- ================= MODULE AUTO OPEN EGG (WORLD 1-6) =================
	local eggSys = (function()
		local eggSys = {}
		local eggStats = {
			totalHatched = 0,
			lastPetSummary = "",
			lastError = "",
			userPinnedMap = false,
			lastTrackedWorldId = nil,
		}

		local eggSkipCache = {
			worldId = nil,
			eggsSig = "",
			minNeededPrice = nil,
			noModelUntil = 0,
			lockedUntil = 0,
		}

		function eggSys.ResetEggCache()
			eggSkipCache.worldId = nil
			eggSkipCache.eggsSig = ""
			eggSkipCache.minNeededPrice = nil
			eggSkipCache.noModelUntil = 0
			eggSkipCache.lockedUntil = 0
		end

		local function getSelectedEggsSig(activeEggs)
			local ids = {}
			for _, info in ipairs(activeEggs) do
				table.insert(ids, tostring(info.Id))
			end
			table.sort(ids)
			return table.concat(ids, ",")
		end

		local function getOwnedEggCount(eggId)
			if not gameApi.BackendClient or type(gameApi.BackendClient.Profile) ~= "table" then
				return 0
			end
			local eggs = gameApi.BackendClient.Profile.Eggs
			if type(eggs) ~= "table" then
				return 0
			end
			return math.max(0, math.floor(tonumber(eggs[eggId]) or 0))
		end

		local function formatHatchResults(results)
			if type(results) ~= "table" or #results == 0 then
				return ""
			end
			local names = {}
			local petCatalog = gameApi.ItemCatalog and gameApi.ItemCatalog.Pets
			for _, item in ipairs(results) do
				if type(item) == "table" and type(item.PetId) == "string" then
					local petDef = type(petCatalog) == "table" and petCatalog[item.PetId]
					local dispName = (petDef and petDef.Name) or item.PetId
					if item.AutoSold == true then
						dispName = dispName .. " (Sold)"
					end
					table.insert(names, dispName)
				end
			end
			return table.concat(names, ", ")
		end

		local function recordHatchOutcome(eggId, results, countFallback)
			if type(results) == "table" and #results > 0 then
				eggStats.totalHatched += #results
				eggStats.lastPetSummary = formatHatchResults(results)
			else
				eggStats.totalHatched += (tonumber(countFallback) or 1)
				local info = catalog.EggById[eggId]
				eggStats.lastPetSummary = info and info.Name or tostring(eggId)
			end
			eggStats.lastError = ""
		end

		local function isEggActionBlocked(character)
			if not character then return true end
			if character:GetAttribute("PlaneThrowPhase") ~= nil then return true end
			if localPlayer:GetAttribute("IsTraining") == true then return true end
			if localPlayer:GetAttribute("WorldTransition") == true then return true end
			if localPlayer:GetAttribute("IsFolding") == true then return true end
			if localPlayer:GetAttribute("CutscenePreviewing") == true then return true end
			if localPlayer:GetAttribute("HalloweenExchangeOpen") == true then return true end
			return false
		end

		local function isTargetWorldUnlocked(targetWorldId)
			if targetWorldId <= 1 then
				return true
			end
			local profile = gameApi.BackendClient and gameApi.BackendClient.Profile
			if type(profile) == "table" and gameApi.WorldConfig and type(gameApi.WorldConfig.IsUnlocked) == "function" then
				local okUnl, unlocked = pcall(gameApi.WorldConfig.IsUnlocked, profile, targetWorldId)
				if okUnl and type(unlocked) == "boolean" then
					return unlocked
				end
			end
			return true
		end

		local function findWorldEggModel(eggId, rootPos, targetWorldId)
			if gameApi.PetEggConfig and type(gameApi.PetEggConfig.WorldEgg) == "function" then
				local okModel, model = pcall(gameApi.PetEggConfig.WorldEgg, eggId, rootPos)
				if okModel and typeof(model) == "Instance" and model:IsDescendantOf(workspace) then
					return model
				end
			end

			local cfgDef = gameApi.PetEggConfig and gameApi.PetEggConfig.Eggs and gameApi.PetEggConfig.Eggs[eggId]
			local info = catalog.EggById[eggId]
			local worldId = (cfgDef and tonumber(cfgDef.World)) or (info and info.World) or targetWorldId or 1
			local worldModelName = (cfgDef and cfgDef.WorldModel) or (info and info.WorldModel)
			local shortModelName = (cfgDef and cfgDef.Model) or (info and info.Model) or eggId

			-- Tìm đệ quy trong đúng World folder (ví dụ Workspace["World 6"] -> "World 6 Egg Coral Reef")
			local worldFolder = workspace:FindFirstChild("World " .. tostring(worldId))
			if worldFolder then
				if type(worldModelName) == "string" and worldModelName ~= "" then
					local found = worldFolder:FindFirstChild(worldModelName) or worldFolder:FindFirstChild(worldModelName, true)
					if found and (found:IsA("Model") or found:IsA("BasePart")) then
						return found
					end
				end
				if type(shortModelName) == "string" and shortModelName ~= "" then
					local foundShort = worldFolder:FindFirstChild(shortModelName, true)
					if foundShort and (foundShort:IsA("Model") or foundShort:IsA("BasePart")) then
						return foundShort
					end
				end
			end

			if type(worldModelName) == "string" and worldModelName ~= "" then
				local directInWs = workspace:FindFirstChild(worldModelName)
				if directInWs and (directInWs:IsA("Model") or directInWs:IsA("BasePart")) then
					return directInWs
				end
			end

			return nil
		end

		local function moveToMapEgg(character, root, eggId, targetWorldId)
			local eggModel = findWorldEggModel(eggId, root.Position, targetWorldId)

			if not eggModel then
				local anchors = getWorldAnchorCandidates(targetWorldId)
				for _, anchor in ipairs(anchors) do
					if not state.isRunning or not state.isAutoOpenEggOn then
						break
					end
					pcall(function()
						localPlayer:RequestStreamAroundAsync(anchor, 4)
					end)
					local distToAnchor = Vector3.new(root.Position.X - anchor.X, 0, root.Position.Z - anchor.Z).Magnitude
					if distToAnchor > 90 or math.abs(root.Position.Y - anchor.Y) > 120 then
						local anchorStand = groundStandPos(character, anchor, anchor.Y + 3)
						safeTeleport(character, anchorStand, anchorStand + Vector3.new(0, 0, 5), 10, true)
						character, _, root = findAliveCharacter()
						if not character or not root then
							return nil
						end
					end
					for _ = 1, 6 do
						eggModel = findWorldEggModel(eggId, root.Position, targetWorldId)
						if eggModel then
							break
						end
						task.wait(0.15)
					end
					if eggModel then
						break
					end
				end
			end

			if not eggModel then
				return nil
			end

			local eggPivot = eggModel:IsA("Model") and eggModel:GetPivot() or eggModel.CFrame
			local eggPos = eggPivot.Position
			local hatchRange = (gameApi.PetEggConfig and tonumber(gameApi.PetEggConfig.HatchRange)) or 20
			local flatDist = ((eggPos - root.Position) * Vector3.new(1, 0.5, 1)).Magnitude

			if flatDist <= (hatchRange - 4) then
				return eggModel
			end

			local offsetDir = Vector3.new(root.Position.X - eggPos.X, 0, root.Position.Z - eggPos.Z)
			if offsetDir.Magnitude < 0.1 then
				offsetDir = -eggPivot.LookVector * Vector3.new(1, 0, 1)
			end
			offsetDir = if offsetDir.Magnitude > 0.05 then offsetDir.Unit else Vector3.new(0, 0, 1)

			local rawStand = eggPos + offsetDir * 6
			local standPos = groundStandPos(character, rawStand, eggPos.Y + 3)
			if safeTeleport(character, standPos, eggPos, 3, true) then
				return eggModel
			end
			return nil
		end

		local function getPreferredMapHatchCount(eggDef, coins)
			local price = tonumber(eggDef.Price) or 0
			if price <= 0 then return 1 end
			local petEggCfg = gameApi.PetEggConfig
			-- Chỉ sử dụng gói đa trứng nếu người chơi thực sự sở hữu GamePass hợp lệ theo đúng EggClient / PetEggConfig.PassForCount
			if petEggCfg and type(petEggCfg.Products) == "table" then
				local bestCount = 1
				for _, prod in ipairs(petEggCfg.Products) do
					local cnt = tonumber(prod.Count) or 1
					local gpId = tonumber(prod.GamePassId) or 0
					if gpId > 0 and prod.Key and localPlayer:GetAttribute("Pass_" .. tostring(prod.Key)) == true then
						if cnt > bestCount and coins >= price * cnt then
							bestCount = cnt
						end
					end
				end
				if bestCount > 1 then
					return bestCount
				end
			end
			if petEggCfg and type(petEggCfg.Counts) == "table" and petEggCfg.Counts[2] == true then
				local multi = tonumber(petEggCfg.MultiCount) or 2
				if multi > 1 and coins >= price * multi then
					return multi
				end
			end
			return 1
		end

		function eggSys.GetDefaultEggNamesForMap(targetWorldId)
			local names = {}
			for _, eggId in ipairs(catalog.EggOrder) do
				local info = catalog.EggById[eggId]
				if info and info.World == targetWorldId and not info.RobuxOnly and (tonumber(info.Price) or 0) > 0 then
