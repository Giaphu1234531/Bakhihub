local function findPerfectWindow(flightConfig)
	local first = nil
	local last = nil
	for step = 0, 3000 do
		local holdTime = step / 1000
		if flightConfig.PowerAt(holdTime) >= 1 then
			first = first or holdTime
			last = holdTime
		elseif first then
			break
		end
	end
	if not first then
		return nil
	end
	return {First = first, Last = last, Target = (first + last) / 2 - 0.008}
end

