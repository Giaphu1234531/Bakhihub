	local function resolveEggIdForCurrentMap(eggName, mapId)
		for _, eggId in ipairs(catalog.EggOrder) do
			local info = catalog.EggById[eggId]
			if info and info.Name == eggName and (info.World == mapId or info.Event) then
				return eggId
			end
		end
		return catalog.EggNameToId[eggName]
	end

	local function syncSelectedEggsForCurrentMap(eggNames)
		local mapId = catalog.GetMapId(state.selectedEggMap)
		state.selectedEggsByMap[mapId] = {}
		for _, eggName in ipairs(eggNames or {}) do
			local eggId = resolveEggIdForCurrentMap(eggName, mapId)
			if eggId then
				state.selectedEggsByMap[mapId][eggId] = true
			end
		end
		table.clear(state.selectedEggIds)
		for _, mapBucket in pairs(state.selectedEggsByMap) do
			for eggId, enabled in pairs(mapBucket) do
				if enabled then
					state.selectedEggIds[eggId] = true
				end
			end
		end
		if eggSys and type(eggSys.ResetEggCache) == "function" then
			eggSys.ResetEggCache()
		end
		if eggStatusLabel then
			eggStatusLabel:Set(eggSys.GetStatusText())
		end
	end

	local isSyncingWorldMap = false

	local function applyEggMapSelection(worldId, fromAutoDetect)
		local mapId = tonumber(worldId) or 1
		local mapName = catalog.GetMapName(mapId)
		state.selectedEggMap = mapName
		if eggSelectDropdown then
			local options = catalog.GetEggsForMap(mapName)
			eggSelectDropdown:Refresh(options)
			local restored = {}
			local savedMapEggs = state.selectedEggsByMap[mapId] or {}
			for _, eggName in ipairs(options) do
				local eggId = resolveEggIdForCurrentMap(eggName, mapId)
				if eggId and savedMapEggs[eggId] then
					table.insert(restored, eggName)
				end
			end
			-- Nếu người chơi chuyển World trong khi Auto Open đang bật và map mới chưa chọn trứng nào -> tự chọn toàn bộ trứng Coins của World đó
			if #restored == 0 and state.isAutoOpenEggOn and type(eggSys.GetDefaultEggNamesForMap) == "function" then
				restored = eggSys.GetDefaultEggNamesForMap(mapId)
			end
			eggSelectDropdown:Set(restored)
			syncSelectedEggsForCurrentMap(restored)
		end
		if eggStatusLabel then
			eggStatusLabel:Set(eggSys.GetStatusText())
		end
	end

