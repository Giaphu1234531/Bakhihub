	-- ================= KHỞI CHẠY LOGIC NGẦM =================
	task.spawn(function()
		local bindFailure = bindGame()
		if bindFailure then
			W:Notify({Title = "Bakhi Hub", Text = "Load Failed: " .. tostring(bindFailure), Error = true})
			return
		end

		ensureProfileLoaded(true)

		local _, _, initRoot = findAliveCharacter()
		local detectedWorldId = getCurrentWorldId(initRoot and initRoot.Position)
		local currentMapId = detectedWorldId or catalog.GetMapId(state.selectedEggMap)
		state.selectedEggMap = catalog.GetMapName(currentMapId)
		if eggMapDropdown then
			eggMapDropdown:Refresh(catalog.GetMapOptions())
			isSyncingWorldMap = true
			eggMapDropdown:Set(state.selectedEggMap)
			isSyncingWorldMap = false
		end
		applyEggMapSelection(currentMapId, true)

		local function handlePlayerWorldChanged()
			if not state.isRunning then
				return
			end
			local _, _, r = findAliveCharacter()
			local liveWorldId = getCurrentWorldId(r and r.Position)
			local selectedWorldId = catalog.GetMapId(state.selectedEggMap)
			if liveWorldId and liveWorldId ~= selectedWorldId then
				if eggMapDropdown then
					isSyncingWorldMap = true
					eggMapDropdown:Set(catalog.GetMapName(liveWorldId))
					isSyncingWorldMap = false
				else
					applyEggMapSelection(liveWorldId, true)
				end
			end
		end

		for _, attrName in ipairs({"CurrentWorld", "WorldId", "MapId"}) do
			trackConnection(localPlayer:GetAttributeChangedSignal(attrName):Connect(handlePlayerWorldChanged))
		end

		if gameApi.BackendClient and gameApi.BackendClient.ProfileChanged then
			trackConnection(gameApi.BackendClient.ProfileChanged:Connect(function()
				if eggStatusLabel then
					eggStatusLabel:Set(eggSys.GetStatusText())
				end
			end))
		end
		if eggStatusLabel then
			eggStatusLabel:Set(eggSys.GetStatusText())
		end

		flightSys.InitTuning()
		gameApi.Ready = true

		trackConnection(gameApi.PlaneFlight.OnClientEvent:Connect(flightSys.OnPlaneFlightEvent))
		if gameApi.PlaneSkill then
			trackConnection(gameApi.PlaneSkill.OnClientEvent:Connect(flightSys.OnPlaneSkillEvent))
			pcall(gameApi.PlaneSkill.FireServer, gameApi.PlaneSkill, "Sync")
		end
		if gameApi.TreasureEvent then
			trackConnection(gameApi.TreasureEvent.OnClientEvent:Connect(flightSys.OnTreasureEvent))
		end
		if gameApi.World6Event then
			trackConnection(gameApi.World6Event.OnClientEvent:Connect(flightSys.OnWorld6Event))
		end
		if gameApi.PlaneNitro then
			trackConnection(gameApi.PlaneNitro.OnClientEvent:Connect(flightSys.OnPlaneNitroEvent))
		end
		if gameApi.CandyEvent then
			trackConnection(gameApi.CandyEvent.OnClientEvent:Connect(flightSys.OnCandyEvent))
		end
		if gameApi.ReviveRemote then
			trackConnection(gameApi.ReviveRemote.OnClientEvent:Connect(flightSys.OnReviveEvent))
		end

		trackConnection(gameApi.TrainingRemote.OnClientEvent:Connect(function(kind, data)
			if kind == "BonusOffer" and state.isAutoTrainOn and type(data) == "table" and data.Id then
				task.spawn(function()
					task.wait(0.2)
					trainSys.ClickX2Button()
				end)
			end
		end))

		syncHeartbeatConnection()

		local function interruptibleWait(seconds)
			local deadline = os.clock() + (seconds or 0.2)
			while state.isRunning and not state.pipelineWakeup and os.clock() < deadline do
				task.wait(math.min(0.1, deadline - os.clock()))
			end
			state.pipelineWakeup = false
		end

		local function runBuyAndFoldSequence(job, modeCheckFn)
			-- Thực hiện tuần tự: 1. Auto Buy Paper -> 2. Auto Fold (lặp lại nếu hết giấy mà vẫn mua được thêm)
			for _ = 1, 6 do
				if not isJobRunning(job) or (modeCheckFn and not modeCheckFn()) then
					break
				end

				local boughtAny = false
				if state.isAutoBuyPaperOn and paperSys.CanPotentiallyBuy() then
					state.activePipelineStep = "BUY_PAPER"
					boughtAny = paperSys.RunBuyStep()
				end

				if not isJobRunning(job) or (modeCheckFn and not modeCheckFn()) then
					break
				end

				local foldedAny = false
				if state.isAutoFoldPaperOn and paperSys.HasFoldableWork() then
					state.activePipelineStep = "FOLD_PAPER"
					foldedAny = paperSys.RunFoldStep()
				end

				-- Nếu vừa gấp hết giấy và shop vẫn còn hàng + đủ tiền để mua tiếp -> quay lại mua giấy rồi gấp tiếp
				if not (boughtAny or foldedAny) then
					break
				end
				if not (state.isAutoBuyPaperOn and paperSys.CanPotentiallyBuy()) then
					break
				end
			end
		end

		local function runEggSequence(job, modeCheckFn)
			-- 3. Egg: sau khi hoàn thành gấp giấy, chuyển sang xử lý Egg
			if not isJobRunning(job) or (modeCheckFn and not modeCheckFn()) then
				return false
			end
			if state.isAutoOpenEggOn and eggSys.HasEggWork() then
				state.activePipelineStep = "OPEN_EGG"
				return eggSys.RunEggStep()
			end
			return false
		end

		local function runUnifiedSequentialLoop(job)
			while isJobRunning(job) do
				if not gameApi.Ready then
					interruptibleWait(0.4)
					continue
				end

				pcall(trainSys.CheckAutoRebirth)

				-- CHẾ ĐỘ 1: KHI BẬT AUTO THROW (1. Auto Buy Paper -> 2. Auto Fold -> 3. Egg -> 4. Auto Throw)
				if state.isAutoThrowOn then
					local function throwActive()
						return state.isRunning and state.isAutoThrowOn
					end

					-- Nếu đang bay trên không, duy trì điều khiển bay/né/nhặt vòng cho tới khi hạ cánh
					if flightSys.IsOwnFlightActive() then
						state.activePipelineStep = "AUTO_THROW"
						local waitDelay = flightSys.RunThrowStep()
						interruptibleWait(math.clamp(tonumber(waitDelay) or 0.25, 0.1, 0.5))
						continue
					end

					-- Trên mặt đất / sảnh: chạy tuần tự 1. Buy -> 2. Fold -> 3. Egg trước khi ném
					runBuyAndFoldSequence(job, throwActive)
					if not throwActive() then
						continue
					end

					runEggSequence(job, throwActive)
					if not throwActive() then
						continue
					end

					-- 4. Sau khi hoàn thành Buy -> Fold -> Egg (hoặc hết tiền/hết hàng), tiến hành Auto Throw
					state.activePipelineStep = "AUTO_THROW"
					local throwDelay = flightSys.RunThrowStep()
					interruptibleWait(math.clamp(tonumber(throwDelay) or 0.35, 0.1, 1.5))

				-- CHẾ ĐỘ 2: KHI BẬT AUTO TRAINING (1. Auto Buy Paper -> 2. Auto Fold -> 3. Egg -> 4. Auto Training)
				elseif state.isAutoTrainOn then
					local function trainActive()
						return state.isRunning and state.isAutoTrainOn
					end

					local hasPreWork = (state.isAutoBuyPaperOn and paperSys.CanPotentiallyBuy())
						or (state.isAutoFoldPaperOn and paperSys.HasFoldableWork())
						or (state.isAutoOpenEggOn and eggSys.HasEggWork())

					if hasPreWork then
						trainSys.ExitIfTraining()

						runBuyAndFoldSequence(job, trainActive)
						if not trainActive() then
							continue
						end

						runEggSequence(job, trainActive)
						if not trainActive() then
							continue
						end
					end

					-- 4. Sau khi hoàn thành Buy -> Fold -> Egg, tiến hành Auto Training
					state.activePipelineStep = "AUTO_TRAINING"
					trainSys.RunTrainStep()
					interruptibleWait(0.45)

				-- CHẾ ĐỘ ĐỘC LẬP: KHI TẮT CẢ AUTO THROW & AUTO TRAINING NHƯNG VẪN BẬT BUY / FOLD / EGG
				elseif state.isAutoBuyPaperOn or state.isAutoFoldPaperOn or state.isAutoOpenEggOn then
					runBuyAndFoldSequence(job, nil)
					runEggSequence(job, nil)
					if state.leash.active then
						clearLeash()
					end
					if next(state.suppressedTriggers) ~= nil then
						restoreTableTriggers()
					end
					state.activePipelineStep = "IDLE"
					interruptibleWait(0.6)

				else
					state.activePipelineStep = "IDLE"
					if state.leash.active then
						clearLeash()
					end
					if next(state.suppressedTriggers) ~= nil then
						restoreTableTriggers()
					end
					interruptibleWait(0.4)
				end
			end
		end

		flightSys.RequestRecord(1)
		startJob("Sequential Priority Loop", runUnifiedSequentialLoop)

		W:Notify({Title = "Bakhi Hub", Text = "All Features Loaded Successfully!", Time = 4})
	end)
end

