			local function extractNpcRoot(npcModel)
				if not npcModel then return nil end
				if npcModel:IsA("BasePart") then return npcModel end
				if npcModel:IsA("Model") then
					local hrp = npcModel:FindFirstChild("HumanoidRootPart")
