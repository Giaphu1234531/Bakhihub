	local function disconnectValue(value)
		if typeof(value) == "RBXScriptConnection" then
			pcall(value.Disconnect, value)
			return true
		end
		return false
	end

	local function stopPreviousLoad(previous)
		if type(previous.Stop) == "function" then
			pcall(previous.Stop)
		end
		for key, value in pairs(previous) do
			if type(value) == "boolean" then
				previous[key] = false
			end
		end
		for _, job in pairs(previous.jobs or {}) do
			if type(job) == "table" and type(job.status) == "string" then
				job.status = "Stopped"
			end
		end
		for _, value in pairs(previous) do
			if not disconnectValue(value) and type(value) == "table" then
				for _, item in pairs(value) do
					disconnectValue(item)
				end
			end
		end
	end

	if type(ge.__PtpAutoThrow) == "table" then
		pcall(stopPreviousLoad, ge.__PtpAutoThrow)
	end

