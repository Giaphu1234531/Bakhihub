-- KÉO THẢ KHUNG KEY TRÊN PC & MOBILE
local draggingCard = false
local dragStartPos, cardStartPos

mainBox.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingCard = true
		dragStartPos = input.Position
		cardStartPos = mainBox.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingCard and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStartPos
		mainBox.Position = UDim2.new(
			cardStartPos.X.Scale,
			cardStartPos.X.Offset + delta.X,
			cardStartPos.Y.Scale,
			cardStartPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingCard = false
	end
end)

