	local function findAliveCharacter()
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 then
			return character, humanoid, root
		end
		return nil
	end

	local function resolveInstancePath(path)
		local current = game
		for name in string.gmatch(path, "[^%.]+") do
			if current == game then
				local okSvc, svc = pcall(game.GetService, game, name)
				current = (okSvc and svc) or game:FindFirstChild(name)
			elseif current then
				current = current:FindFirstChild(name)
			end
		end
		return current
	end

	local function getCurrentWorldId(rootPos)
		if rootPos and gameApi.WorldConfig and type(gameApi.WorldConfig.AtPosition) == "function" then
			local w = gameApi.WorldConfig.AtPosition(rootPos)
			if w and tonumber(w.WorldId) then
				local refPos = w.SpawnPosition or w.LaunchPosition
				local floorY = tonumber(w.TrackFloorY) or 1460
				if typeof(refPos) == "Vector3" then
					if math.abs(rootPos.Z - refPos.Z) <= 550 and math.abs(rootPos.Y - floorY) <= 500 then
						return tonumber(w.WorldId)
					end
				else
					return tonumber(w.WorldId)
				end
			end
		end
		local attrWorld = tonumber(localPlayer:GetAttribute("CurrentWorld")) or tonumber(localPlayer:GetAttribute("WorldId"))
		if not attrWorld then
			local mapAttr = localPlayer:GetAttribute("MapId") or localPlayer:GetAttribute("CurrentMap")
			if type(mapAttr) == "string" then
				attrWorld = tonumber(mapAttr:match("(%d+)"))
			end
		end
		if attrWorld and attrWorld >= 1 then
			return attrWorld
		end
		local activeTrainZone = tonumber(localPlayer:GetAttribute("TrainingZone"))
		if activeTrainZone and gameApi.TrainingConfig then
			local zData = (type(gameApi.TrainingConfig.Zones) == "table" and gameApi.TrainingConfig.Zones[activeTrainZone])
				or (type(gameApi.TrainingConfig.Get) == "function" and gameApi.TrainingConfig.Get(activeTrainZone))
			if type(zData) == "table" and (tonumber(zData.WorldId) or tonumber(zData.World)) then
				return tonumber(zData.WorldId) or tonumber(zData.World)
			end
		end
		return 1
	end

	local function groundStandPos(character, rawStandPos, fallbackY)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = character and {character} or {}
		params.RespectCanCollide = true
		local hit = workspace:Raycast(rawStandPos + Vector3.new(0, 8, 0), Vector3.new(0, -24, 0), params)
		local y = if hit then hit.Position.Y + 3 else (fallbackY or rawStandPos.Y)
		return Vector3.new(rawStandPos.X, y, rawStandPos.Z)
	end

	local function getWorldAnchorCandidates(worldId)
		local anchors = {}
		local function pushAnchor(pos)
			if typeof(pos) == "Vector3" then
				for _, existing in ipairs(anchors) do
					if (existing - pos).Magnitude < 15 then
						return
					end
				end
				table.insert(anchors, pos)
			end
		end

		if gameApi.WorldConfig and type(gameApi.WorldConfig.Worlds) == "table" then
			local world = gameApi.WorldConfig.Worlds[worldId]
			if not world and type(gameApi.WorldConfig.Get) == "function" then
				local okW, wRes = pcall(gameApi.WorldConfig.Get, worldId)
				if okW and type(wRes) == "table" then
					world = wRes
				end
			end
			if not world then
				for _, w in pairs(gameApi.WorldConfig.Worlds) do
					if tonumber(w.WorldId) == worldId then
						world = w
						break
					end
				end
			end
			if type(world) == "table" then
				pushAnchor(world.SpawnPosition)
				pushAnchor(world.LaunchPosition)
				if type(world.PlaneShopReference) == "string" then
					local shopRef = resolveInstancePath(world.PlaneShopReference)
					if shopRef then
						if shopRef:IsA("Model") then
							pushAnchor(shopRef:GetPivot().Position)
						elseif shopRef:IsA("BasePart") then
							pushAnchor(shopRef.Position)
						end
					end
				end
				if type(world.LaunchZone) == "string" then
					local zone = resolveInstancePath(world.LaunchZone)
					local region = zone and zone:FindFirstChild("LaunchRegion")
					if region and region:IsA("BasePart") then
						pushAnchor(region.Position)
					end
				end
			end
		end

		if gameApi.WorldLayout and type(gameApi.WorldLayout.CenterZ) == "function" then
			local okZ, cz = pcall(gameApi.WorldLayout.CenterZ, worldId)
			if okZ and type(cz) == "number" then
				pushAnchor(Vector3.new(-5662, 1460, cz))
			end
		end

		if gameApi.WorldAirplaneShopConfig and type(gameApi.WorldAirplaneShopConfig.Get) == "function" then
			local shopCfg = gameApi.WorldAirplaneShopConfig.Get(worldId)
			if shopCfg and shopCfg.Exterior and typeof(shopCfg.Exterior.Position) == "Vector3" then
				local extPos = shopCfg.Exterior.Position
				pushAnchor(extPos)
				if gameApi.WorldLayout and type(gameApi.WorldLayout.Z) == "function" then
					local zOff = tonumber(gameApi.WorldLayout.Z(worldId)) or 0
					if zOff ~= 0 then
						pushAnchor(Vector3.new(extPos.X, extPos.Y, extPos.Z + zOff))
					end
				end
			end
		end

		local worldFolder = workspace:FindFirstChild("World " .. tostring(worldId))
		if worldFolder then
			local gameplay = worldFolder:FindFirstChild("Gameplay")
			if gameplay then
				local shopObj = gameplay:FindFirstChild("PlaneShop")
				if shopObj then
					if shopObj:IsA("Model") then
						pushAnchor(shopObj:GetPivot().Position)
					elseif shopObj:IsA("BasePart") then
						pushAnchor(shopObj.Position)
					end
				end
			end
		end

		return anchors
	end

	local function getMapAnchorPosition(worldId)
		local anchors = getWorldAnchorCandidates(worldId)
		return anchors[1]
	end

	local function waitIfGameplayPaused(maxWait)
		local deadline = os.clock() + (maxWait or 1.5)
		while state.isRunning and localPlayer.GameplayPaused and os.clock() < deadline do
			task.wait(0.05)
		end
	end

	local function safeTeleport(character, standPos, lookTarget, snapThreshold, regroundAfterStream)
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then return false end

		if humanoid.Sit then
			humanoid.Sit = false
			task.wait(0.05)
		end

		local threshold = snapThreshold or 2.5
		local targetLook = Vector3.new(lookTarget.X, standPos.Y, lookTarget.Z)
		if (targetLook - standPos).Magnitude < 0.05 then
			targetLook = standPos + Vector3.new(0, 0, 1)
		end

		local flatDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
		if flatDist <= threshold and math.abs(root.Position.Y - standPos.Y) <= 6 then
			root.Anchored = false
			local lookSameY = Vector3.new(lookTarget.X, root.Position.Y, lookTarget.Z)
			if (lookSameY - root.Position).Magnitude > 0.1 then
				root.CFrame = CFrame.lookAt(root.Position, lookSameY)
			end
			return true
		end

		pcall(function()
			localPlayer:RequestStreamAroundAsync(standPos, 4)
		end)
		waitIfGameplayPaused(1.2)

		-- Nếu khoảng cách quá xa (> 450 studs), di chuyển theo từng chặng ngắn để tránh bị giới hạn khoảng cách / rubberband và stream map mượt
		local currentPos = root.Position
		local totalVec = standPos - currentPos
		local totalDist = totalVec.Magnitude
		if totalDist > 450 then
			local stepSize = 420
			local steps = math.min(45, math.ceil(totalDist / stepSize))
			root.Anchored = true
			for s = 1, steps - 1 do
				if not state.isRunning then
					root.Anchored = false
					return false
				end
				local alpha = s / steps
				local hopPos = currentPos:Lerp(standPos, alpha) + Vector3.new(0, 4, 0)
				local hopCF = CFrame.lookAt(hopPos, Vector3.new(standPos.X, hopPos.Y, standPos.Z))
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				character:PivotTo(hopCF)
				root.CFrame = hopCF
				if s % 3 == 0 then
					pcall(function()
						localPlayer:RequestStreamAroundAsync(hopPos, 3)
					end)
				end
				task.wait(0.045)
			end
		end

		-- Đặt chính xác vào tọa độ đích & kiểm tra lại 3 lần chống giật ngược
		local isLongJump = totalDist > 60
		for attempt = 1, 3 do
			if not state.isRunning then
				root.Anchored = false
				return false
			end

			if isLongJump then
				root.Anchored = true
			end

			local destPos = standPos
			if regroundAfterStream and attempt >= 2 then
				destPos = groundStandPos(character, standPos, standPos.Y)
			end
			local destLook = Vector3.new(lookTarget.X, destPos.Y, lookTarget.Z)
			if (destLook - destPos).Magnitude < 0.05 then
				destLook = destPos + Vector3.new(0, 0, 1)
			end
			local destCF = CFrame.lookAt(destPos, destLook)

			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			character:PivotTo(destCF)
			root.CFrame = destCF

			if isLongJump then
				task.wait(0.18)
				waitIfGameplayPaused(1.2)
				if regroundAfterStream then
					local grounded = groundStandPos(character, destPos, destPos.Y)
					local groundedCF = CFrame.lookAt(grounded, Vector3.new(lookTarget.X, grounded.Y, lookTarget.Z))
					character:PivotTo(groundedCF)
					root.CFrame = groundedCF
				end
				root.Anchored = false
				root.AssemblyLinearVelocity = Vector3.zero
				task.wait(0.1)
			else
				root.Anchored = false
				task.wait(0.16)
			end

			local finalDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
			if finalDist <= 12 and math.abs(root.Position.Y - standPos.Y) <= 14 then
				return true
			end
		end

		root.Anchored = false
		local finalDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
		return finalDist <= 15
	end

