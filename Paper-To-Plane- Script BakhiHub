		if type(filtergc) ~= "function" then
			return nil
		end
		local candidates = filtergc("function", {Name = functionName}, false)
		for _, candidate in candidates or {} do
			local source = debug.info(candidate, "s")
			if type(source) == "string" and string.find(source, scriptName, 1, true) then
				return candidate
			end
		end
		return nil
	end

	local function requireModule(parent, moduleName)
		if not parent then
			return nil
		end
		local moduleScript = parent:FindFirstChild(moduleName) or parent:WaitForChild(moduleName, 3)
		if not moduleScript then
			return nil
		end
		local requireSucceeded, result = pcall(require, moduleScript)
		if requireSucceeded and type(result) == "table" then
			return result
		end
		return nil
	end

	local function findPerfectWindow(flightConfig)
		local first = nil
		local last = nil
		for step = 0, 3000 do
			local holdTime = step / 1000
			if flightConfig.PowerAt(holdTime) >= 1 then
				first = first or holdTime
				last = holdTime
			elseif first then
				break
			end
		end
		if not first then
			return nil
		end
		return {First = first, Last = last, Target = (first + last) / 2 - 0.008}
	end

	local function waitForChild(parent, childName)
		while state.isRunning do
