local function safeTeleport(character, standPos, lookTarget)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return false end

	pcall(function()
		localPlayer:RequestStreamAroundAsync(standPos, 2)
	end)

	local flatDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
	local targetLook = Vector3.new(lookTarget.X, standPos.Y, lookTarget.Z)

	if flatDist <= 5 and math.abs(root.Position.Y - standPos.Y) <= 8 then
		local lookSameY = Vector3.new(lookTarget.X, root.Position.Y, lookTarget.Z)
		if (lookSameY - root.Position).Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, lookSameY)
		end
		return true
	end

	root.Anchored = false
	root.AssemblyLinearVelocity = Vector3.zero
	character:PivotTo(CFrame.lookAt(standPos, targetLook))
	task.wait(0.35)

	local finalDist = Vector3.new(root.Position.X - standPos.X, 0, root.Position.Z - standPos.Z).Magnitude
	return finalDist <= 14
end

local function findNearestFoldingTable(worldId, refPosition)
	local character = localPlayer.Character
	local bestTable = nil
	local bestScore = math.huge

	for _, tagged in ipairs(CollectionService:GetTagged("FoldingTable")) do
		local tableModel = tagged:FindFirstAncestorWhichIsA("Model")
		if tableModel and tagged:IsDescendantOf(workspace) then
			local tWorld = tonumber(tableModel:GetAttribute("World"))
			if not tWorld and gameApi.WorldConfig and type(gameApi.WorldConfig.AtPosition) == "function" then
				local w = gameApi.WorldConfig.AtPosition(tableModel:GetPivot().Position)
				tWorld = w and tonumber(w.WorldId)
			end
			local centerPart = tableModel:FindFirstChild("PaperCenter") or tableModel:FindFirstChild("TablePad") or tableModel:FindFirstChild("StandPoint")
			if centerPart then
				local slotsUsed = tonumber(tableModel:GetAttribute("SlotsUsed")) or 0
				local maxSlots = (gameApi.FoldingSlots and gameApi.FoldingSlots.Max) or 4
				local fullPenalty = (slotsUsed >= maxSlots and not state.inFoldTable) and 50000 or 0
				local worldPenalty = (tWorld and tWorld ~= worldId) and 100000 or 0
				local dist = (centerPart.Position - refPosition).Magnitude
				local score = dist + fullPenalty + worldPenalty
				if score < bestScore then
					bestScore = score
					bestTable = tableModel
				end
			end
		end
	end

	if not bestTable then
		return nil, nil, nil
	end

	local centerPart = bestTable:FindFirstChild("PaperCenter") or bestTable:FindFirstChild("TablePad")
	local tableCenter = (centerPart and centerPart.Position) or bestTable:GetPivot().Position

	local seatInfo = gameApi.FoldingSlots and gameApi.FoldingSlots.Seat(bestTable, 1)
	local chairRefPos = nil
	if seatInfo and seatInfo.Stand then
		chairRefPos = seatInfo.Stand.Position
	elseif bestTable:FindFirstChild("StandPoint") then
		chairRefPos = bestTable.StandPoint.Position
	elseif bestTable:FindFirstChild("FoldingPlayerPosition") then
		chairRefPos = bestTable.FoldingPlayerPosition.Position
	end

	local outDir
	if chairRefPos then
		local flat = Vector3.new(chairRefPos.X - tableCenter.X, 0, chairRefPos.Z - tableCenter.Z)
		outDir = if flat.Magnitude > 0.05 then flat.Unit else Vector3.new(0, 0, 1)
	else
		outDir = Vector3.new(0, 0, 1)
	end

	local basePos = chairRefPos or (tableCenter + outDir * 3.5)
	local rawStand = basePos + outDir * 3
	local standPos = groundStandPos(character, rawStand, basePos.Y)
	local lookTarget = chairRefPos or tableCenter
	return bestTable, standPos, lookTarget
end

