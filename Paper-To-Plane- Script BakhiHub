		-- ================= AUTO SOLVE RƯƠNG WORLD 6 (MEMORY / PATH / SYMBOLMATH / BASICMATH) =================
		local activeTreasure = nil
		local treasureSolveToken = 0

		local function normalizeMathOperator(op)
			if type(op) ~= "string" then
				return "+"
			end
			if op == "x" or op == "X" or op == "\195\151" or op == "\194\183" or op == "*" then
				return "*"
			elseif op == "/" or op == "\195\183" or op == ":" then
				return "/"
			elseif op == "-" or op == "\226\136\146" or op == "\226\128\147" or op == "\226\128\148" then
				return "-"
			end
			return "+"
		end

		local function solveBasicMathPuzzle(puzzle)
			local raw = tostring(puzzle and puzzle.Text or "")
			-- Chuẩn hóa ký tự toán học Unicode của game (\195\151 = ×, \226\136\146 = −, \195\183 = ÷)
			local expr = raw:gsub("=.*$", "")
			expr = expr:gsub("\195\151", "*")
			expr = expr:gsub("\194\183", "*")
			expr = expr:gsub("[xX]", "*")
			expr = expr:gsub("\226\136\146", "-")
			expr = expr:gsub("\226\128\147", "-")
			expr = expr:gsub("\226\128\148", "-")
			expr = expr:gsub("\195\183", "/")
			expr = expr:gsub(":", "/")
			expr = expr:gsub("%s+", "")
			if expr == "" then
				return nil
			end

			local pos = 1
			local len = #expr
			local parseExpr

			local function parsePrimary()
				if pos <= len and expr:sub(pos, pos) == "(" then
					pos += 1
					local val = parseExpr()
					if pos <= len and expr:sub(pos, pos) == ")" then
						pos += 1
					end
					return val
				end
				local numStr = expr:match("^%d+%.?%d*", pos)
				if not numStr then
					return nil
				end
				pos += #numStr
				return tonumber(numStr)
			end

			local function parseUnary()
				if pos <= len then
					local ch = expr:sub(pos, pos)
					if ch == "+" then
						pos += 1
						return parseUnary()
					elseif ch == "-" then
						pos += 1
						local inner = parseUnary()
						return inner and -inner or nil
					end
				end
				return parsePrimary()
			end

			local function parseTerm()
				local left = parseUnary()
				if not left then
					return nil
				end
				while pos <= len do
					local op = expr:sub(pos, pos)
					if op == "*" or op == "/" or op == "%" then
						pos += 1
						local right = parseUnary()
						if not right then
							return nil
						end
						if op == "*" then
							left = left * right
						elseif op == "/" then
							if math.abs(right) < 1e-9 then
								return nil
							end
							left = left / right
						else
							if math.abs(right) < 1e-9 then
								return nil
							end
							left = left % right
						end
					else
						break
					end
				end
				return left
			end

			parseExpr = function()
				local left = parseTerm()
				if not left then
					return nil
				end
				while pos <= len do
					local op = expr:sub(pos, pos)
					if op == "+" or op == "-" then
						pos += 1
						local right = parseTerm()
						if not right then
							return nil
						end
						if op == "+" then
							left = left + right
						else
							left = left - right
						end
					else
						break
					end
				end
				return left
			end

			local result = parseExpr()
			if type(result) ~= "number" or result ~= result then
				return nil
			end
			return math.floor(result + 0.5)
		end

		local function evalSymbolTerms(terms, values)
			if type(terms) ~= "table" or #terms == 0 then
				return nil
			end
			local firstVal = values[terms[1]]
			if firstVal == nil then
				return nil
			end

			local reducedNums = { firstVal }
			local reducedOps = {}
			local i = 2
			while i <= #terms do
				local op = normalizeMathOperator(terms[i])
				local symIdx = terms[i + 1]
				local nextVal = values[symIdx]
				if nextVal == nil then
					return nil
				end
				if op == "*" then
					reducedNums[#reducedNums] = reducedNums[#reducedNums] * nextVal
				elseif op == "/" then
					if math.abs(nextVal) < 1e-9 then
						return nil
					end
					reducedNums[#reducedNums] = reducedNums[#reducedNums] / nextVal
				else
					table.insert(reducedOps, op)
					table.insert(reducedNums, nextVal)
				end
				i += 2
			end

			local acc = reducedNums[1]
			for idx, op in ipairs(reducedOps) do
				local rhs = reducedNums[idx + 1]
				if op == "+" then
					acc += rhs
				else
					acc -= rhs
				end
			end
			return acc
		end

		local function solveSymbolMathPuzzle(puzzle)
			if type(puzzle) ~= "table" then
				return nil
			end
			local lines = puzzle.Lines or {}
			local question = puzzle.Question or {}

			local symbolSet = {}
			local symbolOrder = {}
			local function registerTerms(terms)
				for idx = 1, #terms, 2 do
					local sym = terms[idx]
					if sym ~= nil and not symbolSet[sym] then
						symbolSet[sym] = true
						table.insert(symbolOrder, sym)
					end
				end
			end

			for _, line in ipairs(lines) do
				if type(line) == "table" and type(line.Terms) == "table" then
					registerTerms(line.Terms)
				end
			end
			registerTerms(question)

			local values = {}

			-- Bước 1: Giải ngay các phương trình chỉ có 1 ẩn số
			local madeProgress = true
			while madeProgress do
				madeProgress = false
				for _, line in ipairs(lines) do
					if type(line) == "table" and type(line.Terms) == "table" and tonumber(line.Result) ~= nil then
						local unknownSym = nil
						local multipleUnknowns = false
						for idx = 1, #line.Terms, 2 do
							local sym = line.Terms[idx]
							if sym ~= nil and values[sym] == nil then
								if unknownSym == nil then
									unknownSym = sym
								elseif unknownSym ~= sym then
									multipleUnknowns = true
									break
								end
							end
						end

						if unknownSym ~= nil and not multipleUnknowns then
							local target = tonumber(line.Result)
							local foundVal = nil
							for candidate = 1, 50 do
								values[unknownSym] = candidate
								local v = evalSymbolTerms(line.Terms, values)
								if v and math.abs(v - target) < 1e-6 then
									foundVal = candidate
									break
								end
							end
							if foundVal == nil then
								for candidate = 0, 200 do
									values[unknownSym] = candidate
									local v = evalSymbolTerms(line.Terms, values)
									if v and math.abs(v - target) < 1e-6 then
										foundVal = candidate
										break
									end
								end
							end
							if foundVal ~= nil then
								values[unknownSym] = foundVal
								madeProgress = true
							else
								values[unknownSym] = nil
							end
						end
					end
				end
			end

			-- Bước 2: Quay lui (backtracking) tìm các ẩn số còn lại thỏa mãn toàn bộ hệ phương trình
			local unknowns = {}
			for _, sym in ipairs(symbolOrder) do
				if values[sym] == nil then
					table.insert(unknowns, sym)
				end
			end

			local function isConsistentPartial()
				for _, line in ipairs(lines) do
					if type(line) == "table" and type(line.Terms) == "table" and tonumber(line.Result) ~= nil then
						local allKnown = true
						for idx = 1, #line.Terms, 2 do
							if values[line.Terms[idx]] == nil then
								allKnown = false
								break
							end
						end
						if allKnown then
							local v = evalSymbolTerms(line.Terms, values)
							if not v or math.abs(v - tonumber(line.Result)) > 1e-6 then
								return false
							end
						end
					end
				end
				return true
			end

			local function searchUnknowns(depth, minVal, maxVal)
				if depth > #unknowns then
					return isConsistentPartial()
				end
				local sym = unknowns[depth]
				for candidate = minVal, maxVal do
					values[sym] = candidate
					if isConsistentPartial() and searchUnknowns(depth + 1, minVal, maxVal) then
						return true
					end
				end
				values[sym] = nil
				return false
			end

			if #unknowns > 0 then
				if not searchUnknowns(1, 1, 30) then
					searchUnknowns(1, 0, 100)
				end
			end

			local qResult = evalSymbolTerms(question, values)
			if type(qResult) ~= "number" or qResult ~= qResult then
				return nil
			end
			return math.floor(qResult + 0.5)
		end

		local function solvePathPuzzle(puzzle)
			if type(puzzle) ~= "table" or type(puzzle.Start) ~= "table" or type(puzzle.Goal) ~= "table" then
				return nil
			end
			local size = math.clamp(tonumber(puzzle.Size) or 4, 3, 8)
			local sx, sy = tonumber(puzzle.Start[1]), tonumber(puzzle.Start[2])
			local gx, gy = tonumber(puzzle.Goal[1]), tonumber(puzzle.Goal[2])
			if not sx or not sy or not gx or not gy then
				return nil
			end
			if sx == gx and sy == gy then
				return ""
			end

			local rocks = {}
			for _, r in ipairs(puzzle.Rocks or {}) do
				if type(r) == "table" and r[1] and r[2] then
					rocks[tostring(r[1]) .. "," .. tostring(r[2])] = true
				end
			end

			local dirs = {
				{ "U", 0, -1 },
				{ "D", 0, 1 },
				{ "L", -1, 0 },
				{ "R", 1, 0 },
			}

			local queue = { { x = sx, y = sy, path = "" } }
			local head = 1
			local visited = { [tostring(sx) .. "," .. tostring(sy)] = true }
			local maxMoves = tonumber(puzzle.MaxMoves) or (size * size)

			while head <= #queue do
				local cur = queue[head]
				head += 1
				if #cur.path < maxMoves then
					for _, d in ipairs(dirs) do
						local nx = cur.x + d[2]
						local ny = cur.y + d[3]
						if nx >= 1 and nx <= size and ny >= 1 and ny <= size then
							local key = tostring(nx) .. "," .. tostring(ny)
							if not rocks[key] and not visited[key] then
								local nextPath = cur.path .. d[1]
								if nx == gx and ny == gy then
									return nextPath
								end
								visited[key] = true
								table.insert(queue, { x = nx, y = ny, path = nextPath })
							end
						end
					end
				end
			end

			return nil
		end

		local function solveMemoryPuzzle(puzzle)
			if type(puzzle) ~= "table" or type(puzzle.Sequence) ~= "table" then
				return nil
			end
			local answer = {}
			local colorList = gameApi.TreasureHuntConfig and gameApi.TreasureHuntConfig.MemoryColors
			for i, item in ipairs(puzzle.Sequence) do
				if type(item) == "number" then
					answer[i] = item
				elseif type(item) == "string" and type(colorList) == "table" then
					for idx, def in ipairs(colorList) do
						if def.Name == item then
							answer[i] = idx
							break
						end
					end
				end
			end
			if #answer ~= #puzzle.Sequence or #answer == 0 then
				return nil
			end
			return answer
		end

		local function submitTreasureAnswer(chestId, seq, answer)
			local remote = gameApi.TreasureEvent
			if not remote then
				local folder = ReplicatedStorage:FindFirstChild("TreasureHunt")
				remote = folder and folder:FindFirstChild("TreasureEvent")
				gameApi.TreasureEvent = remote
			end
			if remote and remote:IsA("RemoteEvent") then
				remote:FireServer("Answer", {
					ChestId = chestId,
					Seq = seq,
					Answer = answer,
				})
				return true
			end
			return false
		end

		local function scheduleSolveTreasurePuzzle(chestId, seq, puzzle, startAt, isRetry)
			if type(puzzle) ~= "table" or type(puzzle.Kind) ~= "string" then
				return
			end
			treasureSolveToken += 1
			local token = treasureSolveToken

			task.spawn(function()
				if not state.isRunning then
					return
				end

				local kind = puzzle.Kind
				local answer = nil

				if kind == "Memory" then
					answer = solveMemoryPuzzle(puzzle)
					local seqLen = (type(puzzle.Sequence) == "table" and #puzzle.Sequence) or 0
					local showDur = math.max(0.4, tonumber(puzzle.Show) or 0.7)
					local leadWait = isRetry and 0.8 or math.max(0, (tonumber(startAt) or 0) - workspace:GetServerTimeNow())
					local totalWait = leadWait + (seqLen * showDur) + 0.15
					if totalWait > 0 then
						task.wait(math.min(totalWait, 12))
					end
				elseif kind == "Path" then
					answer = solvePathPuzzle(puzzle)
					task.wait(0.28)
				elseif kind == "SymbolMath" then
					answer = solveSymbolMathPuzzle(puzzle)
					task.wait(0.28)
				elseif kind == "BasicMath" then
					answer = solveBasicMathPuzzle(puzzle)
					task.wait(0.25)
				end

				if not state.isRunning or treasureSolveToken ~= token then
					return
				end
				if not activeTreasure or activeTreasure.Id ~= chestId or activeTreasure.Seq ~= seq or activeTreasure.Solved then
					return
				end
				if answer == nil then
					return
				end

				activeTreasure.LastSubmittedSeq = seq
				submitTreasureAnswer(chestId, seq, answer)
			end)
		end

		function flightSys.OnTreasureEvent(kind, data)
			if type(kind) ~= "string" or type(data) ~= "table" then
				return
			end

			if type(gameApi.TreasureHuntConfig) == "table" and gameApi.TreasureHuntConfig.SkipOnAutoThrow ~= false then
				gameApi.TreasureHuntConfig.SkipOnAutoThrow = false
			end

			if kind == "Spawn" then
				if type(data.Chests) == "table" then
					for _, chest in ipairs(data.Chests) do
						if type(chest) == "table" and chest.Id ~= nil and typeof(chest.Pos) == "Vector3" then
							spawnedChests[tostring(chest.Id)] = {
								Id = chest.Id,
								Tier = chest.Tier,
								Pos = chest.Pos,
								FlightId = data.FlightId,
								Done = false,
							}
						end
					end
				end
			elseif kind == "Open" then
				if data.ChestId == nil or type(data.Puzzle) ~= "table" then
					return
				end
				local chestKey = tostring(data.ChestId)
				if spawnedChests[chestKey] then
					spawnedChests[chestKey].Done = true
				end
				activeTreasure = {
					Id = data.ChestId,
					Tier = data.Tier,
					Seq = data.Seq or 1,
					StartAt = data.StartAt,
					Solved = false,
					RevealDoneSent = false,
				}
				scheduleSolveTreasurePuzzle(data.ChestId, activeTreasure.Seq, data.Puzzle, data.StartAt, false)
			elseif kind == "Wrong" then
				if activeTreasure and data.ChestId == activeTreasure.Id then
					activeTreasure.Seq = data.Seq or (activeTreasure.Seq + 1)
					if type(data.Puzzle) == "table" then
						-- TreasurePuzzleUI chờ 0.9s trước khi render puzzle mới sau khi trả lời sai
						local retryChestId = activeTreasure.Id
						local retrySeq = activeTreasure.Seq
						local retryPuzzle = data.Puzzle
						task.delay(0.95, function()
							if state.isRunning and activeTreasure and activeTreasure.Id == retryChestId and activeTreasure.Seq == retrySeq and not activeTreasure.Solved then
								scheduleSolveTreasurePuzzle(retryChestId, retrySeq, retryPuzzle, workspace:GetServerTimeNow(), true)
							end
						end)
					end
				end
			elseif kind == "Solved" then
				local chestId = data.ChestId or (activeTreasure and activeTreasure.Id)
				if chestId ~= nil then
					local chestKey = tostring(chestId)
					if spawnedChests[chestKey] then
						spawnedChests[chestKey].Done = true
					end
					if not activeTreasure or activeTreasure.Id == chestId then
						if not (activeTreasure and activeTreasure.Solved) then
							local maxChests = (gameApi.TreasureHuntConfig and tonumber(gameApi.TreasureHuntConfig.ChestsPerFlight)) or 3
							state.minigameState.treasureChestsOpened = math.min(maxChests, state.minigameState.treasureChestsOpened + 1)
							state.minigameState.lastChestClaimAt = os.clock()
						end
						activeTreasure = activeTreasure or { Id = chestId }
						activeTreasure.Solved = true
					end

					-- TreasureHuntClient sẽ tự chạy TreasureReveal.Play (~9.05s) và gửi RevealDone;
					-- Dự phòng gửi RevealDone sau 10.2s (trước RevealMaxWait = 11s) nếu rương chưa đóng/tiếp tục
					task.delay(10.2, function()
						if not state.isRunning then
							return
						end
						if activeTreasure and activeTreasure.Id == chestId and not activeTreasure.RevealDoneSent then
							activeTreasure.RevealDoneSent = true
							local remote = gameApi.TreasureEvent
							if remote and remote:IsA("RemoteEvent") then
								pcall(remote.FireServer, remote, "RevealDone", {
									ChestId = chestId,
								})
							end
							localPlayer:SetAttribute("TreasurePuzzleOpen", nil)
							activeTreasure = nil
						end
					end)
				end
			elseif kind == "Failed" or kind == "Resumed" or kind == "Closed" then
				local chestId = data.ChestId or (activeTreasure and activeTreasure.Id)
				if chestId ~= nil then
					local chestKey = tostring(chestId)
					if spawnedChests[chestKey] then
						spawnedChests[chestKey].Done = true
					end
					if activeTreasure and activeTreasure.Id == chestId then
						activeTreasure.RevealDoneSent = true
						activeTreasure = nil
					end
				end
				if kind == "Resumed" or kind == "Closed" then
					localPlayer:SetAttribute("TreasurePuzzleOpen", nil)
				end
			elseif kind == "Clear" then
				for chestId, chest in pairs(spawnedChests) do
					if data.FlightId == nil or chest.FlightId == data.FlightId then
						spawnedChests[chestId] = nil
					end
				end
				if activeTreasure and not activeTreasure.Solved then
					activeTreasure = nil
					localPlayer:SetAttribute("TreasurePuzzleOpen", nil)
				end
			end
		end

		local function processInFlightMinigames()
			if not state.isAutoThrowOn then
				return
			end
			local pg = localPlayer:FindFirstChild("PlayerGui")
			if not pg then return end

			local skillRollUi = pg:FindFirstChild("SkillRollUI") or pg:FindFirstChild("SkillPortalUI")
			if skillRollUi and skillRollUi.Enabled ~= false then
				triggerGuiButtonByPattern(skillRollUi, {"roll", "spin", "claim", "equip", "keep"})
			end

			local giftUi = pg:FindFirstChild("GiftUI") or pg:FindFirstChild("GiftZoneUI")
