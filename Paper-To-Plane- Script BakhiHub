		local allFuncs = filtergc("function", {}, false)
		for _, fnObj in ipairs(allFuncs or {}) do
			local src = debug.info(fnObj, "s")
			local paramCount, isVararg = debug.info(fnObj, "a")
			if type(src) == "string" and src:find("NitroController", 1, true) then
				local fnName = debug.info(fnObj, "n")
				if (fnName == "request" or fnName == "Request") and not isVararg and paramCount <= 1 then
					table.insert(gameApi.NitroHandlers, {
						fn = fnObj,
						params = paramCount,
					})
				end
			end
		end
	end

