		local function isRecordLive(record)
			local model = record.Model
			if typeof(model) == "Instance" and model.Parent == nil then
				return false
			end
			return not record.Sim.Landed and not record.LocalLanded
		end

		local function findFlightRecord(flightId)
			if type(filtergc) ~= "function" then
				return nil
			end
			local records = filtergc("table", {Keys = {"Own", "Sim", "BlendT", "LocalLanded"}}, false)
			for _, record in records or {} do
				if record.Own == true and type(record.Sim) == "table" then
					if flightId ~= nil and record.Id == flightId then
						return record
					end
					if flightId == nil and typeof(record.Model) == "Instance" and isRecordLive(record) then
						return record
					end
				end
			end
			return nil
		end

		function flightSys.RequestRecord(attempts)
			flight.SearchToken += 1
			local token = flight.SearchToken
			task.defer(function()
				for attempt = 1, attempts do
					if token ~= flight.SearchToken or not state.isRunning then
						return
					end
					local searchSucceeded, record = pcall(findFlightRecord, flight.Id)
					if searchSucceeded and record then
						flight.Record = record
						planner.NextPlanAt = 0
						if flight.Id == nil then
							flight.Id = record.Id
							flight.Active = true
							flight.StartedAt = os.clock()
						end
						return
					end
					task.wait(if attempt < (tuning and tuning.RecordFastTries or 10) then 0 else 0.25)
				end
			end)
		end

		local function isOwnFlightActive()
			if not flight.Active then
				return false
			end
			local record = flight.Record
			if record and not isRecordLive(record) then
				return false
			end
			return os.clock() - flight.StartedAt < tuning.FlightLimit
		end

		local function canSteer(record)
			local sim = record and record.Sim
			if type(sim) ~= "table" or sim.Landed or sim.Sliding or sim.Impact or record.ServerSteeringEnded then
				return false
			end
			return type(sim.SteeringBounds) == "table" and #sim.SteeringBounds > 0
		end

		local function isGameSmartFlightOn(record)
			local activeAutoThrowId = localPlayer:GetAttribute("FlightAutoThrow")
			if record and record.Id ~= nil and activeAutoThrowId ~= record.Id then
				return false
			end
			return localPlayer:GetAttribute("SmartFlightOn") == true
				and localPlayer:GetAttribute("AutoThrowOn") == true
				and localPlayer:GetAttribute("Pass_AutoThrow") == true
		end

		local function isGameAutoThrowOn()
			return localPlayer:GetAttribute("AutoThrowOn") == true and localPlayer:GetAttribute("Pass_AutoThrow") == true
		end

		local function isGamePaused()
			return localPlayer:GetAttribute("WorldTransition")
				or localPlayer:GetAttribute("IsFolding")
				or localPlayer:GetAttribute("CutscenePreviewing")
		end

		local function roundTenth(value)
			return math.floor(value * 10 + 0.5) / 10
		end

		local function lateralCommand(target, offset, velocity)
			local gap = target - offset - velocity / tuning.LateralResponse
			if math.abs(gap) <= tuning.LateralDeadband then
				return 0
			end
			local command = roundTenth(math.clamp(gap * tuning.LateralGain, -1, 1))
			if math.abs(command) < tuning.LateralDeadzone then
				return 0
			end
			return command
		end

		local function verticalCommand(target, height, velocity)
			local gap = target - height - velocity / tuning.VerticalResponse
			local command = 0
			if math.abs(gap) > tuning.VerticalDeadband then
				command = math.clamp(gap * tuning.VerticalGain, -1, 1)
				if math.abs(command) < 0.2 then
					command = if gap > 0 then 0.2 else -0.2
				end
			elseif target ~= 0 then
				command = if target > 0 then 0.2 else -0.2
			end
			command = roundTenth(command)
			if math.abs(command) < tuning.VerticalDeadzone then
				return 0
			end
			return command
		end

		local function integrateLateral(offset, velocity, command, deltaTime)
			local targetVelocity = command * tuning.LateralSpeed
			local response = tuning.LateralResponse
			local decay = math.exp(-response * deltaTime)
			local nextOffset = offset + targetVelocity * deltaTime + (velocity - targetVelocity) * (1 - decay) / response
			local nextVelocity = targetVelocity + (velocity - targetVelocity) * decay
			return nextOffset, nextVelocity
		end

		local function integrateVertical(height, velocity, command, deltaTime)
			local response = tuning.VerticalResponse
			local steps = math.max(1, math.ceil(deltaTime / (1 / 60)))
			local stepTime = deltaTime / steps
			local decay = math.exp(-response * stepTime)
			for _ = 1, steps do
				local targetVelocity = command * tuning.VerticalSpeed
				if command == 0 then
					targetVelocity = math.clamp(-height * tuning.ReturnRate, -tuning.ReturnMaxDescent, tuning.ReturnMaxRise)
				end
				height = height + targetVelocity * stepTime + (velocity - targetVelocity) * (1 - decay) / response
				velocity = targetVelocity + (velocity - targetVelocity) * decay
			end
			return height, velocity
		end

		local function lanePoint(sim, along, lateral, height)
			local origin = sim.Origin
			local heading = sim.Heading
			local right = sim.RightDirection
			return Vector3.new(
				origin.X + heading.X * along + right.X * lateral,
				height,
				origin.Z + heading.Z * along + right.Z * lateral
			)
		end

		local function laneBox(sim, frame, halfSize)
			local heading = sim.Heading
			local right = sim.RightDirection
			local frameRight = frame.RightVector
			local frameUp = frame.UpVector
			local frameLook = frame.LookVector
			local relative = frame.Position - sim.Origin
			local alongExtent = math.abs(heading:Dot(frameRight)) * halfSize.X
				+ math.abs(heading:Dot(frameUp)) * halfSize.Y
				+ math.abs(heading:Dot(frameLook)) * halfSize.Z
			local lateralExtent = math.abs(right:Dot(frameRight)) * halfSize.X
				+ math.abs(right:Dot(frameUp)) * halfSize.Y
				+ math.abs(right:Dot(frameLook)) * halfSize.Z
			local heightExtent = math.abs(frameRight.Y) * halfSize.X + math.abs(frameUp.Y) * halfSize.Y + math.abs(frameLook.Y) * halfSize.Z
			local along = relative:Dot(heading)
			local lateral = relative:Dot(right)
			local height = frame.Position.Y
			return along - alongExtent, along + alongExtent, lateral - lateralExtent, lateral + lateralExtent, height - heightExtent, height + heightExtent
		end

		local function isAxisAligned(frame)
			for _, axis in {frame.RightVector, frame.UpVector, frame.LookVector} do
				if math.max(math.abs(axis.X), math.abs(axis.Y), math.abs(axis.Z)) <= 0.9995 then
					return false
				end
			end
			return true
		end

		local function makeBlock(sim, frame, halfSize, margin)
			local alongLow, alongHigh, lateralLow, lateralHigh, heightLow, heightHigh = laneBox(sim, frame, halfSize)
			return {
				AlongLow = alongLow,
				AlongHigh = alongHigh,
				LateralLow = lateralLow,
				LateralHigh = lateralHigh,
				HeightLow = heightLow,
				HeightHigh = heightHigh,
				HardPad = tuning.HardPad + margin,
				SoftPad = tuning.SoftPad + margin,
				Frame = if isAxisAligned(frame) then nil else frame,
				Half = halfSize,
			}
		end

		local function addToSample(blocks, index, block)
			local list = blocks[index]
			if not list then
				list = {}
				blocks[index] = list
			end
			table.insert(list, block)
		end

		local function insertBlock(course, blocks, block)
			local pad = block.SoftPad
			local first = math.max(1, math.ceil((block.AlongLow - pad - course.ResponsePad - course.Along[0]) / course.StepDistance))
			local last = math.min(course.Count, math.floor((block.AlongHigh + pad - course.Along[0]) / course.StepDistance) + 1)
			for index = first, last do
				addToSample(blocks, index, block)
			end
		end

		local function getHazardBoxAt(hazard, atTime)
			local frame, halfSize = gameApi.HazardSystem.Box(hazard, atTime)
			if not frame or not halfSize then
				return nil, nil
			end
			if hazard.Motion and hazard.Motion.Kind == "Spin" and type(gameApi.HazardSystem.Transform) == "function" then
				local xform = gameApi.HazardSystem.Transform(hazard, atTime)
				if typeof(xform) == "CFrame" then
					frame = xform * frame
				end
			end
			return frame, halfSize
		end

		local function resetPlanner(record)
			ensureWorld6HazardsMerged()
			local world = gameApi.WorldConfig.AtPosition(record.Sim.Origin)
			planner.Record = record
			planner.WorldId = (world and world.WorldId) or 1
			planner.Stage = 1
			planner.StaticBlocks = {}
			planner.Extras = {}
			planner.Target = nil
			planner.PlanCount = 0
			planner.Dir = 0
			planner.DirAt = -10
			planner.ClearSince = nil
			planner.Home = record.Sim.LateralOffset or 0
			planner.LastBestHit = false
			planner.LastHadThreat = false
			planner.RayParams = gameApi.FlightSim.BuildRaycastParams()
		end

		local function buildCourse(sim)
			local speed = math.max((sim.MotionSpeed or sim.Speed or 0) * tuning.TimeScale, 25)
			local stage = 1
			if planner.WorldId == 6 and gameApi.World6Config and type(gameApi.World6Config.StageOf) == "function" then
				stage = gameApi.World6Config.StageOf(sim.Pos.X)
			elseif gameApi.WorldLayout and gameApi.WorldLayout.StageLength then
				local stLen = gameApi.WorldLayout.StageLength[planner.WorldId] or 1900
				stage = math.clamp(math.floor((sim.Along or 0) / stLen) + 1, 1, 10)
			end
			planner.Stage = stage
			local lookMult = 1
			if smartConfig and type(smartConfig.Profile) == "function" then
				local okProf, lm = pcall(smartConfig.Profile, planner.WorldId, stage)
				if okProf and type(lm) == "number" then
					lookMult = lm
				end
			end
			local lookaheadDist = math.clamp(speed * tuning.LookaheadTime * lookMult, tuning.MinLookahead, tuning.MaxLookahead)
			local stepTime = (lookaheadDist / speed) / tuning.Samples
			local stepDistance = speed * stepTime
			local profileStart = (sim.World1 and sim.PathAlong) or sim.Along
			local course = {
				Speed = speed,
				StepTime = stepTime,
				StepDistance = stepDistance,
				ResponsePad = speed * tuning.ResponseTime,
				Count = 0,
				Along = {[0] = sim.Along},
				BaseY = {},
				BandLow = {},
				BandHigh = {},
				BoundLow = {},
				BoundHigh = {},
				Late = {},
			}
			for index = 1, tuning.Samples do
				local baseY, progress, heightOffset = sim:_profileY(profileStart + stepDistance * index)
				if progress >= 1 then
					break
				end
				local along = sim.Along + stepDistance * index
				local bandLow, bandHigh = gameApi.FlightSteering.VerticalBand(progress, heightOffset)
				local boundLow, boundHigh = gameApi.FlightSteering.Limits(sim.SteeringBounds, along)
				course.Along[index] = along
				course.BaseY[index] = baseY
				course.BandLow[index] = bandLow
				course.BandHigh[index] = math.min(bandHigh, math.max(0, sim:CeilingRoom(baseY)))
				course.BoundLow[index] = boundLow
				course.BoundHigh[index] = boundHigh
				course.Late[index] = progress >= tuning.CruiseEnd
				course.Count = index
			end
			return course
		end

		local function simulateLateral(sim, course, firstTarget, secondTarget, switchIndex, prefix)
			local offset = sim.LateralOffset or 0
			local velocity = sim.LateralVelocity or 0
			local wind = sim.WindDrift or 0
			local subTime = course.StepTime / 2
			local path = {[0] = offset}
			local velocities = {[0] = velocity}
			local startIndex = 1
			if prefix and switchIndex then
				local shared = math.min(switchIndex, course.Count)
				for index = 1, shared do
					path[index] = prefix.Path[index]
					velocities[index] = prefix.Velocities[index]
				end
				offset = path[shared]
				velocity = velocities[shared]
				startIndex = shared + 1
			end
			for index = startIndex, course.Count do
				local target = firstTarget
				if switchIndex and index > switchIndex then
					target = secondTarget
				end
				local boundLow = course.BoundLow[index]
				local boundHigh = course.BoundHigh[index]
				for _ = 1, 2 do
					local command = lateralCommand(target, offset, velocity)
					local nextOffset, nextVelocity = integrateLateral(offset, velocity, command, subTime)
					nextOffset += wind * subTime
					offset = math.clamp(nextOffset, math.min(offset, boundLow), math.max(offset, boundHigh))
					velocity = nextVelocity
				end
				path[index] = offset
				velocities[index] = velocity
			end
			return path, velocities
		end

		local function simulateHeights(sim, course, verticalTarget)
			local heights = {[0] = sim.Pos.Y}
			local height = sim.ManualHeightOffset or 0
			local velocity = sim.ManualHeightVelocity or 0
			local subTime = course.StepTime / 2
			local ceiling = sim.CeilingY
			for index = 1, course.Count do
				local bandLow = course.BandLow[index]
				local bandHigh = course.BandHigh[index]
				for _ = 1, 2 do
					local command = verticalCommand(verticalTarget, height, velocity)
					if command > 0 then
						command *= math.clamp((bandHigh - height) / tuning.CeilingSoftZone, 0, 1)
					end
					height, velocity = integrateVertical(height, velocity, command, subTime)
					if height > bandHigh then
						height = bandHigh
						velocity = math.min(velocity, 0)
					end
					if height < bandLow then
						height = bandLow
						velocity = math.max(velocity, 0)
					end
				end
				local y = course.BaseY[index] + height
				if ceiling and y > ceiling then
					y = ceiling
				end
				heights[index] = y
			end
			return heights
		end

		local function addTimedBlocks(sim, course, blocks, hazard, moving, serverNow, extraMargin)
			local heading = sim.Heading
			local origin = sim.Origin
			local margin = tuning.MovingMargin + (extraMargin or 0)
			local reach = tuning.SoftPad + margin + 4
			local timeMargin = if moving then tuning.MovingTimeMargin else tuning.LaserTimeMargin
			for index = 1, course.Count do
				local startX = origin.X + heading.X * course.Along[index - 1]
				local endX = origin.X + heading.X * course.Along[index]
				if hazard.MinX <= math.max(startX, endX) + reach and math.min(startX, endX) - reach <= hazard.MaxX then
					local sampleTime = serverNow + (index - 0.5) * course.StepTime
					for _, time in {sampleTime, sampleTime - timeMargin, sampleTime + timeMargin} do
						local frame, halfSize = getHazardBoxAt(hazard, time)
						if frame then
							local block = makeBlock(sim, frame, halfSize, margin)
							local pad = block.SoftPad
							if course.Along[index] + course.ResponsePad >= block.AlongLow - pad and course.Along[index - 1] <= block.AlongHigh + pad then
								addToSample(blocks, index, block)
							end
							if not moving then
								break
							end
						end
					end
				end
			end
		end

		-- Bộ đệm đối tượng động theo sự kiện (loại bỏ quét workspace:GetDescendants() mỗi khung hình gây lag khi bay)
		local trackedDynamicHazards = {}
		local trackedGifts = {}
		local trackedSkillRings = {}
		local trackedBossOrbs = {}
		local trackedPortalsAndChests = {}

		local function classifyDynamicInstance(obj)
			if not obj or not obj.Parent then return end
			local isPart = obj:IsA("BasePart")
			local isModel = obj:IsA("Model")
			if not isPart and not isModel then return end
			local n = obj.Name:lower()
			if isPart and (n:find("bossrock") or n:find("octopusrock") or n:find("inkcloud") or n:find("inkblob") or n:find("whirlpool")) then
				trackedDynamicHazards[obj] = true
			elseif n:find("giftportal") or n:find("giftgate") or n:find("giftzoneportal") or obj:GetAttribute("GiftPortal") == true then
				trackedPortalsAndChests[obj] = "GiftPortal"
			elseif n:find("skillportal") or obj:GetAttribute("SkillPortal") == true then
				trackedPortalsAndChests[obj] = "SkillPortal"
			elseif n:find("treasurechest") or obj:GetAttribute("TreasureChest") ~= nil then
				trackedPortalsAndChests[obj] = "TreasureChest"
			elseif n:find("skillring") or n:find("portalring") or obj:GetAttribute("SkillRingIndex") ~= nil then
				trackedSkillRings[obj] = true
			elseif n:find("bossorb") or n:find("octopusorb") or obj:GetAttribute("BossOrb") == true then
				trackedBossOrbs[obj] = true
			elseif n:find("gift") or n:find("present") or obj:GetAttribute("GiftId") ~= nil then
				trackedGifts[obj] = true
			end
		end

		local function unclassifyDynamicInstance(obj)
			trackedDynamicHazards[obj] = nil
			trackedGifts[obj] = nil
			trackedSkillRings[obj] = nil
			trackedBossOrbs[obj] = nil
			trackedPortalsAndChests[obj] = nil
		end

		task.defer(function()
			for _, folderName in ipairs({"World6Boss", "GiftZone", "SkillPortal", "TreasureHunt"}) do
				local folder = workspace:FindFirstChild(folderName)
				if folder then
					for _, desc in ipairs(folder:GetDescendants()) do
						classifyDynamicInstance(desc)
					end
				end
			end
		end)

		trackConnection(workspace.DescendantAdded:Connect(classifyDynamicInstance))
		trackConnection(workspace.DescendantRemoving:Connect(unclassifyDynamicInstance))

		local function addWorld6DynamicBlocks(sim, course, blocks, serverNow)
			if planner.WorldId ~= 6 or not gameApi.World6Config then
				return
			end
			local fid = (planner.Record and planner.Record.Id) or flight.Id
			local eventList = fid and w6EventBoxes[fid]
			local w6Margin = tuning.MovingMargin + tuning.World6Margin
			local timeMargin = tuning.MovingTimeMargin

			if type(eventList) == "table" then
				for i = #eventList, 1, -1 do
					local box = eventList[i]
					if box.T1 + 0.5 < serverNow then
						table.remove(eventList, i)
					else
						for index = 1, course.Count do
							local sampleTime = serverNow + (index - 0.5) * course.StepTime
							if sampleTime >= box.T0 - timeMargin and sampleTime <= box.T1 + timeMargin then
								local timesToCheck = (box.Lunge or box.Rock)
									and {sampleTime, sampleTime - timeMargin, sampleTime + timeMargin}
									or {sampleTime}
								for _, tCheck in ipairs(timesToCheck) do
									if tCheck >= box.T0 and tCheck <= box.T1 then
										local cf = evalWorld6EventBoxCF(box, tCheck)
										if cf then
											local blk = makeBlock(sim, cf, box.Half, w6Margin)
											local pad = blk.SoftPad
											if course.Along[index] + course.ResponsePad >= blk.AlongLow - pad and course.Along[index - 1] <= blk.AlongHigh + pad then
												addToSample(blocks, index, blk)
											end
										end
									end
								end
							end
						end
					end
				end
			end

			for obj in pairs(trackedDynamicHazards) do
				if not obj.Parent then
					trackedDynamicHazards[obj] = nil
				elseif (obj.Position - sim.Pos).Magnitude <= 500 then
					insertBlock(course, blocks, makeBlock(sim, obj.CFrame, obj.Size * 0.5, w6Margin))
				end
			end
		end

		local function collectBlocks(sim, course)
			local blocks = {}
			local hsMod = gameApi.HazardSystem
			local hazards = (hsMod and hsMod.ByWorld and hsMod.ByWorld[planner.WorldId]) or {}
			local heading = sim.Heading
			local origin = sim.Origin
			local startX = origin.X + heading.X * course.Along[0]
			local endX = origin.X + heading.X * course.Along[course.Count]
			local lowX = math.min(startX, endX) - 16
			local highX = math.max(startX, endX) + 16
			local serverNow = workspace:GetServerTimeNow()
			local isBoosting = (sim.BoostK or 0) > 0.25 or (sim.NitroK or 0) > 0.25
			local dropTable = gameApi.HazardBoost and gameApi.HazardBoost.Drop
			local w6ExtraMargin = if planner.WorldId == 6 then (tuning.World6Margin or 1.0) else 0

			local startIndex = 1
			if hsMod and type(hsMod.FirstIndex) == "function" and #hazards > 0 then
				startIndex = math.max(1, hsMod.FirstIndex(hazards, lowX) or 1)
			end

			for idx = startIndex, #hazards do
				local hazard = hazards[idx]
				if hazard.MinX > highX then
					break
				end
				if hazard.MaxX >= lowX and hazard.Collide ~= false then
					if isBoosting and dropTable and hazard.Id and dropTable[hazard.Id] then
						continue
					end
					local moving = hazard.Motion ~= nil
					if moving or hazard.Laser then
						addTimedBlocks(sim, course, blocks, hazard, moving, serverNow, w6ExtraMargin)
					else
						local cached = planner.StaticBlocks[hazard]
						if cached == nil then
							local frame, halfSize = hsMod.Box(hazard, 0)
							cached = if frame then makeBlock(sim, frame, halfSize, w6ExtraMargin) else false
							planner.StaticBlocks[hazard] = cached
						end
						if cached then
							insertBlock(course, blocks, cached)
						end
					end
				end
			end

			addWorld6DynamicBlocks(sim, course, blocks, serverNow)

			-- Tuyệt đối tránh vòng SLOW: đưa trực tiếp vào danh sách vật cản cứng theo quỹ đạo chuyển động của vòng
			local flightId = (planner.Record and planner.Record.Id) or flight.Id
			local ringClock = math.max(0, (sim.Time or 0) - tuning.FixedStep + ((planner.Record and planner.Record.Acc) or 0)) / tuning.TimeScale
			local slowRadius = tuning.SlowClearance
			local slowReach = slowRadius + 14
			for ringId, ring in pairs(rings) do
				if ring.FlightId == flightId and ring.Type == "Slow" then
					local baseAlong = (ring.Position - sim.Origin):Dot(sim.Heading)
					if baseAlong + slowReach >= course.Along[0] and baseAlong - slowReach <= course.Along[course.Count] then
						for index = 1, course.Count do
							local crossTime = (index - 0.5) * course.StepTime
							local pos = ring.Position
							if ring.Motion and ring.Right and gameApi.RingConfig and type(gameApi.RingConfig.MotionOffset) == "function" then
								pos = pos + gameApi.RingConfig.MotionOffset(ring.Motion, ring.Right, ringClock + crossTime)
							end
							local rel = pos - sim.Origin
							local rAlong = rel:Dot(sim.Heading)
							if course.Along[index] + course.ResponsePad >= rAlong - slowRadius and course.Along[index - 1] <= rAlong + slowRadius then
								local rLat = rel:Dot(sim.RightDirection)
								addToSample(blocks, index, {
									AlongLow = rAlong - 2.2,
									AlongHigh = rAlong + 2.2,
									LateralLow = rLat - slowRadius * 0.72,
									LateralHigh = rLat + slowRadius * 0.72,
									HeightLow = pos.Y - slowRadius * 0.72,
									HeightHigh = pos.Y + slowRadius * 0.72,
									HardPad = 1.6,
									SoftPad = 3.2,
									Frame = nil,
									Half = Vector3.new(2.2, slowRadius * 0.72, slowRadius * 0.72),
									IsSlowRing = true,
								})
							end
						end
					end
				end
			end

			local now = os.clock()
			for index = #planner.Extras, 1, -1 do
				local extra = planner.Extras[index]
				if extra.Until < now then
					table.remove(planner.Extras, index)
				else
					insertBlock(course, blocks, extra)
				end
			end
			return blocks
		end

		local function crossingPoint(course, along)
			local index = math.clamp(math.ceil((along - course.Along[0]) / course.StepDistance), 1, course.Count)
			local fraction = math.clamp((along - course.Along[index - 1]) / course.StepDistance, 0, 1)
			return index, fraction
		end

		local function syncVisualRingsFromWorkspace(flightId, sim)
			if not flightId then
				return
			end
			local visualsRoot = workspace:FindFirstChild("PaperPlaneFlightVisuals")
			local ringFolder = visualsRoot and visualsRoot:FindFirstChild("FlightRings_" .. tostring(flightId))
			if not ringFolder then
				return
			end
			for _, child in ipairs(ringFolder:GetChildren()) do
				if child:IsA("Model") then
					local rId = child:GetAttribute("RingId") or child.Name:gsub("^Ring_", "")
					local rType = child:GetAttribute("RingType")
					if rId and type(rType) == "string" and not rings[rId] then
						local piv = child:GetPivot()
						rings[rId] = {
							FlightId = flightId,
							RingId = rId,
							Type = rType,
							Position = piv.Position,
							Heading = sim.Heading,
							Right = sim.RightDirection,
							FromVisuals = true,
						}
					elseif rId and rings[rId] and rings[rId].FromVisuals then
						rings[rId].Position = child:GetPivot().Position
					end
				end
			end
		end

		local function addTarget(targets, sim, course, kind, weight, along, positionAt, ringId, ringType)
			local index, fraction = crossingPoint(course, along)
			local crossTime = (index - 1 + fraction) * course.StepTime
			local position = positionAt(crossTime)
			local relative = position - sim.Origin
			local lateral = relative:Dot(sim.RightDirection)
			local height = position.Y
			if kind == "Item" then
				local curLat = sim.LateralOffset or 0
				local curY = sim.Pos.Y
				local maxLatReach = tuning.LateralSpeed * crossTime + tuning.HitRadius + 2.5
				local maxVertReach = tuning.VerticalSpeed * crossTime + tuning.HitRadius + 3.0
				if math.abs(lateral - curLat) > maxLatReach or math.abs(height - curY) > maxVertReach then
					return
				end
			end
			table.insert(targets, {
				Kind = kind,
				Weight = weight,
				Index = index,
				Fraction = fraction,
				Time = crossTime,
				Lateral = lateral,
				Height = height,
				RingId = ringId,
				RingType = ringType,
			})
		end

		local function collectMinigameTargets(targets, sim, course)
			if not state.isAutoThrowOn then
				return
			end

			local firstAlong = course.Along[0]
			local lastAlong = course.Along[course.Count]

			local giftOrigin = (gameApi.GiftZoneConfig and gameApi.GiftZoneConfig.Cave and gameApi.GiftZoneConfig.Cave.Origin) or Vector3.new(30000, 3000, 60000)
			local inGiftCave = (sim.Pos - giftOrigin).Magnitude < 4000 or localPlayer:GetAttribute("InGiftCave") == true
			if inGiftCave then
				for obj in pairs(trackedGifts) do
					if not obj.Parent then
						trackedGifts[obj] = nil
					elseif not obj:GetAttribute("Collected") then
						local p = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
						local along = (p - sim.Origin):Dot(sim.Heading)
						if along > firstAlong and along <= lastAlong then
							addTarget(targets, sim, course, "Item", 30, along, function() return p end)
						end
					end
				end
			end

			local inSkillPortal = localPlayer:GetAttribute("InSkillPortal") == true or localPlayer:GetAttribute("SkillPortalActive") == true
			if inSkillPortal then
				for obj in pairs(trackedSkillRings) do
					if not obj.Parent then
						trackedSkillRings[obj] = nil
					elseif not obj:GetAttribute("Passed") then
						local p = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
						local along = (p - sim.Origin):Dot(sim.Heading)
						if along > firstAlong and along <= lastAlong then
							addTarget(targets, sim, course, "Item", 32, along, function() return p end)
						end
					end
				end
			end

			if planner.WorldId == 6 and gameApi.World6Config and sim.Pos.X >= gameApi.World6Config.Boss.TriggerX then
				for obj in pairs(trackedBossOrbs) do
					if not obj.Parent then
						trackedBossOrbs[obj] = nil
					else
						local p = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
						local along = (p - sim.Origin):Dot(sim.Heading)
						if along > firstAlong and along <= lastAlong then
							addTarget(targets, sim, course, "Item", 28, along, function() return p end)
						end
					end
				end
			end

			local maxChestsPerFlight = (gameApi.TreasureHuntConfig and tonumber(gameApi.TreasureHuntConfig.ChestsPerFlight)) or 3
			local currentFlightId = (planner.Record and planner.Record.Id) or flight.Id
			local targetedChestIds = {}

			if state.minigameState.treasureChestsOpened < maxChestsPerFlight then
				for chestId, chest in pairs(spawnedChests) do
					if not chest.Done and (chest.FlightId == nil or currentFlightId == nil or chest.FlightId == currentFlightId) then
						local p = chest.Pos
						local along = (p - sim.Origin):Dot(sim.Heading)
						if along > firstAlong and along <= lastAlong then
							targetedChestIds[tostring(chestId)] = true
							addTarget(targets, sim, course, "Item", 24, along, function() return p end)
						end
					end
				end
			end

			for obj, kind in pairs(trackedPortalsAndChests) do
				if not obj.Parent then
					trackedPortalsAndChests[obj] = nil
				else
					local p = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
					local along = (p - sim.Origin):Dot(sim.Heading)
					if along > firstAlong and along <= lastAlong then
						if kind == "GiftPortal" then
							addTarget(targets, sim, course, "Item", 26, along, function() return p end)
						elseif kind == "SkillPortal" then
							addTarget(targets, sim, course, "Item", 24, along, function() return p end)
						elseif kind == "TreasureChest" and state.minigameState.treasureChestsOpened < maxChestsPerFlight then
							local chestIdFromName = obj.Name:match("^TreasureChest_(.+)$")
							local chestEntry = chestIdFromName and spawnedChests[chestIdFromName]
							if not (chestEntry and chestEntry.Done) and not (chestIdFromName and targetedChestIds[chestIdFromName]) then
								addTarget(targets, sim, course, "Item", 22, along, function() return p end)
							end
						end
					end
				end
			end
		end

		local function collectTargets(sim, record, course)
			local targets = {}
			local firstAlong = course.Along[0]
			local lastAlong = course.Along[course.Count]
			local flightId = record.Id or flight.Id
			syncVisualRingsFromWorkspace(flightId, sim)
			local ringClock = math.max(0, (sim.Time or 0) - tuning.FixedStep + (record.Acc or 0)) / tuning.TimeScale
			local positiveTypes = gameApi.RingConfig.Positive or {}
			for ringId, ring in pairs(rings) do
				if ring.FlightId == flightId then
					local along = (ring.Position - sim.Origin):Dot(sim.Heading)
					if along < firstAlong - 20 then
						rings[ringId] = nil
					else
						local isSlow = ring.Type == "Slow"
						local isPositive = not isSlow and (positiveTypes[ring.Type] == true or ring.Type == "Reward" or itemWeights[ring.Type] ~= nil)
						if (isSlow or isPositive) and along > firstAlong + 1.5 and along <= lastAlong then
							local weight = if isSlow then 0 else (itemWeights[ring.Type] or 10)
							addTarget(targets, sim, course, if isSlow then "Slow" else "Item", weight, along, function(crossTime)
								if ring.Motion and ring.Right and gameApi.RingConfig and type(gameApi.RingConfig.MotionOffset) == "function" then
									return ring.Position + gameApi.RingConfig.MotionOffset(ring.Motion, ring.Right, ringClock + crossTime)
								end
								return ring.Position
							end, ringId, ring.Type)
						end
					end
				end
			end
			for _, candyPosition in candies do
				local along = (candyPosition - sim.Origin):Dot(sim.Heading)
				if along > firstAlong and along <= lastAlong then
					addTarget(targets, sim, course, "Item", itemWeights.Candy, along, function()
						return candyPosition
					end)
				end
			end

			collectMinigameTargets(targets, sim, course)

			table.sort(targets, function(first, second)
				return first.Time < second.Time
			end)
			return targets
		end

		local function activeLateralTarget(target)
			if target.SwitchAt and os.clock() >= target.SwitchAt then
				return target.Second
			end
			return target.First
		end

		local function buildCandidates(sim, course, targets)
			local low = math.huge
			local high = -math.huge
			for index = 1, course.Count do
				low = math.min(low, course.BoundLow[index])
				high = math.max(high, course.BoundHigh[index])
			end
			local candidates = {}
			local seenKeys = {}
			local function add(first, second, switchIndex, prefix)
				local q1 = math.floor(first * 10 + 0.5)
				local q2 = second and math.floor(second * 10 + 0.5) or 999999
				local sw = switchIndex or 0
				local key = q1 .. ":" .. q2 .. ":" .. sw
				if seenKeys[key] then
					return
				end
				seenKeys[key] = true
				table.insert(candidates, {First = first, Second = second, Switch = switchIndex, Prefix = prefix})
			end
			local curOffset = sim.LateralOffset or 0
			add(curOffset)
			if planner.Target then
				add(activeLateralTarget(planner.Target))
			end
			if low >= high then
				return candidates
			end
			local homeOffset = math.clamp(planner.Home or 0, low + 4, high - 4)
			add(homeOffset)
			add(0)
			local width = high - low
			local step = math.max(3.5, width / 28)
			local lateral = low
			while lateral <= high + 0.001 do
				add(lateral)
				lateral += step
			end
			local items = {}
			for _, target in targets do
				if target.Kind == "Item" and target.Lateral >= low - 2 and target.Lateral <= high + 2 and #items < tuning.MaxItems then
					table.insert(items, target)
				end
			end
			for itemIndex, item in items do
				local itemPrefix = {First = item.Lateral}
				add(item.Lateral)
				for laterIndex = itemIndex + 1, #items do
					add(item.Lateral, items[laterIndex].Lateral, item.Index, itemPrefix)
				end
				for share = 0, 6 do
					add(item.Lateral, low + width * share / 6, item.Index, itemPrefix)
				end
			end
			local previous = planner.Target
			local now = os.clock()
			if previous and previous.SwitchAt and previous.SwitchAt > now then
				add(previous.First, previous.Second, math.ceil((previous.SwitchAt - now) / course.StepTime))
			end
			local lanes = {}
			for share = 0, tuning.TwoStageLanes do
				table.insert(lanes, low + width * share / tuning.TwoStageLanes)
			end
			local firsts = {curOffset, homeOffset}
			if previous then
				table.insert(firsts, activeLateralTarget(previous))
			end
			for _, lane in lanes do
				table.insert(firsts, lane)
			end
			for _, first in firsts do
				local firstPrefix = {First = first}
				for _, second in lanes do
					if math.abs(second - first) >= step * 1.5 then
						for _, switchIndex in tuning.TwoStageSwitches do
							if switchIndex < course.Count then
								add(first, second, switchIndex, firstPrefix)
							end
						end
					end
				end
			end
			return candidates
		end

		local function edgeCost(course, path)
			local total = 0
			for index = 1, course.Count do
				local room = math.min(path[index] - course.BoundLow[index], course.BoundHigh[index] - path[index])
				if room < tuning.EdgeZone then
					total += tuning.EdgeCost * (1 - math.max(room, 0) / tuning.EdgeZone)
				end
			end
			return total / course.Count
		end

		local function checkPath(sim, course, blocks, lateralPath, heights)
			local softCost = 0
			for index = 1, course.Count do
				local list = blocks[index]
				if list then
					local lateralStart = lateralPath[index - 1]
					local lateralEnd = lateralPath[index]
					local heightStart = heights[index - 1]
					local heightEnd = heights[index]
					local alongStart = course.Along[index - 1]
					local alongEnd = course.Along[index] + course.ResponsePad
					local lateralLow = math.min(lateralStart, lateralEnd)
					local lateralHigh = math.max(lateralStart, lateralEnd)
					local heightLow = math.min(heightStart, heightEnd)
					local heightHigh = math.max(heightStart, heightEnd)
					for _, block in list do
						local soft = block.SoftPad
						local softOverlap = alongEnd >= block.AlongLow - soft
							and alongStart <= block.AlongHigh + soft
							and lateralHigh >= block.LateralLow - soft
							and lateralLow <= block.LateralHigh + soft
							and heightHigh >= block.HeightLow - soft
							and heightLow <= block.HeightHigh + soft
						if softOverlap then
							local hard = block.HardPad
							local softHit = true
							local hardHit
							if block.Frame then
								local startPoint = lanePoint(sim, alongStart, lateralStart, heightStart)
								local endPoint = lanePoint(sim, alongEnd, lateralEnd, heightEnd)
								softHit = gameApi.HazardSystem.SegmentBox(block.Frame, block.Half, startPoint, endPoint, soft) ~= nil
								hardHit = softHit and gameApi.HazardSystem.SegmentBox(block.Frame, block.Half, startPoint, endPoint, hard) ~= nil
							else
								hardHit = alongEnd >= block.AlongLow - hard
									and alongStart <= block.AlongHigh + hard
									and lateralHigh >= block.LateralLow - hard
									and lateralLow <= block.LateralHigh + hard
									and heightHigh >= block.HeightLow - hard
									and heightLow <= block.HeightHigh + hard
							end
							if hardHit then
								local depth = math.min(lateralEnd - (block.LateralLow - hard), block.LateralHigh + hard - lateralEnd)
								return index, softCost, math.max(depth, 0)
							end
							if softHit then
								softCost += tuning.SoftCost
							end
						end
					end
				end
			end
			return nil, softCost
		end

		local function scoreTargets(targets, lateralPath, heights, horizonTime)
			local cost = 0
			for _, target in targets do
				local index = target.Index
				local fraction = target.Fraction
				local lateral = lateralPath[index - 1] + (lateralPath[index] - lateralPath[index - 1]) * fraction
				local height = heights[index - 1] + (heights[index] - heights[index - 1]) * fraction
				local dLat = lateral - target.Lateral
				local dY = height - target.Height
				local distance = math.sqrt(dLat * dLat + dY * dY)
				if target.Kind == "Slow" then
					if distance < tuning.SlowClearance then
						cost += tuning.SlowCost + (tuning.SlowClearance - distance) * 2500
					end
				else
					local share = 0
					if distance <= tuning.PassRadius then
						share = 1.0
					elseif distance <= tuning.HitRadius then
						share = 0.85
					elseif distance <= 26 then
						share = 0.22 * (1 - distance / 26)
					end
					cost -= target.Weight * share * (1 - 0.25 * target.Time / math.max(horizonTime, 0.1))
				end
			end
			return cost
		end

		local function choosePlan(sim, course, blocks, targets, candidates, heightPaths, returnPull, reversePenaltyDir)
			local previous = planner.Target
			local curOffset = sim.LateralOffset or 0
			local previousLateral = if previous then activeLateralTarget(previous) else curOffset
			local previousVertical = if previous then previous.Vertical else 0
			local horizonTime = course.Count * course.StepTime
			local homeOffset = planner.Home or 0
			local best = nil
			for _, candidate in candidates do
				local prefix = candidate.Prefix
				if prefix and not prefix.Path then
					prefix.Path, prefix.Velocities = simulateLateral(sim, course, prefix.First)
					prefix.LatestHit = 0
					for _, option in heightPaths do
						local hitIndex = checkPath(sim, course, blocks, prefix.Path, option.Heights) or math.huge
						prefix.LatestHit = math.max(prefix.LatestHit, hitIndex)
					end
				end
				if prefix and prefix.LatestHit <= candidate.Switch then
					continue
				end
				if not candidate.Path then
					candidate.Path = simulateLateral(sim, course, candidate.First, candidate.Second, candidate.Switch, prefix)
					candidate.Edge = edgeCost(course, candidate.Path)
				end
				local moveFromCurrent = candidate.First - curOffset
				local moveDir = if math.abs(moveFromCurrent) > tuning.LateralDeadband then (if moveFromCurrent > 0 then 1 else -1) else 0
				local lateralCost = candidate.Edge + math.abs(candidate.First - previousLateral) * tuning.LateralChangeCost
				if candidate.Second then
					lateralCost += math.abs(candidate.Second - candidate.First) * (tuning.LateralChangeCost * 0.75)
				end
				if reversePenaltyDir ~= 0 and moveDir == reversePenaltyDir then
					lateralCost += tuning.FlutterCost
				end
				if returnPull > 0 then
					lateralCost += math.abs(candidate.First - homeOffset) * returnPull
				end
				for _, option in heightPaths do
					local hitIndex, softCost, hitDepth = checkPath(sim, course, blocks, candidate.Path, option.Heights)
					local cost = lateralCost + softCost + scoreTargets(targets, candidate.Path, option.Heights, horizonTime)
					cost += math.abs(option.Target) * tuning.VerticalHoldCost
					if option.Target ~= previousVertical then
						cost += tuning.VerticalSwitchCost
					end
					if hitIndex then
						cost += tuning.CrashCost + (course.Count - hitIndex) * 1e3
						cost += math.min(hitDepth, tuning.StuckDepthLimit) * tuning.StuckDepthCost
					end
					if not best or cost < best.Cost then
						best = {Cost = cost, Candidate = candidate, Vertical = option.Target, Heights = option.Heights, Hit = hitIndex, SoftCost = softCost}
					end
				end
			end
			return best
		end

		local function isFlightBarrier(instance)
			local current = instance
			while current and current ~= workspace do
				if current.Name == "FlightBarrier"
					or current.Name == "FlightBarriers"
					or current:GetAttribute("FlightBarrier") == true
					or current:HasTag("FlightBarrier")
				then
					return true
				end
				current = current.Parent
			end
			return false
		end

		local function ignoreInCasts(params, instance)
			local filter = params.FilterDescendantsInstances
			table.insert(filter, instance)
			params.FilterDescendantsInstances = filter
		end

		local function castTerrain(startPoint, endPoint, radius, late)
			local params = planner.RayParams
			local offset = endPoint - startPoint
			local length = offset.Magnitude
			if length < 0.001 then
				return nil
			end
			local direction = offset / length
			local travelled = 0
			for _ = 1, 4 do
				local sphereHit = workspace:Spherecast(startPoint + direction * travelled, radius, direction * (length - travelled), params)
				if not sphereHit then
					return nil
				end
				if isFlightBarrier(sphereHit.Instance) then
					ignoreInCasts(params, sphereHit.Instance)
				elseif sphereHit.Normal.Y < 0.6 then
					return sphereHit.Position
				else
					local rayHit = workspace:Raycast(startPoint - Vector3.yAxis * tuning.GroundClearance, offset, params)
					if rayHit and not isFlightBarrier(rayHit.Instance) and not (late and rayHit.Normal.Y >= 0.7) then
						return rayHit.Position
					end
					travelled += sphereHit.Distance + 1.5
					if travelled >= length then
						return nil
					end
				end
			end
			return nil
		end

		local function findTerrainBlock(sim, course, best)
			local path = best.Candidate.Path
			local heights = best.Heights
			local startPoint = sim.Pos
			local limit = math.min(course.Count, tuning.VerifySamples * 2)
			for index = 2, limit, 2 do
				local endPoint = lanePoint(sim, course.Along[index], path[index], heights[index])
				local hitPosition = castTerrain(startPoint, endPoint, tuning.HardPad + 0.3, course.Late[index])
				if hitPosition then
					local relative = hitPosition - sim.Origin
					local along = relative:Dot(sim.Heading)
					local lateral = relative:Dot(sim.RightDirection)
					local extra = {
						AlongLow = along - 2,
						AlongHigh = along + 6,
						LateralLow = lateral - 2.5,
						LateralHigh = lateral + 2.5,
						HeightLow = -math.huge,
						HeightHigh = math.huge,
						HardPad = tuning.HardPad,
						SoftPad = tuning.SoftPad,
						Until = os.clock() + tuning.BlockMemory,
					}
					table.insert(planner.Extras, extra)
					return extra
				end
				startPoint = endPoint
			end
			return nil
		end

		local function planFlight(record)
			local sim = record.Sim
			if planner.Record ~= record then
				resetPlanner(record)
			end
			planner.PlanCount += 1
			local now = os.clock()
			local course = buildCourse(sim)
			if course.Count < 2 then
				planner.Target = nil
				planner.LastBestHit = false
				planner.LastHadThreat = false
				return
			end
			local targets = collectTargets(sim, record, course)
			local blocks = collectBlocks(sim, course)
			local hasNearbyBlocks = next(blocks) ~= nil

			local verticalCandidates = table.clone(tuning.VerticalOptions)
			local addedRingHeights = 0
			for _, target in ipairs(targets) do
				if target.Kind == "Item" and addedRingHeights < 2 then
					local idx = target.Index
					local baseY = course.BaseY[idx]
					local bandLow = course.BandLow[idx]
					local bandHigh = course.BandHigh[idx]
					if baseY and bandLow and bandHigh then
						local desiredOffset = math.clamp(target.Height - baseY, bandLow, bandHigh)
						local duplicate = false
						for _, existing in ipairs(verticalCandidates) do
							if math.abs(existing - desiredOffset) < 1.2 then
								duplicate = true
								break
							end
						end
						if not duplicate then
							table.insert(verticalCandidates, desiredOffset)
							addedRingHeights += 1
						end
					end
				end
			end

			local heightPaths = {}
			for _, option in ipairs(verticalCandidates) do
				table.insert(heightPaths, {Target = option, Heights = simulateHeights(sim, course, option)})
			end

			-- Kiểm tra nhanh đường bay thẳng hiện tại: nếu hoàn toàn an toàn và không có mục tiêu cần rẽ, trả về điều khiển bình thường
			local straightPath = simulateLateral(sim, course, sim.LateralOffset or 0)
			local straightHit, straightSoft = checkPath(sim, course, blocks, straightPath, heightPaths[1].Heights)
			local hasThreat = straightHit ~= nil or straightSoft > 0

			if not hasThreat then
				planner.ClearSince = planner.ClearSince or now
			else
				planner.ClearSince = nil
			end

			if not hasThreat and #targets == 0 then
				local terrainExtra = findTerrainBlock(sim, course, {
					Candidate = {Path = straightPath},
					Heights = heightPaths[1].Heights,
				})
				if not terrainExtra then
					planner.LastBestHit = false
					planner.LastHadThreat = false
					if now - (planner.ClearSince or now) >= tuning.ReturnAfterClear then
						planner.Target = nil
						planner.Dir = 0
					end
					return
				end
				insertBlock(course, blocks, terrainExtra)
				hasThreat = true
				planner.ClearSince = nil
			end

			local urgent = straightHit ~= nil and straightHit <= 3
			local returnPull = (planner.ClearSince and (now - planner.ClearSince) >= tuning.ReturnAfterClear) and tuning.HomePull or 0
			local reversePenaltyDir = (not urgent and (now - planner.DirAt) < tuning.LaneChangeCooldown) and -(planner.Dir or 0) or 0

			local candidates = buildCandidates(sim, course, targets)
			local best = choosePlan(sim, course, blocks, targets, candidates, heightPaths, returnPull, reversePenaltyDir)
			for _ = 1, 2 do
				if not best or best.Hit then
					break
				end
				local extra = findTerrainBlock(sim, course, best)
				if not extra then
					break
				end
				insertBlock(course, blocks, extra)
				best = choosePlan(sim, course, blocks, targets, candidates, heightPaths, returnPull, reversePenaltyDir)
			end
			if not best then
				planner.Target = nil
				planner.LastBestHit = true
				planner.LastHadThreat = hasThreat or hasNearbyBlocks
				return
			end
			planner.LastBestHit = best.Hit ~= nil
			planner.LastHadThreat = hasThreat or (best.SoftCost or 0) > 0
			local candidate = best.Candidate
			local chosenDiff = candidate.First - (sim.LateralOffset or 0)
			local chosenDir = if math.abs(chosenDiff) > tuning.LateralDeadband then (if chosenDiff > 0 then 1 else -1) else 0
			if chosenDir ~= 0 and chosenDir ~= planner.Dir then
				planner.Dir = chosenDir
				planner.DirAt = now
			end
			planner.Target = {
				First = candidate.First,
				Second = candidate.Second,
				SwitchAt = if candidate.Switch then now + candidate.Switch * course.StepTime else nil,
				Vertical = best.Vertical,
			}
		end

		local function applyTarget(sim)
			local target = planner.Target
			if not target then
				flightSys.ReleaseAssist()
				return
			end
			local lateral = lateralCommand(activeLateralTarget(target), sim.LateralOffset or 0, sim.LateralVelocity or 0)
			local vertical = verticalCommand(target.Vertical, sim.ManualHeightOffset or 0, sim.ManualHeightVelocity or 0)
			if lateral == 0 and vertical == 0 and not planner.LastHadThreat then
				flightSys.ReleaseAssist()
				return
			end
			if gameApi.SetAssist then
				gameApi.SetAssist(lateral, vertical)
				planner.AssistActive = true
			end
		end

		local lastNitroTrigger = 0
		local probedFlightId = nil
		local nitroState = {
			FlightId = nil,
			State = nil,
			Charge = 0,
			Star = 0,
			Duration = nil,
			Regen = false,
			RegenRate = 5,
			ServerTime = 0,
			Active = nil,
			UpdatedAt = 0,
		}

		function flightSys.FireGuiButton(btn)
			if not btn then return end
			if type(getconnections) == "function" then
				local center = Vector3.zero
				if btn:IsA("GuiObject") then
					local pos = btn.AbsolutePosition
					local sz = btn.AbsoluteSize
					center = Vector3.new(pos.X + sz.X * 0.5, pos.Y + sz.Y * 0.5, 0)
				end
				local fakeTouch = {
					UserInputType = Enum.UserInputType.Touch,
					UserInputState = Enum.UserInputState.Begin,
					Position = center,
