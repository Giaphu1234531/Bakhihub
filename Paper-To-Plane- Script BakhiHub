		local ui = pg:FindFirstChild("TrainingUI")
		if not ui then return end
		local powerPopups = ui:FindFirstChild("PowerPopups")
		if not powerPopups then return end
		
		local trainingBonus = ui:FindFirstChild("TrainingBonus")
		if trainingBonus then
			local x2Btn = trainingBonus:FindFirstChild("X2Button")
			if x2Btn and x2Btn:IsA("Frame") and x2Btn.Visible then
				local face = x2Btn:FindFirstChild("Face")
				if face and face:IsA("TextButton") and face.Active then
					for _, conn in pairs(getconnections(face.Activated)) do
						conn.Function()
					end
				end
			end
		end
	end)
end

