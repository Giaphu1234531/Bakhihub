local function rebuildMapCatalog(worldConfig)
	table.clear(mapCatalog.Order)
	table.clear(mapCatalog.NameToId)
	for id, fallbackName in pairs(DEFAULT_MAP_NAMES) do
		mapCatalog.NamesById[id] = fallbackName
	end

	local worldIds = {}
	local seenIds = {}
	if worldConfig and type(worldConfig.Worlds) == "table" then
		for _, w in pairs(worldConfig.Worlds) do
			local wid = tonumber(type(w) == "table" and w.WorldId)
			if wid and not seenIds[wid] then
				seenIds[wid] = true
				table.insert(worldIds, wid)
				local info = type(worldConfig.Get) == "function" and pcall(worldConfig.Get, wid)
				local dispName = nil
				if type(worldConfig.Get) == "function" then
					local okGet, wData = pcall(worldConfig.Get, wid)
					if okGet and type(wData) == "table" then
						dispName = wData.DisplayName or wData.Name
					end
				end
				mapCatalog.NamesById[wid] = tostring(dispName or w.DisplayName or w.Name or DEFAULT_MAP_NAMES[wid] or ("World " .. wid))
			end
		end
	end

	if #worldIds == 0 then
		worldIds = {1, 2, 3, 4, 5}
	else
		table.sort(worldIds)
	end

	for _, wid in ipairs(worldIds) do
		table.insert(mapCatalog.Order, wid)
		local name = mapCatalog.NamesById[wid] or DEFAULT_MAP_NAMES[wid] or ("World " .. wid)
		mapCatalog.NameToId[name] = wid
