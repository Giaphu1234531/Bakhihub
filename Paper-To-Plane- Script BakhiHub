		local function getEffectiveNitroCharge()
			local nCfg = gameApi.NitroConfig
			local maxCharge = (nCfg and tonumber(nCfg.MaxCharge)) or 200
			local charge = tonumber(nitroState.Charge) or 0
			if nitroState.Regen and nitroState.State ~= "ACTIVE" and nitroState.ServerTime > 0 then
				local syncWin = ((nCfg and tonumber(nCfg.RegenSyncInterval)) or 1) * 2
				local elapsed = math.clamp(workspace:GetServerTimeNow() - nitroState.ServerTime, 0, syncWin)
				charge = math.min(maxCharge, charge + (nitroState.RegenRate or 5) * elapsed)
			end
			return charge
		end

		local function canTriggerRealNitro(currentFlightId)
			if not currentFlightId then
				return false
			end
			local nCfg = gameApi.NitroConfig
			local uiState = (gameApi.NitroUIController and type(gameApi.NitroUIController.State) == "function" and gameApi.NitroUIController.State()) or nil
			local pg = localPlayer:FindFirstChild("PlayerGui")
			local nitroHud = pg and pg:FindFirstChild("NitroHUD")
			local hudState = nitroHud and nitroHud:GetAttribute("NitroState")
			local srvState = (nitroState.FlightId == currentFlightId) and nitroState.State or nil

			if srvState == "ACTIVE" or uiState == "ACTIVE" or hudState == "ACTIVE" then
				return false
			end
			if srvState == "UNAVAILABLE" or uiState == "UNAVAILABLE" or hudState == "UNAVAILABLE" then
				return false
			end
			if srvState == "READY" or uiState == "READY" or hudState == "READY" then
				return true
			end

			if nitroState.FlightId == currentFlightId then
				local liveCharge = getEffectiveNitroCharge()
				if nCfg and type(nCfg.CanActivate) == "function" then
					return nCfg.CanActivate(liveCharge) == true
				end
				return liveCharge >= ((nCfg and tonumber(nCfg.ActivationCost)) or 100)
			end

			-- Nếu client vừa vào trận giữa chừng và chưa nhận gói PlaneNitro cho FlightId này, cho phép gửi 1 yêu cầu kiểm tra duy nhất
			if probedFlightId ~= currentFlightId then
				probedFlightId = currentFlightId
				return true
			end

			return false
		end

		local function tryActivateNitro(record)
			local sim = record and record.Sim
			if not state.isAutoThrowOn or not sim then
				return
			end
			if not isOwnFlightActive() or isGamePaused() then
				return
			end
			if sim.Landed or sim.Sliding or sim.Impact or sim.Crashed then
				return
			end
			if (type(sim.NitroActive) == "function" and sim:NitroActive()) or (sim.NitroK or 0) > 0.05 then
				return
			end

			local currentFlightId = (record and record.Id) or flight.Id
			if not currentFlightId or not canTriggerRealNitro(currentFlightId) then
				return
			end

			local minGap = math.max((gameApi.NitroConfig and tonumber(gameApi.NitroConfig.RequestGap)) or 0.25, 0.4)
			local now = os.clock()
			if now - lastNitroTrigger < minGap then
				return
			end
			lastNitroTrigger = now

			-- Bảo đảm mô phỏng vật lý nhận gói Nitro từ server trên mọi World/Map
			if sim.World1 ~= true then
				sim.World1 = true
			end

			local fired = false
			if type(gameApi.NitroController) == "table" and type(gameApi.NitroController.Request) == "function" then
				local okReq = pcall(gameApi.NitroController.Request, "auto")
				if okReq then
					fired = true
				end
			end

			if not fired then
				for _, entry in ipairs(gameApi.NitroHandlers) do
					if entry.params == 0 then
						if pcall(entry.fn) then
							fired = true
							break
						end
					elseif entry.params == 1 then
						if pcall(entry.fn, "auto") then
							fired = true
							break
						end
					end
				end
			end

			-- Gửi trực tiếp qua Remote gốc của game nếu NitroController chưa đồng bộ state trên map hiện tại
			local uiStateNow = (gameApi.NitroUIController and type(gameApi.NitroUIController.State) == "function" and gameApi.NitroUIController.State()) or nil
			if gameApi.PlaneNitro and (not fired or uiStateNow ~= "READY") then
				pcall(gameApi.PlaneNitro.FireServer, gameApi.PlaneNitro, currentFlightId)
			end
		end

		-- ================= TỰ ĐỘNG KÍCH HOẠT KỸ NĂNG MÁY BAY (PLANE SKILLS) =================
		local planeSkillState = {
			Enabled = false,
			Flying = false,
			FlightId = nil,
			PlaneId = nil,
			Slots = {},
			ActiveSlot = nil,
			ActiveSkillId = nil,
			ActiveUntil = 0,
			PendingSlot = nil,
			PendingUntil = 0,
			LastRequestAt = 0,
			LastSyncAt = 0,
		}

		local function syncPlaneSkillSlotsFromTable(rawState)
			if type(rawState) ~= "table" then
				return
			end
			local now = os.clock()
			planeSkillState.Enabled = rawState.Enabled == true
			planeSkillState.Flying = rawState.Flying == true
			if rawState.FlightId ~= nil then
				planeSkillState.FlightId = rawState.FlightId
			end
			if rawState.PlaneId ~= nil then
				planeSkillState.PlaneId = rawState.PlaneId
			end

			local anyActiveSlot = nil
			local anyActiveSkill = nil
			if type(rawState.Slots) == "table" then
				for slotIdx = 1, 3 do
					local rawSlot = rawState.Slots[slotIdx] or rawState.Slots[tostring(slotIdx)]
					if type(rawSlot) == "table" then
						local prev = planeSkillState.Slots[slotIdx] or {}
						local skillId = type(rawSlot.SkillId) == "string" and rawSlot.SkillId or nil
						local cdLeft = tonumber(rawSlot.CooldownLeft) or 0
						local cdTotal = tonumber(rawSlot.CooldownSeconds)
							or (skillId and gameApi.PlaneSkillCatalog and type(gameApi.PlaneSkillCatalog.CooldownSeconds) == "function" and gameApi.PlaneSkillCatalog.CooldownSeconds(skillId))
							or 0
						local maxUses = tonumber(rawSlot.MaxUses)
							or (skillId and gameApi.PlaneSkillCatalog and type(gameApi.PlaneSkillCatalog.MaxUsesPerFlight) == "function" and gameApi.PlaneSkillCatalog.MaxUsesPerFlight(skillId))
							or 1
						local usesLeft = tonumber(rawSlot.UsesLeft)
						if usesLeft == nil then
							usesLeft = maxUses
						end
						local status = tostring(rawSlot.Status or "READY")
						if status == "ACTIVE" and skillId then
							anyActiveSlot = slotIdx
							anyActiveSkill = skillId
						end
						planeSkillState.Slots[slotIdx] = {
							Unlocked = rawSlot.Unlocked == true,
							SkillId = skillId,
							Status = status,
							CooldownLeft = cdLeft,
							CooldownSeconds = cdTotal,
							CooldownUntil = cdLeft > 0 and (now + cdLeft) or 0,
							UsesLeft = usesLeft,
							MaxUses = maxUses,
							RejectUntil = prev.RejectUntil or 0,
						}
					else
						planeSkillState.Slots[slotIdx] = nil
					end
				end
			end

			if anyActiveSlot then
				planeSkillState.ActiveSlot = anyActiveSlot
				planeSkillState.ActiveSkillId = anyActiveSkill
			elseif planeSkillState.ActiveUntil <= now then
				planeSkillState.ActiveSlot = nil
				planeSkillState.ActiveSkillId = nil
			end
		end

		function flightSys.OnPlaneSkillEvent(kind, data)
			if type(kind) ~= "string" then
				return
			end
			local payload = type(data) == "table" and data or {}
			local now = os.clock()

			if kind == "State" then
				syncPlaneSkillSlotsFromTable(payload)
			elseif kind == "Activated" then
				local slotIdx = tonumber(payload.Slot)
				local skillId = type(payload.SkillId) == "string" and payload.SkillId or nil
				local dur = tonumber(payload.Duration) or 1
				if payload.FlightId ~= nil then
					planeSkillState.FlightId = payload.FlightId
				end
				planeSkillState.Flying = true
				planeSkillState.ActiveSlot = slotIdx
				planeSkillState.ActiveSkillId = skillId
				planeSkillState.ActiveUntil = now + dur + 0.12
				planeSkillState.PendingSlot = nil
				planeSkillState.PendingUntil = 0
				if slotIdx and planeSkillState.Slots[slotIdx] then
					local s = planeSkillState.Slots[slotIdx]
					s.Status = "ACTIVE"
					if s.UsesLeft > 0 then
						s.UsesLeft = math.max(0, s.UsesLeft - 1)
					end
				end
			elseif kind == "Ended" then
				local slotIdx = tonumber(payload.Slot)
				local skillId = type(payload.SkillId) == "string" and payload.SkillId or planeSkillState.ActiveSkillId
				if slotIdx == nil or planeSkillState.ActiveSlot == slotIdx then
					planeSkillState.ActiveSlot = nil
					planeSkillState.ActiveSkillId = nil
					planeSkillState.ActiveUntil = 0
				end
				planeSkillState.PendingSlot = nil
				planeSkillState.PendingUntil = 0
				if slotIdx and planeSkillState.Slots[slotIdx] then
					local s = planeSkillState.Slots[slotIdx]
					local cdSec = s.CooldownSeconds
					if (not cdSec or cdSec <= 0) and skillId and gameApi.PlaneSkillCatalog and type(gameApi.PlaneSkillCatalog.CooldownSeconds) == "function" then
						cdSec = gameApi.PlaneSkillCatalog.CooldownSeconds(skillId)
					end
					s.CooldownUntil = now + math.max(0.5, tonumber(cdSec) or 1)
					s.Status = s.UsesLeft <= 0 and "EXHAUSTED" or "COOLDOWN"
				end
			elseif kind == "Rejected" then
				local slotIdx = tonumber(payload.Slot)
				local reason = tostring(payload.Reason or "")
				if planeSkillState.PendingSlot == slotIdx then
					planeSkillState.PendingSlot = nil
					planeSkillState.PendingUntil = 0
				end
				if slotIdx and planeSkillState.Slots[slotIdx] then
					local s = planeSkillState.Slots[slotIdx]
					local backoff = 2.5
					if reason == "LANDING_APPROACH" or reason == "LANDING" or reason == "USED_UP" or reason == "SLOT_LOCKED" or reason == "UNSUPPORTED_FLIGHT" then
						backoff = 8.0
					elseif reason == "BREAKTHROUGH" or reason == "CINEMATIC" or reason == "HANDOFF_PENDING" then
						backoff = 3.5
					elseif reason == "COOLDOWN" then
						backoff = math.max(1.5, (s.CooldownUntil - now))
					end
					s.RejectUntil = now + backoff
				end
			end
		end

		local function scanAheadObstaclesForSkill(sim, worldId)
			local info = {
				nearestAnyDist = math.huge,
				nearestSolidDist = math.huge,
				nearestAlignedDestructibleDist = math.huge,
				shockwaveTargets = 0,
				destructibleIn200 = 0,
				plannerDanger = planner.LastBestHit == true,
			}
			local hazards = gameApi.HazardSystem and gameApi.HazardSystem.ByWorld and gameApi.HazardSystem.ByWorld[worldId]
			if type(hazards) ~= "table" then
				return info
			end

			local origin = sim.Origin
			local heading = sim.Heading
			local right = sim.RightDirection
			local curAlong = sim.Along or 0
			local curLat = sim.LateralOffset or 0
			local curY = sim.Pos.Y
			local startX = origin.X + heading.X * curAlong
			local endX = origin.X + heading.X * (curAlong + 225)
			local lowX = math.min(startX, endX) - 16
			local highX = math.max(startX, endX) + 16
			local serverNow = workspace:GetServerTimeNow()
			local isBoosting = (sim.BoostK or 0) > 0.25 or (sim.NitroK or 0) > 0.25
			local dropTable = gameApi.HazardBoost and gameApi.HazardBoost.Drop

			for _, hazard in ipairs(hazards) do
				if hazard.MinX > highX then
					break
				end
				if hazard.MaxX >= lowX and hazard.Collide ~= false then
					if isBoosting and dropTable and hazard.Id and dropTable[hazard.Id] then
						continue
					end
					local frame, halfSize = gameApi.HazardSystem.Box(hazard, serverNow)
					if frame and halfSize then
						local alongLow, alongHigh, lateralLow, lateralHigh, heightLow, heightHigh = laneBox(sim, frame, halfSize)
						local distAhead = alongLow - curAlong
						if alongHigh >= curAlong and distAhead <= 220 then
							local effDist = math.max(0, distAhead)
							local latGap = 0
							if curLat < lateralLow then
								latGap = lateralLow - curLat
							elseif curLat > lateralHigh then
								latGap = curLat - lateralHigh
							end
							local yGap = 0
							if curY < heightLow then
								yGap = heightLow - curY
							elseif curY > heightHigh then
								yGap = curY - heightHigh
							end

							local isGateOrLaser = hazard.Laser == true
								or hazard.Gate == true
								or hazard.Type == "Gate"
								or hazard.Type == "Laser"
								or (type(hazard.Name) == "string" and (hazard.Name:lower():find("gate") or hazard.Name:lower():find("laser")))
							local isDestructible = not isGateOrLaser and hazard.Protected ~= true and hazard.Breakable ~= false

							if latGap <= 24 and yGap <= 18 then
								if effDist < info.nearestAnyDist then
									info.nearestAnyDist = effDist
								end
								if not isGateOrLaser and effDist < info.nearestSolidDist then
									info.nearestSolidDist = effDist
								end
								if effDist <= 52 then
									info.shockwaveTargets += 1
								end
								if isDestructible and effDist <= 210 then
									info.destructibleIn200 += 1
								end
								if isDestructible and effDist >= 10 and effDist <= 155 and latGap <= 5.2 and yGap <= 5.2 then
									if effDist < info.nearestAlignedDestructibleDist then
										info.nearestAlignedDestructibleDist = effDist
									end
								end
							end
						end
					end
				end
			end

			return info
		end

		local function canBlinkSafely(sim, worldId, progress)
			if progress >= 0.78 or (sim.Along or 0) < 60 then
				return false
			end
			local adapter = gameApi.BlinkAdapter
			if type(adapter) ~= "table" or type(adapter.Plan) ~= "function" then
				return false
			end
			local blinkDist = tonumber(adapter.Distance) or 35
			local okPlan, h, _, fromPos, toPos = pcall(adapter.Plan, sim, blinkDist)
			if not okPlan or type(h) ~= "number" or h < 20 or typeof(toPos) ~= "Vector3" or typeof(fromPos) ~= "Vector3" then
				return false
			end

			local hazards = gameApi.HazardSystem and gameApi.HazardSystem.ByWorld and gameApi.HazardSystem.ByWorld[worldId]
			if type(hazards) == "table" then
				local serverNow = workspace:GetServerTimeNow()
				local minX = math.min(fromPos.X, toPos.X) - 18
				local maxX = math.max(fromPos.X, toPos.X) + 18
				for _, hazard in ipairs(hazards) do
					if hazard.MinX > maxX then
						break
					end
					if hazard.MaxX >= minX and hazard.Collide ~= false then
						local frame, halfSize = gameApi.HazardSystem.Box(hazard, serverNow)
						if frame and halfSize then
							local isProtectedOrGate = hazard.Laser == true
								or hazard.Gate == true
								or hazard.Protected == true
								or hazard.Type == "Gate"
								or hazard.Type == "Laser"
								or (type(hazard.Name) == "string" and (hazard.Name:lower():find("gate") or hazard.Name:lower():find("laser")))
							if isProtectedOrGate and gameApi.HazardSystem.SegmentBox(frame, halfSize, fromPos, toPos, 3.0) ~= nil then
								return false
							end
							if gameApi.HazardSystem.SegmentBox(frame, halfSize, toPos - Vector3.new(2, 0, 0), toPos + Vector3.new(2, 0, 0), 4.0) ~= nil then
								return false
							end
						end
					end
				end
			end

			return true
		end

		local function evaluateSkillPriority(skillId, sim, worldId, progress, speed, scan)
			if skillId == "Shockwave" then
				if progress < 0.85 and scan.shockwaveTargets >= 1 and scan.nearestAnyDist <= 52 then
					return 100
				end
			elseif skillId == "GhostMode" then
				local triggerDist = math.max(52, speed * 2.1)
				if progress < 0.85 and (scan.nearestSolidDist <= triggerDist or (scan.plannerDanger and scan.nearestSolidDist <= 130)) then
					return 95
				end
			elseif skillId == "BubbleShield" then
				local triggerDist = math.max(55, speed * 2.2)
				if progress < 0.88 and (scan.nearestAnyDist <= triggerDist or (scan.plannerDanger and scan.nearestAnyDist <= 140)) then
					return 90
				end
			elseif skillId == "PaperCannon" then
				if progress < 0.85 and scan.nearestAlignedDestructibleDist <= 155 then
					return 85
				end
			elseif skillId == "Blink" then
				if (scan.nearestAnyDist <= 34 or scan.nearestAnyDist > 85) and canBlinkSafely(sim, worldId, progress) then
					return 80
				end
			elseif skillId == "HeavenSplitter" then
				if progress < 0.78 and (sim.Along or 0) > 45 and scan.destructibleIn200 >= 1 then
					return 75
				end
			elseif skillId == "DimensionalHighway" then
				if progress < 0.76 and (sim.Along or 0) > 40 and (scan.nearestSolidDist <= 180 or scan.plannerDanger) then
					return 70
				end
			elseif skillId == "PaperClones" then
				if progress < 0.80 and (sim.Along or 0) > 40 and scan.destructibleIn200 >= 1 then
					return 65
				end
			elseif skillId == "LimitBreak" then
				if progress < 0.68 and (sim.Along or 0) > 70 and (sim.BoostK or 0) <= 0.1 then
					return 60
				end
			elseif skillId == "WindBurst" then
				if progress < 0.74 and (sim.Along or 0) > 35 and (sim.BoostK or 0) <= 0.05 and (sim.NitroK or 0) <= 0.05 then
					return 55
				end
			end
			return 0
		end

		local function tryActivatePlaneSkill(record)
			local sim = record and record.Sim
			if not state.isAutoThrowOn or not sim then
				return
			end
			if not isOwnFlightActive() or isGamePaused() then
				return
			end
			if sim.Landed or sim.Sliding or sim.Impact or sim.Crashed or record.Cinematic then
				return
			end
			if localPlayer:GetAttribute("TreasurePuzzleOpen") == true then
				return
			end

			local now = os.clock()
			if now - planeSkillState.LastRequestAt < 0.6 then
				return
			end
			if planeSkillState.PendingSlot and now < planeSkillState.PendingUntil then
				return
			end
			if planeSkillState.ActiveSlot and now < planeSkillState.ActiveUntil then
				return
			end

			-- Đồng bộ trạng thái từ controller gốc nếu chưa nhận được gói State trực tiếp
			if not planeSkillState.Flying or next(planeSkillState.Slots) == nil then
				local liveState = nil
				if type(gameApi.PlaneSkillController) == "table" and type(gameApi.PlaneSkillController.GetState) == "function" then
					local okSt, st = pcall(gameApi.PlaneSkillController.GetState)
					if okSt and type(st) == "table" then
						liveState = st
					end
				end
				if not liveState and type(gameApi.PlaneSkillClientState) == "table" and type(gameApi.PlaneSkillClientState.State) == "table" then
					liveState = gameApi.PlaneSkillClientState.State
				end
				if liveState then
					syncPlaneSkillSlotsFromTable(liveState)
				elseif gameApi.PlaneSkill and gameApi.PlaneSkill:IsA("RemoteEvent") and now - planeSkillState.LastSyncAt > 3.0 then
					planeSkillState.LastSyncAt = now
					pcall(gameApi.PlaneSkill.FireServer, gameApi.PlaneSkill, "Sync")
					return
				end
			end

			if not planeSkillState.Enabled or not planeSkillState.Flying then
				return
			end
			local currentFlightId = (record and record.Id) or flight.Id
			if planeSkillState.FlightId and currentFlightId and planeSkillState.FlightId ~= currentFlightId then
				return
			end

			local profileAlong = (sim.World1 and sim.PathAlong) or sim.Along or 0
			local _, progress = sim:_profileY(profileAlong)
			progress = tonumber(progress) or 0
			if progress >= 0.88 then
				return
			end

			local worldId = planner.WorldId or 1
			local speed = math.max((sim.MotionSpeed or sim.Speed or 0) * tuning.TimeScale, 25)
			local scan = scanAheadObstaclesForSkill(sim, worldId)
			local catalogSkills = gameApi.PlaneSkillCatalog and gameApi.PlaneSkillCatalog.Skills

			local bestSlot = nil
			local bestPriority = 0

			for slotIdx = 1, 3 do
				local slotData = planeSkillState.Slots[slotIdx]
				if type(slotData) == "table" and slotData.Unlocked and type(slotData.SkillId) == "string" then
					local skillId = slotData.SkillId
					-- Chỉ kích hoạt các kỹ năng thực sự tồn tại trong PlaneSkillCatalog.Skills
					if type(catalogSkills) ~= "table" or catalogSkills[skillId] ~= nil then
						local isReady = (slotData.UsesLeft or 0) > 0
							and slotData.Status ~= "ACTIVE"
							and slotData.Status ~= "EXHAUSTED"
							and now >= (slotData.CooldownUntil or 0)
							and now >= (slotData.RejectUntil or 0)
						if isReady then
							local prio = evaluateSkillPriority(skillId, sim, worldId, progress, speed, scan)
							if prio > bestPriority then
								bestPriority = prio
								bestSlot = slotIdx
							end
						end
					end
				end
			end

			if not bestSlot then
				return
			end

			planeSkillState.LastRequestAt = now
			planeSkillState.PendingSlot = bestSlot
			planeSkillState.PendingUntil = now + 0.65

			local triggered = false
			if type(gameApi.PlaneSkillController) == "table" and type(gameApi.PlaneSkillController.Request) == "function" then
				local okReq = pcall(gameApi.PlaneSkillController.Request, bestSlot)
				if okReq then
					triggered = true
				end
			end
			if not triggered and gameApi.PlaneSkill and gameApi.PlaneSkill:IsA("RemoteEvent") then
				pcall(gameApi.PlaneSkill.FireServer, gameApi.PlaneSkill, "Activate", bestSlot)
			end
