	local function syncHeartbeatConnection()
		local needHeartbeat = state.isRunning and (state.isAutoThrowOn or state.leash.active)
		if needHeartbeat and not state.heartbeatConn then
			state.heartbeatConn = RunService.Heartbeat:Connect(function()
				if not state.isRunning then
					if state.heartbeatConn then
						pcall(state.heartbeatConn.Disconnect, state.heartbeatConn)
						state.heartbeatConn = nil
					end
					return
				end
				if state.isAutoThrowOn then
					pcall(flightSys.SteerStep)
				end
				if state.leash.active then
					pcall(paperSys.LeashHeartbeat)
				elseif not state.isAutoThrowOn and state.heartbeatConn then
					pcall(state.heartbeatConn.Disconnect, state.heartbeatConn)
					state.heartbeatConn = nil
				end
			end)
		elseif not needHeartbeat and state.heartbeatConn then
			pcall(state.heartbeatConn.Disconnect, state.heartbeatConn)
			state.heartbeatConn = nil
		end
	end

