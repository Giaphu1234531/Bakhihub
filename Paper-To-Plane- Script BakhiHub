		local function computeHazardReach(hazard)
			local motion = hazard.Motion
			local half = hazard.Half
			local reach = math.max(half.X, half.Z)
			if motion then
				if motion.Kind == "Sweep" then
					local pivotDist = hazard.PivotCenter and (hazard.PivotCenter - hazard.Center).Magnitude or 0
					reach = reach + motion.Sweep.Magnitude + (motion.Bob or 0) + pivotDist
				elseif motion.Kind == "Swing" then
					reach = reach + (motion.Pivot - hazard.Center).Magnitude + half.Magnitude
				elseif motion.Kind == "Grow" then
					reach = reach * ((motion.Max or 1.6) + 0.2)
				elseif motion.Kind == "Leap" then
					local piv = motion.Pivot or hazard.PivotCenter
					reach = reach + motion.Cross.Magnitude * 0.5 + half.Magnitude + (piv and (piv - hazard.Center).Magnitude or 0)
				elseif motion.Kind == "Spin" then
					local piv = motion.Pivot or hazard.PivotCenter
					reach = reach + half.Magnitude + (piv and (piv - hazard.Center).Magnitude or 0)
				end
			end
			return reach + 2
		end

		local function ensureWorld6HazardsMerged()
			if w6WorldHazardsEnsured or not gameApi.HazardSystem then
				return
			end
			w6WorldHazardsEnsured = true
			local hsMod = gameApi.HazardSystem
			hsMod.ByWorld = hsMod.ByWorld or {}
			hsMod.ById = hsMod.ById or {}
			hsMod.RootOf = hsMod.RootOf or {}
			hsMod.RootMembers = hsMod.RootMembers or {}

			local existingW6 = hsMod.ByWorld[6]
			if type(existingW6) == "table" and #existingW6 >= 1000 then
				return
			end

			local sharedFolder = ReplicatedStorage:FindFirstChild("PaperPlaneShared")
			if not sharedFolder then
				return
			end

			local w6List = existingW6 or {}
			hsMod.ByWorld[6] = w6List
			local seenIds = {}
			for _, h in ipairs(w6List) do
				if h and h.Id then
					seenIds[h.Id] = true
				end
			end

			local moduleNames = {"HazardConfigWorld6", "HazardConfigWorld6Static", "HazardConfigWorld6SetPieces"}
			local idxSetPiece = 2
			while sharedFolder:FindFirstChild("HazardConfigWorld6SetPieces" .. tostring(idxSetPiece)) do
				table.insert(moduleNames, "HazardConfigWorld6SetPieces" .. tostring(idxSetPiece))
				idxSetPiece += 1
			end

			for _, modName in ipairs(moduleNames) do
				local modData = requireModule(sharedFolder, modName)
				if type(modData) == "table" and type(modData.Hazards) == "table" then
					for _, h in ipairs(modData.Hazards) do
						if type(h) == "table" and h.World == 6 and typeof(h.Center) == "Vector3" and typeof(h.Half) == "Vector3" then
							if h.Id and not seenIds[h.Id] then
								seenIds[h.Id] = true
								local r = computeHazardReach(h)
								h.MinX = h.Center.X - r
								h.MaxX = h.Center.X + r
								hsMod.ById[h.Id] = h
								table.insert(w6List, h)
								if type(hsMod.Hazards) == "table" then
									table.insert(hsMod.Hazards, h)
								end
								local rootId = tostring(h.Id):gsub("_F%d+$", "")
								hsMod.RootOf[h.Id] = rootId
								hsMod.RootMembers[rootId] = hsMod.RootMembers[rootId] or {}
								table.insert(hsMod.RootMembers[rootId], h)
							end
						end
					end
				end
			end

			table.sort(w6List, function(a, b)
				return (a.MinX or 0) < (b.MinX or 0)
			end)
		end

		local function buildSeededWhirlpools(flightId, seed)
			local w6 = gameApi.World6Config
			if not w6 or type(w6.Whirl) ~= "table" or typeof(seed) ~= "number" then
				return
			end
			local list = w6EventBoxes[flightId]
			if not list then
				list = {}
				w6EventBoxes[flightId] = list
			end
			local rng = Random.new(seed)
			local whirlH = w6.Whirl.Height or 34
			local halfH = whirlH * 0.5
			for _, st in ipairs(w6.Whirl.Stages or {}) do
				for _ = 1, (w6.Whirl.PerStage or 2) do
					local wx = w6.StageStart(st) + rng:NextNumber(260, 1760)
					local wz = w6.ZC + rng:NextNumber(-(w6.Whirl.MaxZ or 26), (w6.Whirl.MaxZ or 26))
					local wr = (w6.Whirl.Radius or 16) * rng:NextNumber(0.85, 1.15)
					if math.abs(wx - (w6.Pour and w6.Pour.X or 4842)) > 90 then
						local effR = wr * 1.15
						table.insert(list, {
							T0 = 0,
							T1 = math.huge,
							CF = CFrame.new(wx, w6.FLOOR + halfH, wz),
							Half = Vector3.new(effR, halfH, effR),
						})
					end
				end
			end
		end

		function flightSys.OnWorld6Event(payload)
			if type(payload) ~= "table" then
				return
			end
			local fid = payload.FlightId
			if type(fid) ~= "string" then
				return
			end
			if payload.UserId ~= nil and payload.UserId ~= localPlayer.UserId then
				return
			end
			local w6 = gameApi.World6Config
			if not w6 then
				return
			end
			local evType = payload.Type
			if evType == "Init" then
				w6EventBoxes[fid] = {}
				if type(payload.Seed) == "number" then
					buildSeededWhirlpools(fid, payload.Seed)
				end
				return
			end

			local list = w6EventBoxes[fid]
			if not list then
				list = {}
				w6EventBoxes[fid] = list
			end

			if evType == "GlassPour" and typeof(payload.At) == "number" and w6.Pour then
				local half = w6.Pour.Half
				table.insert(list, {
					T0 = payload.At + 0.15,
					T1 = payload.At + (tonumber(payload.Duration) or w6.Pour.Duration or 6.5),
					CF = CFrame.new(w6.Pour.X, w6.FLOOR + half.Y, w6.Pour.Z),
					Half = half,
				})
			elseif evType == "SharkRam" and typeof(payload.X) == "number" and typeof(payload.At) == "number" and type(w6.RamBox) == "function" then
				local ramCF, ramHalf = w6.RamBox(payload.X, payload.Side or 1)
				table.insert(list, {
					T0 = payload.At + (w6.Ram and w6.Ram.LiveDelay or 0.15),
					T1 = payload.At + (tonumber(payload.Jet) or (w6.Ram and w6.Ram.Jet) or 3.2),
					CF = ramCF,
					Half = ramHalf,
				})
			elseif evType == "SharkLunge" and typeof(payload.S) == "Vector3" and typeof(payload.A) == "Vector3" and typeof(payload.T0) == "number" and typeof(payload.T) == "number" then
				local over = tonumber(payload.Over) or (w6.Chase and w6.Chase.Overshoot) or 1.25
				table.insert(list, {
					Lunge = true,
					T0 = payload.T0,
					T = payload.T,
					S = payload.S,
					A = payload.A,
					Half = (w6.Chase and w6.Chase.Half) or Vector3.new(1.8, 2, 5.5),
					T1 = payload.T0 + payload.T * over,
				})
			elseif evType == "BossRock" and typeof(payload.S) == "Vector3" and typeof(payload.A) == "Vector3" and typeof(payload.T0) == "number" and typeof(payload.T) == "number" then
				local rad = tonumber(payload.Radius) or (w6.Boss and w6.Boss.RockHalf) or 3.3
				table.insert(list, {
					Rock = true,
					T0 = payload.T0,
					T = payload.T,
					S = payload.S,
					A = payload.A,
					Arc = tonumber(payload.Arc) or (w6.Boss and w6.Boss.RockArc) or 10,
					Half = Vector3.new(rad, rad, rad),
					T1 = payload.T0 + payload.T * 1.35,
				})
			elseif evType == "BossInk" and w6.Boss and type(w6.Boss.Ink) == "table" then
				local life = tonumber(payload.Life) or w6.Boss.Ink.Life or 7
				local t0 = tonumber(payload.At) or workspace:GetServerTimeNow()
				local clouds = payload.Clouds or payload.Spots
				if type(clouds) == "table" then
					for _, cl in ipairs(clouds) do
						local pos = typeof(cl) == "Vector3" and cl or (type(cl) == "table" and (cl.Pos or cl.Position))
						local r = (type(cl) == "table" and tonumber(cl.R)) or 11.5
						if typeof(pos) == "Vector3" then
							table.insert(list, {
								T0 = t0,
								T1 = t0 + life,
								CF = CFrame.new(pos),
								Half = Vector3.new(r, r, r),
							})
						end
					end
				end
			end
		end

		local function evalWorld6EventBoxCF(box, atTime)
			local w6 = gameApi.World6Config
			if box.Rock and w6 and type(w6.RockPos) == "function" then
				local pos = w6.RockPos(box, atTime)
				return CFrame.new(pos)
			end
			if box.Lunge and w6 and type(w6.LungePos) == "function" then
				local pos = w6.LungePos(box, atTime)
				local delta = box.A - box.S
				return if delta.Magnitude > 0.1 then CFrame.lookAt(pos, pos + delta) else CFrame.new(pos)
			end
			return box.CF
		end

