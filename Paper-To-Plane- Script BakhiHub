			return isOwnFlightActive()
		end

		function flightSys.RunThrowStep()
			if not state.isAutoThrowOn then
				return 0.3
			end
			pcall(processInFlightMinigames)
			local throwSucceeded, result = pcall(throwOnce)
			return if throwSucceeded then result else 1.2
		end
		return flightSys
	end)()

