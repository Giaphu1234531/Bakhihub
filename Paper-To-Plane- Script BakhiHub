local function getHWID()
	local ok, id = pcall(function()
		if type(gethwid) == "function" then
			return gethwid()
		elseif type(get_hwid) == "function" then
			return get_hwid()
		end
		return RbxAnalyticsService:GetClientId()
	end)
	if ok and id and tostring(id) ~= "" then
		return tostring(id)
	end
	return "ROBLOX-" .. tostring(LocalPlayer and LocalPlayer.UserId or 0)
end

local function sendHttpRequest(options)
	local req = (syn and syn.request)
		or (http and http.request)
		or http_request
		or (fluxus and fluxus.request)
		or request
	if type(req) == "function" then
		return req(options)
	end
	return nil
end

local function copyText(text)
	local clip = setclipboard or toclipboard or (syn and syn.write_clipboard)
	if type(clip) == "function" then
		pcall(clip, tostring(text))
		return true
	end
	return false
end

local function readClipboardText()
	local getter = getclipboard or (syn and syn.read_clipboard)
	if type(getter) == "function" then
		local ok, val = pcall(getter)
		if ok and type(val) == "string" then
			return val:match("^%s*(.-)%s*$")
		end
	end
	return ""
end

local KEY_FOLDER = "BaKhi/Keys"
local KEY_FILE = KEY_FOLDER .. "/" .. GameId .. ".txt"

local function saveKeyToDisk(keyStr)
	pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" then
			if not isfolder("BaKhi") then makefolder("BaKhi") end
			if not isfolder(KEY_FOLDER) then makefolder(KEY_FOLDER) end
		end
		if type(writefile) == "function" then
			writefile(KEY_FILE, tostring(keyStr))
		end
	end)
end

local function readSavedKey()
	local ok, content = pcall(function()
		if type(isfile) == "function" and type(readfile) == "function" and isfile(KEY_FILE) then
			return readfile(KEY_FILE)
		end
		return nil
	end)
	if ok and type(content) == "string" then
		local trimmed = content:match("^%s*(.-)%s*$")
		if trimmed ~= "" then
			return trimmed
		end
	end
	local envKey = (getgenv and getgenv().BakhiKey) or _G.BakhiKey
	if type(envKey) == "string" and envKey:match("%S") then
		return envKey:match("^%s*(.-)%s*$")
	end
	local clip = readClipboardText()
	if clip ~= "" and (clip:upper():find("BAKHI", 1, true) or (#clip >= 8 and not clip:find("%s"))) then
		return clip
	end
	return ""
end

local function validateKey(rawKey)
	local cleanKey = tostring(rawKey or ""):match("^%s*(.-)%s*$")
	if cleanKey == "" then
		return false, "Please enter a key first!"
	end

	local payload = HttpService:JSONEncode({
		gameId = GameId,
		placeId = tostring(PlaceId),
		key = cleanKey,
		hwid = getHWID(),
	})

	local ok, response = pcall(sendHttpRequest, {
		Url = API .. "/api/validate",
		Method = "POST",
		Headers = {
			["Content-Type"] = "application/json",
		},
		Body = payload,
	})

	if not ok or type(response) ~= "table" then
		return false, "Connection failed! Check your executor HTTP."
	end

	local bodyText = tostring(response.Body or "")
	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(bodyText)
	end)

	if decodeOk and type(data) == "table" then
		if data.valid == true or data.ok == true or data.success == true then
			return true, tostring(data.message or data.msg or "Key verified!"), cleanKey
		end
		return false, tostring(data.message or data.msg or data.error or "Invalid or expired key!")
	end

	local statusCode = tonumber(response.StatusCode) or 0
	if statusCode >= 200 and statusCode < 300 and bodyText:lower():find("valid") then
		return true, "Key verified!", cleanKey
	end

	return false, "Server error (" .. tostring(statusCode) .. ")"
end

