		function trainSys.CheckAutoRebirth()
			if not state.isAutoRebirthOn or not gameApi.RebirthRemote then
				return
			end
			if os.clock() - lastRebirthAttempt <= 3 then
				return
			end
			local canRebirth = localPlayer:GetAttribute("CanRebirth")
			local capped = localPlayer:GetAttribute("RebirthCapped")
			local lvl = localPlayer:GetAttribute("Level") or 0
			local maxLvl = localPlayer:GetAttribute("MaxLevel") or 1

			if canRebirth and not capped and lvl >= maxLvl then
				lastRebirthAttempt = os.clock()
				pcall(function()
					if gameApi.RebirthRemote:IsA("RemoteFunction") then
						gameApi.RebirthRemote:InvokeServer()
					elseif gameApi.RebirthRemote:IsA("RemoteEvent") then
						gameApi.RebirthRemote:FireServer()
					end
				end)
			end
		end

			local function getPlayerProgression()
				local rebirths = tonumber(localPlayer:GetAttribute("Rebirths")) or 0
				local level = tonumber(localPlayer:GetAttribute("Level")) or 0
				local power = tonumber(localPlayer:GetAttribute("Power"))
					or tonumber(localPlayer:GetAttribute("TotalPower"))
					or tonumber(localPlayer:GetAttribute("TrainingPower"))
					or 0

				local ls = localPlayer:FindFirstChild("leaderstats")
				if ls then
					local rebObj = ls:FindFirstChild("Rebirths")
					if rebObj then
						rebirths = math.max(rebirths, tonumber(rebObj.Value) or 0)
					end
					local lvlObj = ls:FindFirstChild("Level")
					if lvlObj then
						level = math.max(level, tonumber(lvlObj.Value) or 0)
					end
					local powObj = ls:FindFirstChild("Power")
					if powObj then
						power = math.max(power, tonumber(powObj.Value) or 0)
					end
				end

				local profile = gameApi.BackendClient and gameApi.BackendClient.Profile
				if type(profile) == "table" then
					rebirths = math.max(rebirths, tonumber(profile.Rebirths) or 0)
					level = math.max(level, tonumber(profile.Level) or 0)
					power = math.max(power, tonumber(profile.Power) or tonumber(profile.TrainingPower) or 0)
				end

				return rebirths, level, power
			end

			local function extractEffectiveness(zone)
				if type(zone) ~= "table" then
					return 0
				end
				return tonumber(
					zone.TrainingMultiplier
					or zone.PremiumMultiplier
					or zone.Multiplier
					or zone.PowerGain
					or zone.PowerPerSecond
					or zone.Gain
					or zone.Rate
					or zone.RewardMultiplier
				) or 0
			end

			local function extractTierLevel(zone, fallbackOrder)
				if type(zone) ~= "table" then
					return fallbackOrder or 0
				end
				local reqReb = tonumber(zone.RequiredRebirths or zone.MinRebirths or zone.Rebirths)
				if reqReb then
					return reqReb
				end
				local reqLvl = tonumber(zone.RequiredLevel or zone.MinLevel or zone.Level)
				if reqLvl then
					return reqLvl
				end
				local reqPow = tonumber(zone.RequiredPower or zone.MinPower or zone.Power)
				if reqPow then
					return reqPow
				end
				return tonumber(zone.Tier or zone.Order) or (fallbackOrder or 0)
			end

			local function collectAllTrainingZones()
				local list = {}
				local seen = {}

				local function pushZone(rawId, zone)
					if type(zone) ~= "table" then
						return
					end
					local zId = tonumber(zone.Id) or tonumber(zone.ZoneId) or tonumber(rawId)
					if not zId or seen[zId] then
						return
					end
					seen[zId] = true

					local zWorld = tonumber(zone.WorldId) or tonumber(zone.World)
					if not zWorld and type(zone.MapId) == "string" then
						zWorld = tonumber(zone.MapId:match("(%d+)"))
					end
					if not zWorld and type(zone.ModelPath) == "string" then
						zWorld = tonumber(zone.ModelPath:match("World%s*(%d+)"))
					end
					if not zWorld and type(zone.Path) == "string" then
						zWorld = tonumber(zone.Path:match("World%s*(%d+)"))
					end
					if not zWorld and typeof(zone.Position) == "Vector3" and gameApi.WorldConfig and type(gameApi.WorldConfig.AtPosition) == "function" then
						local w = gameApi.WorldConfig.AtPosition(zone.Position)
						zWorld = w and tonumber(w.WorldId)
					end
					if not zWorld and typeof(zone.CFrame) == "CFrame" and gameApi.WorldConfig and type(gameApi.WorldConfig.AtPosition) == "function" then
						local w = gameApi.WorldConfig.AtPosition(zone.CFrame.Position)
						zWorld = w and tonumber(w.WorldId)
					end
					zWorld = zWorld or 1

					table.insert(list, {
						Id = zId,
						WorldId = zWorld,
						Data = zone,
					})
				end

				if gameApi.TrainingConfig then
					if type(gameApi.TrainingConfig.Zones) == "table" then
						for id, zone in pairs(gameApi.TrainingConfig.Zones) do
							pushZone(id, zone)
						end
					end
					if type(gameApi.TrainingConfig.Get) == "function" then
						for probeId = 1, 60 do
							if not seen[probeId] then
								local okGet, zData = pcall(gameApi.TrainingConfig.Get, probeId)
								if okGet and type(zData) == "table" then
									pushZone(probeId, zData)
								end
							end
						end
					end
				end

				if type(gameApi.TrainingWorldZones) == "table" then
					for k, val in pairs(gameApi.TrainingWorldZones) do
						if k ~= "Rebirths" and type(val) == "table" then
							if val.Id or val.ZoneId or val.TrainingMultiplier or val.Multiplier then
								pushZone(k, val)
							else
								for subId, subZone in pairs(val) do
									if type(subZone) == "table" then
										if subZone.WorldId == nil and subZone.World == nil and tonumber(k) then
											local cloned = table.clone(subZone)
											cloned.WorldId = tonumber(k)
											pushZone(subId, cloned)
										else
											pushZone(subId, subZone)
										end
									end
								end
							end
						end
					end
				end

				table.sort(list, function(a, b)
					return a.Id < b.Id
				end)

				local perWorldCount = {}
				local worldRebirthsTable = type(gameApi.TrainingWorldZones) == "table" and gameApi.TrainingWorldZones.Rebirths
				for _, entry in ipairs(list) do
					local w = entry.WorldId
					perWorldCount[w] = (perWorldCount[w] or 0) + 1
					entry.LocalIndex = perWorldCount[w]

					-- Bổ sung mốc RequiredRebirths từ TrainingWorldZones.Rebirths[worldId] nếu zone chưa ghi rõ
					if entry.Data.RequiredRebirths == nil and entry.Data.MinRebirths == nil and not entry.Data.Premium then
						local gates = type(worldRebirthsTable) == "table" and worldRebirthsTable[w]
						if type(gates) == "table" and tonumber(gates[entry.LocalIndex]) then
							entry.InferredRequiredRebirths = tonumber(gates[entry.LocalIndex])
						end
					end

					entry.Effectiveness = extractEffectiveness(entry.Data)
					entry.TierLevel = extractTierLevel(entry.Data, entry.InferredRequiredRebirths or entry.LocalIndex)
				end

				return list
			end

			local function isZoneEligible(entry, playerRebirths, playerLevel, playerPower)
				local zone = entry.Data
				if zone.Disabled == true or zone.Enabled == false then
					return false
				end

				if zone.Premium or zone.PassKey or zone.VIP then
					local passKey = tostring(zone.PassKey or (zone.VIP and "VIP") or "")
					if passKey ~= "" and localPlayer:GetAttribute("Pass_" .. passKey) ~= true then
						return false
					end
				end

				local reqRebirths = tonumber(zone.RequiredRebirths or zone.MinRebirths or zone.Rebirths) or entry.InferredRequiredRebirths or 0
				local reqLevel = tonumber(zone.RequiredLevel or zone.MinLevel or zone.Level) or 0
				local reqPower = tonumber(zone.RequiredPower or zone.MinPower or zone.Power) or 0

				if playerRebirths < reqRebirths then
					return false
				end
				if reqLevel > 0 and playerLevel < reqLevel then
					return false
				end
				if reqPower > 0 and playerPower < reqPower then
					return false
				end

				if gameApi.TrainingConfig and type(gameApi.TrainingConfig.CanEnter) == "function" then
					local okCan, canEnter = pcall(gameApi.TrainingConfig.CanEnter, entry.Id, playerRebirths, playerPower, playerLevel)
					if okCan and type(canEnter) == "boolean" then
						return canEnter
					end
				end

				return true
			end

			local function getRankedTrainingZones(curWorld)
				local playerRebirths, playerLevel, playerPower = getPlayerProgression()
				local now = os.clock()
				local allZones = collectAllTrainingZones()

				local worldZones = {}
				for _, entry in ipairs(allZones) do
					if entry.WorldId == curWorld then
						table.insert(worldZones, entry)
					end
				end

				-- Nếu World hiện tại chưa có trong bảng config (map mở rộng), tìm quét trực tiếp trong Workspace["World <id>"]
				if #worldZones == 0 then
					local worldFolder = workspace:FindFirstChild("World " .. tostring(curWorld))
					if worldFolder then
						local idx = 0
						for _, desc in ipairs(worldFolder:GetDescendants()) do
							if (desc:IsA("Model") or desc:IsA("BasePart")) and (desc.Name:lower():find("training") or desc:GetAttribute("TrainingZone") ~= nil or desc:GetAttribute("ZoneId") ~= nil) then
								local zId = tonumber(desc:GetAttribute("ZoneId") or desc:GetAttribute("TrainingZone") or desc:GetAttribute("Id"))
								if zId then
									idx += 1
									table.insert(worldZones, {
										Id = zId,
										WorldId = curWorld,
										LocalIndex = idx,
										Data = {
											Model = desc,
											WorldId = curWorld,
											TrainingMultiplier = tonumber(desc:GetAttribute("TrainingMultiplier") or desc:GetAttribute("Multiplier")) or idx,
											RequiredRebirths = tonumber(desc:GetAttribute("RequiredRebirths")) or 0,
											RequiredLevel = tonumber(desc:GetAttribute("RequiredLevel")) or 0,
											RequiredPower = tonumber(desc:GetAttribute("RequiredPower")) or 0,
										},
										Effectiveness = tonumber(desc:GetAttribute("TrainingMultiplier") or desc:GetAttribute("Multiplier")) or idx,
										TierLevel = tonumber(desc:GetAttribute("RequiredRebirths") or desc:GetAttribute("RequiredLevel") or desc:GetAttribute("RequiredPower")) or idx,
									})
								end
							end
						end
					end
				end

				local eligibleAvailable = {}
				local eligibleBlacklisted = {}
				local fallbackAvailable = {}

				for _, entry in ipairs(worldZones) do
					local blockedUntil = unusableZoneUntil[entry.Id]
					local isBlocked = blockedUntil ~= nil and now < blockedUntil
					if isZoneEligible(entry, playerRebirths, playerLevel, playerPower) then
						if isBlocked then
							table.insert(eligibleBlacklisted, entry)
						else
							table.insert(eligibleAvailable, entry)
						end
					elseif not entry.Data.Premium and not isBlocked then
						table.insert(fallbackAvailable, entry)
					end
				end

				local function compareBest(a, b)
					if a.Effectiveness ~= b.Effectiveness then
						return a.Effectiveness > b.Effectiveness
					end
					if a.TierLevel ~= b.TierLevel then
						return a.TierLevel > b.TierLevel
					end
					return a.Id > b.Id
				end

				table.sort(eligibleAvailable, compareBest)
				table.sort(eligibleBlacklisted, compareBest)
				table.sort(fallbackAvailable, function(a, b)
					if a.TierLevel ~= b.TierLevel then
						return a.TierLevel < b.TierLevel
					end
					return a.Id < b.Id
				end)

				local ranked = {}
				for _, e in ipairs(eligibleAvailable) do
					table.insert(ranked, e)
				end
				for _, e in ipairs(fallbackAvailable) do
					table.insert(ranked, e)
				end
				for _, e in ipairs(eligibleBlacklisted) do
					table.insert(ranked, e)
				end

				return ranked
			end

			local function resolveTrainingPartCFrame(zoneModel, bestZoneId)
				if not zoneModel then
					return nil
				end
				if zoneModel:IsA("BasePart") then
					local pos = zoneModel.Position
					if zoneModel.Size.Y > 6 then
						pos = Vector3.new(pos.X, pos.Y - (zoneModel.Size.Y * 0.5) + 3, pos.Z)
					end
					return CFrame.new(pos) * zoneModel.CFrame.Rotation
				end

				local trainingPoint = zoneModel:FindFirstChild("TrainingPoint") or zoneModel:FindFirstChild("TrainingPoint", true)
				local _, humanoid, hrp = findAliveCharacter()
				if trainingPoint and trainingPoint:IsA("BasePart") and gameApi.TrainingFlightPath and type(gameApi.TrainingFlightPath.StandCFrame) == "function" then
					local okStand, standCF = pcall(gameApi.TrainingFlightPath.StandCFrame, bestZoneId, trainingPoint, humanoid, hrp)
					if okStand and typeof(standCF) == "CFrame" then
						return standCF
					end
				end

				local targetPart = trainingPoint
					or zoneModel:FindFirstChild("StandPoint")
					or zoneModel:FindFirstChild("Region")
					or zoneModel:FindFirstChild("Pad")
					or zoneModel:FindFirstChild("Trigger")
					or zoneModel:FindFirstChild("Hitbox")
					or zoneModel:FindFirstChild("StandPoint", true)
					or zoneModel:FindFirstChild("Region", true)
					or zoneModel:FindFirstChild("Pad", true)
					or zoneModel.PrimaryPart
					or zoneModel:FindFirstChildWhichIsA("BasePart", true)
				if targetPart and targetPart:IsA("BasePart") then
					local pos = targetPart.Position
					if targetPart.Size.Y > 6 then
						pos = Vector3.new(pos.X, pos.Y - (targetPart.Size.Y * 0.5) + 3, pos.Z)
					end
					return CFrame.new(pos) * targetPart.CFrame.Rotation
				end
				local okBox, boxCF = pcall(function()
					return zoneModel:GetBoundingBox()
				end)
				if okBox and typeof(boxCF) == "CFrame" then
					return boxCF
				end
				return nil
			end

			local function matchZoneInstanceInContainer(container, bestZoneId, bestZoneData, localIndex)
				if not container then
					return nil
				end

				local candidateNames = {
					"Zone" .. tostring(bestZoneId),
					"Zone_" .. tostring(bestZoneId),
					tostring(bestZoneId),
					"Training" .. tostring(bestZoneId),
					"TrainingZone" .. tostring(bestZoneId),
					"Training_" .. tostring(bestZoneId),
				}
				if localIndex then
					table.insert(candidateNames, "Zone" .. tostring(localIndex))
					table.insert(candidateNames, "Zone_" .. tostring(localIndex))
					table.insert(candidateNames, "Training" .. tostring(localIndex))
					table.insert(candidateNames, "TrainingZone" .. tostring(localIndex))
				end
				if type(bestZoneData) == "table" then
					if type(bestZoneData.Name) == "string" and bestZoneData.Name ~= "" then
						table.insert(candidateNames, bestZoneData.Name)
					end
					if type(bestZoneData.ModelName) == "string" and bestZoneData.ModelName ~= "" then
						table.insert(candidateNames, bestZoneData.ModelName)
					end
				end

				for _, name in ipairs(candidateNames) do
					local found = container:FindFirstChild(name)
					if found then
						return found
					end
				end

				for _, child in ipairs(container:GetChildren()) do
					local attrId = tonumber(child:GetAttribute("ZoneId"))
						or tonumber(child:GetAttribute("Id"))
						or tonumber(child:GetAttribute("TrainingZone"))
					if attrId == bestZoneId then
						return child
					end
				end

				return nil
			end

			local function getTrainingTargetCFrame(bestZoneId, bestZoneData, targetWorldId, localIndex)
				local worldId = targetWorldId or (bestZoneData and (tonumber(bestZoneData.WorldId) or tonumber(bestZoneData.World))) or 1

				if gameApi.TrainingConfig and type(gameApi.TrainingConfig.Model) == "function" then
					local okModel, zoneModel = pcall(gameApi.TrainingConfig.Model, bestZoneId)
					if okModel and zoneModel and zoneModel:IsDescendantOf(workspace) then
						local cf = resolveTrainingPartCFrame(zoneModel, bestZoneId)
						if cf then
							return cf
						end
					end
				end

				if type(bestZoneData) == "table" then
					if typeof(bestZoneData.Model) == "Instance" and bestZoneData.Model:IsDescendantOf(workspace) then
						local cf = resolveTrainingPartCFrame(bestZoneData.Model, bestZoneId)
						if cf then
							return cf
						end
					end
					for _, pathKey in ipairs({"ModelPath", "Path", "ZonePath"}) do
						if type(bestZoneData[pathKey]) == "string" then
							local inst = resolveInstancePath(bestZoneData[pathKey])
							local cf = resolveTrainingPartCFrame(inst, bestZoneId)
							if cf then
								return cf
							end
						end
					end
					if typeof(bestZoneData.CFrame) == "CFrame" then
						return bestZoneData.CFrame
					end
					if typeof(bestZoneData.Position) == "Vector3" then
						return CFrame.new(bestZoneData.Position)
					end
				end

				local worldFolder = workspace:FindFirstChild("World " .. tostring(worldId))
				if worldFolder then
					local gameplayFolder = worldFolder:FindFirstChild("Gameplay")
					local folderCandidates = {
						gameplayFolder and gameplayFolder:FindFirstChild("TrainingGrounds"),
						gameplayFolder and gameplayFolder:FindFirstChild("TrainingZones"),
						gameplayFolder and gameplayFolder:FindFirstChild("Training"),
						worldFolder:FindFirstChild("TrainingGrounds"),
						worldFolder:FindFirstChild("TrainingZones"),
						worldFolder:FindFirstChild("Training"),
					}
					for _, folder in ipairs(folderCandidates) do
						local matched = matchZoneInstanceInContainer(folder, bestZoneId, bestZoneData, localIndex)
						if matched then
							local cf = resolveTrainingPartCFrame(matched, bestZoneId)
							if cf then
								return cf
							end
						end
					end

					for _, desc in ipairs(worldFolder:GetDescendants()) do
						if desc:IsA("Model") or desc:IsA("BasePart") then
							local attrId = tonumber(desc:GetAttribute("ZoneId"))
								or tonumber(desc:GetAttribute("Id"))
								or tonumber(desc:GetAttribute("TrainingZone"))
							if attrId == bestZoneId then
								local cf = resolveTrainingPartCFrame(desc, bestZoneId)
								if cf then
									return cf
								end
							end
						end
					end
				end

				for _, tagName in ipairs({"TrainingZone", "TrainingPoint", "TrainingEquipment"}) do
					for _, tagged in ipairs(CollectionService:GetTagged(tagName)) do
						if tagged:IsDescendantOf(workspace) then
							local attrId = tonumber(tagged:GetAttribute("ZoneId"))
								or tonumber(tagged:GetAttribute("Id"))
								or tonumber(tagged:GetAttribute("TrainingZone"))
							local parentModel = tagged:IsA("Model") and tagged or tagged:FindFirstAncestorWhichIsA("Model")
							if not attrId and parentModel then
								attrId = tonumber(parentModel:GetAttribute("ZoneId"))
									or tonumber(parentModel:GetAttribute("Id"))
									or tonumber(parentModel:GetAttribute("TrainingZone"))
							end
							if attrId == bestZoneId then
								local cf = resolveTrainingPartCFrame(parentModel or tagged, bestZoneId)
								if cf then
									return cf
								end
							end
						end
					end
				end

				return nil
			end

			local function ensureTrainingTargetCFrame(character, hrp, bestZoneId, bestZoneData, targetWorldId, localIndex)
				local targetCF = getTrainingTargetCFrame(bestZoneId, bestZoneData, targetWorldId, localIndex)
				if targetCF then
					return targetCF
				end

				local worldId = targetWorldId or (bestZoneData and (tonumber(bestZoneData.WorldId) or tonumber(bestZoneData.World))) or 1
				local anchors = getWorldAnchorCandidates(worldId)
				for _, anchor in ipairs(anchors) do
					if not state.isRunning or not state.isAutoTrainOn then
						break
					end
					character, _, hrp = findAliveCharacter()
					if character and hrp then
						local distToAnchor = Vector3.new(hrp.Position.X - anchor.X, 0, hrp.Position.Z - anchor.Z).Magnitude
						if distToAnchor > 40 then
							safeTeleport(character, anchor + Vector3.new(0, 3, 0), anchor + Vector3.new(0, 3, 5), 12, false)
						else
							pcall(function()
								localPlayer:RequestStreamAroundAsync(anchor, 4)
							end)
						end
					end
					for _ = 1, 6 do
						targetCF = getTrainingTargetCFrame(bestZoneId, bestZoneData, worldId, localIndex)
						if targetCF then
							return targetCF
						end
						task.wait(0.15)
					end
				end
				return nil
			end

			local function isAtTargetEquipment(hrpPos, targetPos)
				local horizDist = Vector3.new(hrpPos.X - targetPos.X, 0, hrpPos.Z - targetPos.Z).Magnitude
				local vertDist = math.abs(hrpPos.Y - targetPos.Y)
				return horizDist <= 9 and vertDist <= 12
			end

			local function performRearPauseAndReturn(targetCFrame, zoneId)
				if isRearPauseRunning or not targetCFrame then
					return
				end
				isRearPauseRunning = true
				lastTrainActionTime = os.clock()

				local ok, err = pcall(function()
					local character, humanoid, hrp = findAliveCharacter()
					if not character or not humanoid or not hrp then
						return
					end

					local rearCFrame = hrp.CFrame * CFrame.new(0, 0, 8)
					hrp.Anchored = false
					hrp.AssemblyLinearVelocity = Vector3.zero
					character:PivotTo(rearCFrame)

					local elapsed = 0
					while state.isRunning and state.isAutoTrainOn and elapsed < 1.8 do
						local curChar, _, curHrp = findAliveCharacter()
						if not curChar or not curHrp then
							break
						end
						task.wait(0.1)
						elapsed += 0.1
					end

					local returnChar, _, returnHrp = findAliveCharacter()
					if state.isAutoTrainOn and returnChar and returnHrp then
						local lookTarget = targetCFrame.Position + targetCFrame.LookVector * 5
						safeTeleport(returnChar, targetCFrame.Position, lookTarget, 2.0, true)
						returnHrp.CFrame = targetCFrame
						task.wait(0.25)

						local tState = localPlayer:GetAttribute("TrainingClientState")
						if tState == "READY" and gameApi.TrainingRemote then
							requestCount += 1
							pcall(function()
								gameApi.TrainingRemote:FireServer("Start", requestCount)
							end)
							activeTrainedZoneId = zoneId
						end
					end
				end)

				if not ok then
					warn("Auto Training Rear Pause Failed: " .. tostring(err))
				end

				arrivedAtZoneAt = os.clock()
				arrivedZoneId = zoneId
				lastTrainActionTime = os.clock()
				isRearPauseRunning = false
			end

		function trainSys.RunTrainStep()
			if not state.isAutoTrainOn then
				activeTrainedZoneId = nil
				arrivedZoneId = nil
				return
			end

			if trainResetRequested then
				trainResetRequested = false
				table.clear(unusableZoneUntil)
				table.clear(zoneEntryAttempts)
				activeTrainedZoneId = nil
				arrivedZoneId = nil
				lastTrainActionTime = 0
			end

			if isRearPauseRunning or os.clock() - lastTrainActionTime <= 1.0 then
				return
			end

			local character, _, hrp = findAliveCharacter()
			if not character or not hrp then
				return
			end

			local curWorld = getCurrentWorldId(hrp.Position)
			local reb, lvl, pow = getPlayerProgression()
			local progressSig = tostring(curWorld) .. ":" .. tostring(reb) .. ":" .. tostring(lvl) .. ":" .. tostring(math.floor(pow))

			-- Khi chuyển sang Map/World mới hoặc vừa tăng cấp/rebirth/power -> xóa cache đồ bị khóa để nhận diện ngay đồ tập mới mở khóa
			if curWorld ~= lastObservedWorldId or progressSig ~= lastObservedProgressSig then
				lastObservedWorldId = curWorld
				lastObservedProgressSig = progressSig
				table.clear(unusableZoneUntil)
				table.clear(zoneEntryAttempts)
			end

			local rankedZones = getRankedTrainingZones(curWorld)
			local bestEntry = rankedZones[1]
			if not bestEntry then
				lastTrainActionTime = os.clock()
				return
			end

			local bestZoneId = bestEntry.Id
			local bestZoneData = bestEntry.Data
			local targetWorldId = bestEntry.WorldId
			local localIndex = bestEntry.LocalIndex

			local tState = localPlayer:GetAttribute("TrainingClientState")
			local isTrainingAttr = localPlayer:GetAttribute("IsTraining") == true
			local currentZone = tonumber(localPlayer:GetAttribute("TrainingZone"))
			local isActivelyTraining = isTrainingAttr or tState == "TRAINING" or tState == "ACTIVE"

			-- Nếu đang tập trên một đồ tập khác (cũ hơn) và vừa mở khóa đồ tập tốt hơn -> thoát đồ cũ để chuyển sang đồ mới
			if isActivelyTraining then
				local currentlyOnOlderZone = (currentZone ~= nil and currentZone ~= bestZoneId)
					or (currentZone == nil and activeTrainedZoneId ~= nil and activeTrainedZoneId ~= bestZoneId)
				if currentlyOnOlderZone then
					if gameApi.TrainingRemote then
						requestCount += 1
						pcall(function()
							gameApi.TrainingRemote:FireServer("Exit", requestCount)
						end)
						task.wait(0.2)
					end
					activeTrainedZoneId = nil
					arrivedZoneId = nil
					isActivelyTraining = false
					tState = localPlayer:GetAttribute("TrainingClientState")
					currentZone = tonumber(localPlayer:GetAttribute("TrainingZone"))
				else
					activeTrainedZoneId = currentZone or bestZoneId
					zoneEntryAttempts[bestZoneId] = 0
					return
				end
			end

			local targetCFrame = ensureTrainingTargetCFrame(character, hrp, bestZoneId, bestZoneData, targetWorldId, localIndex)
			if not targetCFrame then
				-- Đồ tập không tìm thấy / chưa khả dụng -> đánh dấu tạm thời để chuyển ngay sang đồ tập tốt tiếp theo
				unusableZoneUntil[bestZoneId] = os.clock() + 15
				lastTrainActionTime = os.clock()
				return
			end

			character, _, hrp = findAliveCharacter()
			if not character or not hrp then
				return
			end

			if not isAtTargetEquipment(hrp.Position, targetCFrame.Position) then
				local lookTarget = targetCFrame.Position + targetCFrame.LookVector * 5
				safeTeleport(character, targetCFrame.Position, lookTarget, 2.0, true)

				local refinedCF = getTrainingTargetCFrame(bestZoneId, bestZoneData, targetWorldId, localIndex) or targetCFrame
				character, _, hrp = findAliveCharacter()
				if character and hrp and not isAtTargetEquipment(hrp.Position, refinedCF.Position) then
					hrp.Anchored = false
					hrp.AssemblyLinearVelocity = Vector3.zero
					character:PivotTo(refinedCF)
					hrp.CFrame = refinedCF
				end

				arrivedAtZoneAt = os.clock()
				arrivedZoneId = bestZoneId
				lastTrainActionTime = os.clock()
				task.wait(0.25)

				local newState = localPlayer:GetAttribute("TrainingClientState")
				if newState == "READY" and gameApi.TrainingRemote then
					requestCount += 1
					pcall(function()
						gameApi.TrainingRemote:FireServer("Start", requestCount)
					end)
					activeTrainedZoneId = bestZoneId
				end
			elseif tState == "READY" then
				requestCount += 1
				pcall(function()
					gameApi.TrainingRemote:FireServer("Start", requestCount)
				end)
				activeTrainedZoneId = bestZoneId
				lastTrainActionTime = os.clock()
			elseif (tState == "OUTSIDE" or tState == "WAIT_FOR_REENTRY" or tState == nil or (currentZone ~= bestZoneId and currentZone ~= nil))
				and (arrivedZoneId ~= bestZoneId or os.clock() - arrivedAtZoneAt > 1.5)
			then
				local tries = (zoneEntryAttempts[bestZoneId] or 0) + 1
				zoneEntryAttempts[bestZoneId] = tries
				if tries >= 3 then
					-- Sau 2 lần thử vào vùng tập nhưng không thể sử dụng -> bỏ qua đồ này 20s và chọn đồ tốt tiếp theo
					unusableZoneUntil[bestZoneId] = os.clock() + 20
					zoneEntryAttempts[bestZoneId] = 0
					arrivedZoneId = nil
					lastTrainActionTime = os.clock()
				else
					performRearPauseAndReturn(targetCFrame, bestZoneId)
				end
			end
		end
		return trainSys
	end)()

