local function roundTenth(value)
	return math.floor(value * 10 + 0.5) / 10
end

local function lateralCommand(target, offset, velocity)
	local gap = target - offset - velocity / tuning.LateralResponse
	if math.abs(gap) <= tuning.LateralDeadband then
		return 0
	end
	local command = roundTenth(math.clamp(gap * tuning.LateralGain, -1, 1))
	if math.abs(command) < tuning.LateralDeadzone then
		return 0
	end
	return command
end

local function verticalCommand(target, height, velocity)
	local gap = target - height - velocity / tuning.VerticalResponse
	local command = 0
	if math.abs(gap) > tuning.VerticalDeadband then
		command = math.clamp(gap * tuning.VerticalGain, -1, 1)
		if math.abs(command) < 0.2 then
			command = if gap > 0 then 0.2 else -0.2
		end
	elseif target ~= 0 then
		command = if target > 0 then 0.2 else -0.2
	end
	command = roundTenth(command)
	if math.abs(command) < tuning.VerticalDeadzone then
		return 0
	end
	return command
end

local function integrateLateral(offset, velocity, command, deltaTime)
	local targetVelocity = command * tuning.LateralSpeed
	local response = tuning.LateralResponse
	local decay = math.exp(-response * deltaTime)
	local nextOffset = offset + targetVelocity * deltaTime + (velocity - targetVelocity) * (1 - decay) / response
	local nextVelocity = targetVelocity + (velocity - targetVelocity) * decay
	return nextOffset, nextVelocity
end

local function integrateVertical(height, velocity, command, deltaTime)
	local response = tuning.VerticalResponse
	local steps = math.max(1, math.ceil(deltaTime / (1 / 60)))
	local stepTime = deltaTime / steps
	local decay = math.exp(-response * stepTime)
	for _ = 1, steps do
		local targetVelocity = command * tuning.VerticalSpeed
		if command == 0 then
			targetVelocity = math.clamp(-height * tuning.ReturnRate, -tuning.ReturnMaxDescent, tuning.ReturnMaxRise)
		end
		height = height + targetVelocity * stepTime + (velocity - targetVelocity) * (1 - decay) / response
		velocity = targetVelocity + (velocity - targetVelocity) * decay
	end
	return height, velocity
end

local function lanePoint(sim, along, lateral, height)
	local origin = sim.Origin
	local heading = sim.Heading
	local right = sim.RightDirection
	return Vector3.new(
		origin.X + heading.X * along + right.X * lateral,
		height,
		origin.Z + heading.Z * along + right.Z * lateral
	)
end

local function laneBox(sim, frame, halfSize)
	local heading = sim.Heading
	local right = sim.RightDirection
	local frameRight = frame.RightVector
	local frameUp = frame.UpVector
	local frameLook = frame.LookVector
	local relative = frame.Position - sim.Origin
	local alongExtent = math.abs(heading:Dot(frameRight)) * halfSize.X
		+ math.abs(heading:Dot(frameUp)) * halfSize.Y
		+ math.abs(heading:Dot(frameLook)) * halfSize.Z
	local lateralExtent = math.abs(right:Dot(frameRight)) * halfSize.X
		+ math.abs(right:Dot(frameUp)) * halfSize.Y
		+ math.abs(right:Dot(frameLook)) * halfSize.Z
	local heightExtent = math.abs(frameRight.Y) * halfSize.X + math.abs(frameUp.Y) * halfSize.Y + math.abs(frameLook.Y) * halfSize.Z
	local along = relative:Dot(heading)
	local lateral = relative:Dot(right)
	local height = frame.Position.Y
	return along - alongExtent, along + alongExtent, lateral - lateralExtent, lateral + lateralExtent, height - heightExtent, height + heightExtent
end

local function isAxisAligned(frame)
	for _, axis in {frame.RightVector, frame.UpVector, frame.LookVector} do
		if math.max(math.abs(axis.X), math.abs(axis.Y), math.abs(axis.Z)) <= 0.9995 then
			return false
		end
	end
	return true
end

local function makeBlock(sim, frame, halfSize, margin)
	local alongLow, alongHigh, lateralLow, lateralHigh, heightLow, heightHigh = laneBox(sim, frame, halfSize)
	return {
		AlongLow = alongLow,
		AlongHigh = alongHigh,
		LateralLow = lateralLow,
		LateralHigh = lateralHigh,
		HeightLow = heightLow,
		HeightHigh = heightHigh,
		HardPad = tuning.HardPad + margin,
		SoftPad = tuning.SoftPad + margin,
		Frame = if isAxisAligned(frame) then nil else frame,
		Half = halfSize,
	}
end

local function addToSample(blocks, index, block)
	local list = blocks[index]
	if not list then
		list = {}
		blocks[index] = list
	end
	table.insert(list, block)
end

local function insertBlock(course, blocks, block)
	local pad = block.SoftPad
	local first = math.max(1, math.ceil((block.AlongLow - pad - course.ResponsePad - course.Along[0]) / course.StepDistance))
	local last = math.min(course.Count, math.floor((block.AlongHigh + pad - course.Along[0]) / course.StepDistance) + 1)
	for index = first, last do
		addToSample(blocks, index, block)
	end
end

local function resetPlanner(record)
	local world = gameApi.WorldConfig.AtPosition(record.Sim.Origin)
	planner.Record = record
	planner.WorldId = (world and world.WorldId) or 1
	planner.StaticBlocks = {}
	planner.Extras = {}
	planner.Target = nil
	planner.PlanCount = 0
	planner.RayParams = gameApi.FlightSim.BuildRaycastParams()
end

local function buildCourse(sim)
	local speed = math.max((sim.MotionSpeed or sim.Speed or 0) * tuning.TimeScale, 25)
	local stepTime = tuning.Horizon / tuning.Samples
	local stepDistance = speed * stepTime
	local profileStart = (sim.World1 and sim.PathAlong) or sim.Along
	local course = {
		Speed = speed,
		StepTime = stepTime,
		StepDistance = stepDistance,
		ResponsePad = speed * tuning.ResponseTime,
		Count = 0,
		Along = {[0] = sim.Along},
		BaseY = {},
		BandLow = {},
		BandHigh = {},
		BoundLow = {},
		BoundHigh = {},
		Late = {},
	}
	for index = 1, tuning.Samples do
		local baseY, progress, heightOffset = sim:_profileY(profileStart + stepDistance * index)
		if progress >= 1 then
			break
		end
		local along = sim.Along + stepDistance * index
		local bandLow, bandHigh = gameApi.FlightSteering.VerticalBand(progress, heightOffset)
		local boundLow, boundHigh = gameApi.FlightSteering.Limits(sim.SteeringBounds, along)
		course.Along[index] = along
		course.BaseY[index] = baseY
		course.BandLow[index] = bandLow
		course.BandHigh[index] = math.min(bandHigh, math.max(0, sim:CeilingRoom(baseY)))
		course.BoundLow[index] = boundLow
		course.BoundHigh[index] = boundHigh
		course.Late[index] = progress >= tuning.CruiseEnd
		course.Count = index
	end
	return course
end

local function simulateLateral(sim, course, firstTarget, secondTarget, switchIndex, prefix)
	local offset = sim.LateralOffset or 0
	local velocity = sim.LateralVelocity or 0
	local wind = sim.WindDrift or 0
	local subTime = course.StepTime / 2
	local path = {[0] = offset}
	local velocities = {[0] = velocity}
	local startIndex = 1
	if prefix and switchIndex then
		local shared = math.min(switchIndex, course.Count)
		for index = 1, shared do
			path[index] = prefix.Path[index]
			velocities[index] = prefix.Velocities[index]
		end
		offset = path[shared]
		velocity = velocities[shared]
		startIndex = shared + 1
	end
	for index = startIndex, course.Count do
		local target = firstTarget
		if switchIndex and index > switchIndex then
			target = secondTarget
		end
		local boundLow = course.BoundLow[index]
		local boundHigh = course.BoundHigh[index]
		for _ = 1, 2 do
			local command = lateralCommand(target, offset, velocity)
			local nextOffset, nextVelocity = integrateLateral(offset, velocity, command, subTime)
			nextOffset += wind * subTime
			offset = math.clamp(nextOffset, math.min(offset, boundLow), math.max(offset, boundHigh))
			velocity = nextVelocity
		end
		path[index] = offset
		velocities[index] = velocity
	end
	return path, velocities
end

local function simulateHeights(sim, course, verticalTarget)
	local heights = {[0] = sim.Pos.Y}
	local height = sim.ManualHeightOffset or 0
	local velocity = sim.ManualHeightVelocity or 0
	local subTime = course.StepTime / 2
	local ceiling = sim.CeilingY
	for index = 1, course.Count do
		local bandLow = course.BandLow[index]
		local bandHigh = course.BandHigh[index]
		if sim.World1 then
			for _ = 1, 2 do
				local command = verticalCommand(verticalTarget, height, velocity)
				if command > 0 then
					command *= math.clamp((bandHigh - height) / tuning.CeilingSoftZone, 0, 1)
				end
				height, velocity = integrateVertical(height, velocity, command, subTime)
				if height > bandHigh then
					height = bandHigh
					velocity = math.min(velocity, 0)
				end
				if height < bandLow then
					height = bandLow
					velocity = math.max(velocity, 0)
				end
			end
		end
		local y = course.BaseY[index] + height
		if ceiling and y > ceiling then
			y = ceiling
		end
		heights[index] = y
	end
	return heights
end

local function addTimedBlocks(sim, course, blocks, hazard, moving, serverNow)
	local heading = sim.Heading
	local origin = sim.Origin
	local reach = tuning.SoftPad + tuning.MovingMargin + 4
	local timeMargin = if moving then tuning.MovingTimeMargin else tuning.LaserTimeMargin
	for index = 1, course.Count do
		local startX = origin.X + heading.X * course.Along[index - 1]
		local endX = origin.X + heading.X * course.Along[index]
		if hazard.MinX <= math.max(startX, endX) + reach and math.min(startX, endX) - reach <= hazard.MaxX then
			local sampleTime = serverNow + (index - 0.5) * course.StepTime
			for _, time in {sampleTime, sampleTime - timeMargin, sampleTime + timeMargin} do
				local frame, halfSize = gameApi.HazardSystem.Box(hazard, time)
				if frame then
					local block = makeBlock(sim, frame, halfSize, tuning.MovingMargin)
					local pad = block.SoftPad
					if course.Along[index] + course.ResponsePad >= block.AlongLow - pad and course.Along[index - 1] <= block.AlongHigh + pad then
						addToSample(blocks, index, block)
					end
					if not moving then
						break
					end
				end
			end
		end
	end
end

local function collectBlocks(sim, course)
	local blocks = {}
	local hazards = gameApi.HazardSystem.ByWorld[planner.WorldId] or {}
	local heading = sim.Heading
	local origin = sim.Origin
	local startX = origin.X + heading.X * course.Along[0]
	local endX = origin.X + heading.X * course.Along[course.Count]
	local lowX = math.min(startX, endX) - 12
	local highX = math.max(startX, endX) + 12
	local serverNow = workspace:GetServerTimeNow()
	for _, hazard in hazards do
		if hazard.MinX > highX then
			break
		end
		if hazard.MaxX >= lowX and hazard.Collide ~= false then
			local moving = hazard.Motion ~= nil and hazard.Motion.Kind ~= "Spin"
			if moving or hazard.Laser then
				addTimedBlocks(sim, course, blocks, hazard, moving, serverNow)
			else
				local cached = planner.StaticBlocks[hazard]
				if cached == nil then
					local frame, halfSize = gameApi.HazardSystem.Box(hazard, 0)
					cached = if frame then makeBlock(sim, frame, halfSize, 0) else false
					planner.StaticBlocks[hazard] = cached
				end
				if cached then
					insertBlock(course, blocks, cached)
				end
			end
		end
	end
	local now = os.clock()
	for index = #planner.Extras, 1, -1 do
		local extra = planner.Extras[index]
		if extra.Until < now then
			table.remove(planner.Extras, index)
		else
			insertBlock(course, blocks, extra)
		end
	end
	return blocks
end

local function crossingPoint(course, along)
	local index = math.clamp(math.ceil((along - course.Along[0]) / course.StepDistance), 1, course.Count)
	local fraction = math.clamp((along - course.Along[index - 1]) / course.StepDistance, 0, 1)
	return index, fraction
end

local function addTarget(targets, sim, course, kind, weight, along, positionAt)
	local index, fraction = crossingPoint(course, along)
	local crossTime = (index - 1 + fraction) * course.StepTime
	local position = positionAt(crossTime)
	local relative = position - sim.Origin
	table.insert(targets, {
		Kind = kind,
		Weight = weight,
		Index = index,
		Fraction = fraction,
		Time = crossTime,
		Lateral = relative:Dot(sim.RightDirection),
		Height = position.Y,
	})
end

local function collectTargets(sim, record, course)
	local targets = {}
	local firstAlong = course.Along[0]
	local lastAlong = course.Along[course.Count]
	local flightId = record.Id or flight.Id
	local ringClock = math.max(0, (sim.Time or 0) - tuning.FixedStep + (record.Acc or 0)) / tuning.TimeScale
	local positiveTypes = gameApi.RingConfig.Positive or {}
	for _, ring in rings do
		local isSlow = ring.Type == "Slow"
		local isWanted = isSlow or positiveTypes[ring.Type] == true or ring.Type == "Reward"
		if ring.FlightId == flightId and isWanted then
			local along = (ring.Position - sim.Origin):Dot(sim.Heading)
			if along > firstAlong and along <= lastAlong then
				addTarget(targets, sim, course, if isSlow then "Slow" else "Item", itemWeights[ring.Type] or 5, along, function(crossTime)
					return ring.Position + gameApi.RingConfig.MotionOffset(ring.Motion, ring.Right, ringClock + crossTime)
				end)
			end
		end
	end
	for _, candyPosition in candies do
		local along = (candyPosition - sim.Origin):Dot(sim.Heading)
		if along > firstAlong and along <= lastAlong then
			addTarget(targets, sim, course, "Item", itemWeights.Candy, along, function()
				return candyPosition
			end)
		end
	end
	table.sort(targets, function(first, second)
		return first.Time < second.Time
	end)
	return targets
end

local function activeLateralTarget(target)
	if target.SwitchAt and os.clock() >= target.SwitchAt then
		return target.Second
	end
	return target.First
end

local function buildCandidates(sim, course, targets)
	local low = math.huge
	local high = -math.huge
	for index = 1, course.Count do
		low = math.min(low, course.BoundLow[index])
		high = math.max(high, course.BoundHigh[index])
	end
	local candidates = {}
	local function add(first, second, switchIndex, prefix)
		table.insert(candidates, {First = first, Second = second, Switch = switchIndex, Prefix = prefix})
	end
	add(sim.LateralOffset or 0)
	if planner.Target then
		add(activeLateralTarget(planner.Target))
	end
	if low >= high then
		return candidates
	end
	local width = high - low
	local step = math.max(3, width / 36)
	local lateral = low
	while lateral <= high + 0.001 do
		add(lateral)
		lateral += step
	end
	local items = {}
	for _, target in targets do
		if target.Kind == "Item" and target.Lateral >= low - 2 and target.Lateral <= high + 2 and #items < tuning.MaxItems then
			table.insert(items, target)
		end
	end
	for itemIndex, item in items do
		local itemPrefix = {First = item.Lateral}
		add(item.Lateral)
		for laterIndex = itemIndex + 1, #items do
			add(item.Lateral, items[laterIndex].Lateral, item.Index, itemPrefix)
		end
		for share = 0, 6 do
			add(item.Lateral, low + width * share / 6, item.Index, itemPrefix)
		end
	end
	local previous = planner.Target
	local now = os.clock()
	if previous and previous.SwitchAt and previous.SwitchAt > now then
		add(previous.First, previous.Second, math.ceil((previous.SwitchAt - now) / course.StepTime))
	end
	local lanes = {}
	for share = 0, tuning.TwoStageLanes do
		table.insert(lanes, low + width * share / tuning.TwoStageLanes)
	end
	local firsts = {}
	for laneIndex, lane in lanes do
		if laneIndex % tuning.TwoStageRotate == planner.PlanCount % tuning.TwoStageRotate then
			table.insert(firsts, lane)
		end
	end
	table.insert(firsts, sim.LateralOffset or 0)
	if previous then
		table.insert(firsts, activeLateralTarget(previous))
	end
	for _, first in firsts do
		local firstPrefix = {First = first}
		for _, second in lanes do
			if math.abs(second - first) >= step then
				for _, switchIndex in tuning.TwoStageSwitches do
					if switchIndex < course.Count then
						add(first, second, switchIndex, firstPrefix)
					end
				end
			end
		end
	end
	return candidates
end

local function edgeCost(course, path)
	local total = 0
	for index = 1, course.Count do
		local room = math.min(path[index] - course.BoundLow[index], course.BoundHigh[index] - path[index])
		if room < tuning.EdgeZone then
			total += tuning.EdgeCost * (1 - math.max(room, 0) / tuning.EdgeZone)
		end
	end
	return total / course.Count
end

local function checkPath(sim, course, blocks, lateralPath, heights)
	local softCost = 0
	for index = 1, course.Count do
		local list = blocks[index]
		if list then
			local lateralStart = lateralPath[index - 1]
			local lateralEnd = lateralPath[index]
			local heightStart = heights[index - 1]
			local heightEnd = heights[index]
			local alongStart = course.Along[index - 1]
			local alongEnd = course.Along[index] + course.ResponsePad
			local lateralLow = math.min(lateralStart, lateralEnd)
			local lateralHigh = math.max(lateralStart, lateralEnd)
			local heightLow = math.min(heightStart, heightEnd)
			local heightHigh = math.max(heightStart, heightEnd)
			for _, block in list do
				local soft = block.SoftPad
				local softOverlap = alongEnd >= block.AlongLow - soft
					and alongStart <= block.AlongHigh + soft
					and lateralHigh >= block.LateralLow - soft
					and lateralLow <= block.LateralHigh + soft
					and heightHigh >= block.HeightLow - soft
					and heightLow <= block.HeightHigh + soft
				if softOverlap then
					local hard = block.HardPad
					local softHit = true
					local hardHit
					if block.Frame then
						local startPoint = lanePoint(sim, alongStart, lateralStart, heightStart)
						local endPoint = lanePoint(sim, alongEnd, lateralEnd, heightEnd)
						softHit = gameApi.HazardSystem.SegmentBox(block.Frame, block.Half, startPoint, endPoint, soft) ~= nil
						hardHit = softHit and gameApi.HazardSystem.SegmentBox(block.Frame, block.Half, startPoint, endPoint, hard) ~= nil
					else
						hardHit = alongEnd >= block.AlongLow - hard
							and alongStart <= block.AlongHigh + hard
							and lateralHigh >= block.LateralLow - hard
							and lateralLow <= block.LateralHigh + hard
							and heightHigh >= block.HeightLow - hard
							and heightLow <= block.HeightHigh + hard
					end
					if hardHit then
						local depth = math.min(lateralEnd - (block.LateralLow - hard), block.LateralHigh + hard - lateralEnd)
						return index, softCost, math.max(depth, 0)
					end
					if softHit then
						softCost += tuning.SoftCost
					end
				end
			end
		end
	end
	return nil, softCost
end

local function scoreTargets(targets, lateralPath, heights)
	local cost = 0
	for _, target in targets do
		local index = target.Index
		local fraction = target.Fraction
		local lateral = lateralPath[index - 1] + (lateralPath[index] - lateralPath[index - 1]) * fraction
		local height = heights[index - 1] + (heights[index] - heights[index - 1]) * fraction
		local distance = math.sqrt((lateral - target.Lateral) ^ 2 + (height - target.Height) ^ 2)
		if target.Kind == "Slow" then
			if distance < tuning.SlowClearance then
				cost += tuning.SlowCost + (tuning.SlowClearance - distance) * 100
			end
		else
			local share = 0
			if distance <= tuning.PassRadius then
				share = 1
			elseif distance <= tuning.CollectRadius then
				share = 0.6
			end
			cost -= target.Weight * share * (1 - 0.3 * target.Time / tuning.Horizon)
		end
	end
	return cost
end

local function choosePlan(sim, course, blocks, targets, candidates, heightPaths)
	local previous = planner.Target
	local previousLateral = if previous then activeLateralTarget(previous) else (sim.LateralOffset or 0)
	local previousVertical = if previous then previous.Vertical else 0
	local best = nil
	for _, candidate in candidates do
		local prefix = candidate.Prefix
		if prefix and not prefix.Path then
			prefix.Path, prefix.Velocities = simulateLateral(sim, course, prefix.First)
			prefix.LatestHit = 0
			for _, option in heightPaths do
				local hitIndex = checkPath(sim, course, blocks, prefix.Path, option.Heights) or math.huge
				prefix.LatestHit = math.max(prefix.LatestHit, hitIndex)
			end
		end
		if prefix and prefix.LatestHit <= candidate.Switch then
			continue
		end
		if not candidate.Path then
			candidate.Path = simulateLateral(sim, course, candidate.First, candidate.Second, candidate.Switch, prefix)
			candidate.Edge = edgeCost(course, candidate.Path)
		end
		local lateralCost = candidate.Edge + math.abs(candidate.First - previousLateral) * tuning.LateralChangeCost
		if candidate.Second then
			lateralCost += math.abs(candidate.Second - candidate.First) * tuning.LateralChangeCost
		end
		for _, option in heightPaths do
			local hitIndex, softCost, hitDepth = checkPath(sim, course, blocks, candidate.Path, option.Heights)
			local cost = lateralCost + softCost + scoreTargets(targets, candidate.Path, option.Heights)
			cost += math.abs(option.Target) * tuning.VerticalHoldCost
			if option.Target ~= previousVertical then
				cost += tuning.VerticalSwitchCost
			end
			if hitIndex then
				cost += tuning.CrashCost + (course.Count - hitIndex) * 1e3
				cost += math.min(hitDepth, tuning.StuckDepthLimit) * tuning.StuckDepthCost
			end
			if not best or cost < best.Cost then
				best = {Cost = cost, Candidate = candidate, Vertical = option.Target, Heights = option.Heights, Hit = hitIndex}
			end
		end
	end
	return best
end

local function isFlightBarrier(instance)
	local current = instance
	while current and current ~= workspace do
		if current.Name == "FlightBarrier"
			or current.Name == "FlightBarriers"
			or current:GetAttribute("FlightBarrier") == true
			or current:HasTag("FlightBarrier")
		then
			return true
		end
		current = current.Parent
	end
	return false
end

local function ignoreInCasts(params, instance)
	local filter = params.FilterDescendantsInstances
	table.insert(filter, instance)
	params.FilterDescendantsInstances = filter
end

local function castTerrain(startPoint, endPoint, radius, late)
	local params = planner.RayParams
	local offset = endPoint - startPoint
	local length = offset.Magnitude
	if length < 0.001 then
		return nil
	end
	local direction = offset / length
	local travelled = 0
	for _ = 1, 4 do
		local sphereHit = workspace:Spherecast(startPoint + direction * travelled, radius, direction * (length - travelled), params)
		if not sphereHit then
			return nil
		end
		if isFlightBarrier(sphereHit.Instance) then
			ignoreInCasts(params, sphereHit.Instance)
		elseif sphereHit.Normal.Y < 0.6 then
			return sphereHit.Position
		else
			local rayHit = workspace:Raycast(startPoint - Vector3.yAxis * tuning.GroundClearance, offset, params)
			if rayHit and not isFlightBarrier(rayHit.Instance) and not (late and rayHit.Normal.Y >= 0.7) then
				return rayHit.Position
			end
			travelled += sphereHit.Distance + 1.5
			if travelled >= length then
				return nil
			end
		end
	end
	return nil
end

local function findTerrainBlock(sim, course, best)
	local path = best.Candidate.Path
	local heights = best.Heights
	local startPoint = sim.Pos
	local limit = math.min(course.Count, tuning.VerifySamples)
	for index = 1, limit do
		local endPoint = lanePoint(sim, course.Along[index], path[index], heights[index])
		local hitPosition = castTerrain(startPoint, endPoint, tuning.HardPad + 0.3, course.Late[index])
		if hitPosition then
			local relative = hitPosition - sim.Origin
			local along = relative:Dot(sim.Heading)
			local lateral = relative:Dot(sim.RightDirection)
			local extra = {
				AlongLow = along - 2,
				AlongHigh = along + 6,
				LateralLow = lateral - 2.5,
				LateralHigh = lateral + 2.5,
				HeightLow = -math.huge,
				HeightHigh = math.huge,
				HardPad = tuning.HardPad,
				SoftPad = tuning.SoftPad,
				Until = os.clock() + tuning.BlockMemory,
			}
			table.insert(planner.Extras, extra)
			return extra
		end
		startPoint = endPoint
	end
	return nil
end

local function planFlight(record)
	local sim = record.Sim
	if planner.Record ~= record then
		resetPlanner(record)
	end
	planner.PlanCount += 1
	local course = buildCourse(sim)
	if course.Count < 2 then
		planner.Target = nil
		return
	end
	local targets = collectTargets(sim, record, course)
	local blocks = collectBlocks(sim, course)
	local candidates = buildCandidates(sim, course, targets)
	local heightPaths = {}
	for _, option in (if sim.World1 then tuning.VerticalOptions else {0}) do
		table.insert(heightPaths, {Target = option, Heights = simulateHeights(sim, course, option)})
	end
	local best = choosePlan(sim, course, blocks, targets, candidates, heightPaths)
	for _ = 1, 3 do
		if not best or best.Hit then
			break
		end
		local extra = findTerrainBlock(sim, course, best)
		if not extra then
			break
		end
		insertBlock(course, blocks, extra)
		best = choosePlan(sim, course, blocks, targets, candidates, heightPaths)
	end
	if not best then
		planner.Target = nil
		return
	end
	local candidate = best.Candidate
	planner.Target = {
		First = candidate.First,
		Second = candidate.Second,
		SwitchAt = if candidate.Switch then os.clock() + candidate.Switch * course.StepTime else nil,
		Vertical = best.Vertical,
	}
end

local function applyTarget(sim)
	local target = planner.Target
	if not target then
		releaseAssist()
		return
	end
	local lateral = lateralCommand(activeLateralTarget(target), sim.LateralOffset or 0, sim.LateralVelocity or 0)
	local vertical = 0
	if sim.World1 then
		vertical = verticalCommand(target.Vertical, sim.ManualHeightOffset or 0, sim.ManualHeightVelocity or 0)
	end
	gameApi.SetAssist(lateral, vertical)
	planner.AssistActive = true
end

local function steerStep()
	if not gameApi.Ready then
		return
	end
	local record = flight.Record
	local wanted = state.isAutoThrowOn
		and isOwnFlightActive()
		and canSteer(record)
		and not isGameSmartFlightOn()
	if not wanted then
		releaseAssist()
		return
	end
	local now = os.clock()
	if now >= planner.NextPlanAt then
		planner.NextPlanAt = now + tuning.PlanInterval
		local planSucceeded = pcall(planFlight, record)
		if not planSucceeded then
			planner.Target = nil
		end
	end
	applyTarget(record.Sim)
end

local function onPlaneFlightEvent(kind, data)
	if type(data) ~= "table" then
		return
	end
	if kind == "Launched" or kind == "Revived" then
		if data.UserId ~= localPlayer.UserId then
			return
		end
		flight.Id = data.FlightId
		flight.Active = true
		flight.StartedAt = os.clock()
		flight.Record = nil
		flight.ReturnDeadline = 0
		flight.LaunchCount += 1
		for ringId, ring in rings do
			if ring.FlightId ~= data.FlightId then
				rings[ringId] = nil
			end
		end
		requestRecord(30)
	elseif kind == "Landed" then
		if data.FlightId ~= nil and data.FlightId == flight.Id then
			flight.Active = false
			flight.ReturnDeadline = os.clock() + tuning.ReturnWait
		end
	elseif kind == "Returned" or kind == "Cancelled" then
		if data.FlightId ~= nil and data.FlightId == flight.Id then
			flight.Active = false
			flight.ReturnDeadline = 0
		end
	elseif kind == "Rejected" then
		flight.RejectCount += 1
	elseif kind == "RingSpawn" then
		if data.RingId ~= nil and typeof(data.Position) == "Vector3" then
			rings[data.RingId] = data
		end
	elseif kind == "RingCollected" or kind == "RingRemoved" then
		if data.RingId ~= nil then
			rings[data.RingId] = nil
		end
	elseif kind == "RingClear" then
		for ringId, ring in rings do
			if data.FlightId == nil or ring.FlightId == data.FlightId then
				rings[ringId] = nil
			end
		end
	end
end

