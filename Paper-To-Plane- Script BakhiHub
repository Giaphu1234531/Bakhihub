local isVerifying = false
local function handleSubmitKey()
	if isVerifying then return end
	isVerifying = true
	submitBtn.Text = "CHECKING..."
	statusLabel.Text = "Verifying key with server..."
	statusLabel.TextColor3 = c.a2

	task.spawn(function()
		local valid, message, cleanKey = validateKey(keyInput.Text)
		if valid then
			statusLabel.Text = message or "Key verified! Loading hub..."
			statusLabel.TextColor3 = c.ok
			submitBtn.Text = "UNLOCKED"
			saveKeyToDisk(cleanKey)
			task.wait(0.45)
			if keyGui and keyGui.Parent then
				keyGui:Destroy()
			end
			startBaKhiHub()
		else
			statusLabel.Text = message or "Invalid key!"
			statusLabel.TextColor3 = c.er
			submitBtn.Text = "SUBMIT KEY"
			isVerifying = false
		end
	end)
end

submitBtn.Activated:Connect(handleSubmitKey)

