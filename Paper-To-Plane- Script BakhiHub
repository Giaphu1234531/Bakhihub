	local function patchMultiWorldNitroSim(flightSim)
		if type(flightSim) ~= "table" or flightSim.__BakhiNitroMultiWorldPatched then
			return
		end
		if type(flightSim.SetNitro) == "function" then
			local origSetNitro = flightSim.SetNitro
			flightSim.SetNitro = function(self, seq, simStart, duration, ...)
				if type(self) == "table" and not self.Landed and not self.Sliding and not self.Impact and not self.Crashed then
					if self.World1 ~= true then
						self.World1 = true
					end
				end
				return origSetNitro(self, seq, simStart, duration, ...)
			end
		end
		flightSim.__BakhiNitroMultiWorldPatched = true
	end

	local function collectNitroHandlers()
