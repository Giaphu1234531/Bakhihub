local function findLaunchRegion(position)
	local currentWorld = gameApi.WorldConfig.AtPosition(position)
	local nearestRegion = nil
	local nearestDistance = math.huge
	for _, world in gameApi.WorldConfig.Worlds do
		local zone = type(world.LaunchZone) == "string" and resolveInstancePath(world.LaunchZone)
		local region = zone and zone:FindFirstChild("LaunchRegion")
		if region and region:IsA("BasePart") then
			if world == currentWorld then
				return region
			end
			local distance = (region.Position - position).Magnitude
			if distance < nearestDistance then
				nearestRegion = region
				nearestDistance = distance
			end
		end
	end
	return nearestRegion
end

local function isInsideRegion(region, position)
	local localPosition = region.CFrame:PointToObjectSpace(position)
	local halfSize = region.Size / 2
	return math.abs(localPosition.X) <= halfSize.X
		and math.abs(localPosition.Y) <= halfSize.Y
		and math.abs(localPosition.Z) <= halfSize.Z
end

local function moveIntoLaunchRegion(character, root, region)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}
	params.RespectCanCollide = true
	local regionTop = region.Position + Vector3.yAxis * (region.Size.Y / 2)
	local floorHit = workspace:Raycast(regionTop, Vector3.yAxis * -(region.Size.Y + 20), params)
	local standY = if floorHit then floorHit.Position.Y + 3 else region.Position.Y
	local standPosition = Vector3.new(region.Position.X, standY, region.Position.Z)
	if not isInsideRegion(region, standPosition) then
		standPosition = region.Position
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.CFrame = CFrame.new(standPosition) * root.CFrame.Rotation
end

local function isLaneClear(blocked, offset)
	for _, span in blocked do
		if offset >= span.Low and offset <= span.High then
			return false
		end
	end
	return true
end

local function findClearLanePosition(root, region)
	local world = gameApi.WorldConfig.AtPosition(root.Position)
	local hazards = world and gameApi.HazardSystem.ByWorld[world.WorldId]
	if not hazards then
		return nil
	end
	local heading = world.RunwayDirection or Vector3.xAxis
	local lane = {Origin = root.Position, Heading = heading, RightDirection = heading:Cross(Vector3.yAxis).Unit}
	local endX = root.Position.X + heading.X * tuning.LaneCheckDistance
	local lowX = math.min(root.Position.X, endX)
	local highX = math.max(root.Position.X, endX)
	local floorY = world.TrackFloorY or root.Position.Y
	local pad = tuning.SoftPad + tuning.LaneMargin
	local blocked = {}
	for _, hazard in hazards do
		if hazard.MinX > highX then
			break
		end
		local moving = hazard.Motion ~= nil and hazard.Motion.Kind ~= "Spin"
		if hazard.MaxX >= lowX and hazard.Collide ~= false and not moving then
			local frame = hazard.BoxCF or CFrame.new(hazard.Center)
			local alongLow, alongHigh, lateralLow, lateralHigh, heightLow, heightHigh = laneBox(lane, frame, hazard.Half)
			local isAhead = alongHigh >= 0 and alongLow <= tuning.LaneCheckDistance
			local isInHeight = heightHigh >= floorY - pad and heightLow <= floorY + tuning.LaneHeight + pad
			if isAhead and isInHeight then
				table.insert(blocked, {Low = lateralLow - pad, High = lateralHigh + pad})
			end
		end
	end
	if isLaneClear(blocked, 0) then
		return nil
	end
	local edgeOffset = lane.RightDirection * tuning.LaneEdgeMargin
	for step = 1, tuning.LaneSearchSteps do
		local distance = step * tuning.LaneStep
		for _, offset in {distance, -distance} do
			local position = root.Position + lane.RightDirection * offset
			local isInside = isInsideRegion(region, position + edgeOffset) and isInsideRegion(region, position - edgeOffset)
			if isInside and isLaneClear(blocked, offset) then
				return position
			end
		end
	end
	return nil
end

local function shouldRelease(heldTime, frameTime)
	if heldTime >= 3 then
		return true
	end
	local perfect = gameApi.PerfectWindow
	if not perfect then
		local charge = flightConfig.Charge
		return flightConfig.PowerAt(heldTime) >= ((charge and charge.PerfectMin) or 0.95)
	end
	if heldTime < perfect.First + 0.004 then
		return false
	end
	return heldTime >= perfect.Target - frameTime / 2 or heldTime + frameTime >= perfect.Last - 0.004
end

local function waitForLaunch(launchCount, rejectCount)
	local deadline = os.clock() + 12
	while state.isRunning and os.clock() < deadline do
		if flight.LaunchCount > launchCount then
			return 0.5
		end
		if flight.RejectCount > rejectCount then
			return 1.2
		end
		task.wait(0.1)
	end
	return 1.2
end

local function throwOnce()
	if not gameApi.Ready then
		return 0.5
	end
	if isGameAutoThrowOn() then
		return 2
	end
	if os.clock() < flight.ReturnDeadline then
		return 0.1
	end
	if isOwnFlightActive() or isGamePaused() then
		return 0.5
	end
	local character, humanoid, root = findAliveCharacter()
	if not character then
		return 1
	end
	if not gameApi.HeldTool() then
		if equipPlane(humanoid) then
			return 0.6
		end
		return 3
	end
	if not gameApi.InZone() then
		local region = findLaunchRegion(root.Position)
		if not region then
			return 3
		end
		moveIntoLaunchRegion(character, root, region)
		return 0.6
	end
	local laneRegion = findLaunchRegion(root.Position)
	local lanePosition = laneRegion and findClearLanePosition(root, laneRegion)
	if lanePosition then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.new(lanePosition) * root.CFrame.Rotation
		return 0.6
	end
	if gameApi.ThrowBlocked(false) then
		return 0.3
	end
	local launchCount = flight.LaunchCount
	local rejectCount = flight.RejectCount
	gameApi.OnInputBegan(throwInput, false)
	if not gameApi.ThrowBlocked(false) then
		return 1.2
	end
	local chargeStart = os.clock()
	local frameTime = 1 / 60
	while not shouldRelease(os.clock() - chargeStart, frameTime) do
		frameTime = RunService.Heartbeat:Wait()
	end
	gameApi.OnInputEnded(throwInput)
	return waitForLaunch(launchCount, rejectCount)
end

local function runAutoThrow(job)
	while isJobRunning(job) do
		local delay = 0.5
		if state.isAutoThrowOn then
			local throwSucceeded, result = pcall(throwOnce)
			delay = if throwSucceeded then result else 3
		end
		task.wait(delay)
	end
end

