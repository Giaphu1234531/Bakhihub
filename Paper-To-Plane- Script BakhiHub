		function eggSys.MarkMapManuallySelected()
			eggStats.userPinnedMap = true
		end

		function eggSys.GetStatusText()
			local targetWorldId = catalog.GetMapId(state.selectedEggMap)
			local mapName = catalog.GetMapName(targetWorldId)
			local activeEggs = eggSys.GetActiveEggsForMap(targetWorldId)
			if #activeEggs == 0 then
				return string.format("%s | Selected Eggs: None", mapName)
			end
			local items = {}
			local totalOwned = 0
			for _, info in ipairs(activeEggs) do
				local owned = getOwnedEggCount(info.Id)
				totalOwned += owned
				table.insert(items, string.format("%s (%d)", info.Name, owned))
			end
			local summary = string.format("%s | Bag: %d | Opened: %d\n%s", mapName, totalOwned, eggStats.totalHatched, table.concat(items, " | "))
			if eggStats.lastPetSummary ~= "" then
				summary = summary .. "\nLast: " .. eggStats.lastPetSummary
			elseif eggStats.lastError ~= "" then
				summary = summary .. "\nStatus: " .. eggStats.lastError
			end
			return summary
		end

		function eggSys.HasEggWork()
			if not gameApi.Ready or not state.isAutoOpenEggOn or not gameApi.BackendClient then
				return false
			end
			local character, _, root = findAliveCharacter()
			if not character or not root or character:GetAttribute("PlaneThrowPhase") ~= nil then
				return false
			end
			local targetWorldId = catalog.GetMapId(state.selectedEggMap)
			local activeEggs = eggSys.GetActiveEggsForMap(targetWorldId)
			if #activeEggs == 0 then
				return false
			end
			for _, eggInfo in ipairs(activeEggs) do
				if getOwnedEggCount(eggInfo.Id) > 0 then
					return true
				end
			end

			local now = os.clock()
			local eggsSig = getSelectedEggsSig(activeEggs)
			if eggSkipCache.worldId == targetWorldId and eggSkipCache.eggsSig == eggsSig then
				if now < eggSkipCache.noModelUntil or now < eggSkipCache.lockedUntil then
					return false
				end
				if eggSkipCache.minNeededPrice ~= nil and getPlayerCoins() < eggSkipCache.minNeededPrice then
					return false
				end
			end

			if not isTargetWorldUnlocked(targetWorldId) then
				eggSkipCache.worldId = targetWorldId
				eggSkipCache.eggsSig = eggsSig
				eggSkipCache.lockedUntil = now + 8
				return false
			end

			local minEggPrice = nil
			for _, eggInfo in ipairs(activeEggs) do
				local eggDef = gameApi.PetEggConfig and gameApi.PetEggConfig.Eggs and gameApi.PetEggConfig.Eggs[eggInfo.Id]
				local eggPrice = (eggDef and tonumber(eggDef.Price)) or tonumber(eggInfo.Price) or 0
				local isRobuxOnly = (eggDef and eggDef.RobuxOnly == true) or (eggInfo.RobuxOnly == true)
				if not isRobuxOnly and eggPrice > 0 then
					if not minEggPrice or eggPrice < minEggPrice then
						minEggPrice = eggPrice
					end
				end
			end

			if not minEggPrice or getPlayerCoins() < minEggPrice then
				eggSkipCache.worldId = targetWorldId
				eggSkipCache.eggsSig = eggsSig
				eggSkipCache.minNeededPrice = minEggPrice or math.huge
				return false
			end

			return true
		end

		function eggSys.RunEggStep()
			if not eggSys.HasEggWork() then
				return false
			end

			if type(gameApi.BackendClient.Profile) ~= "table" then
				ensureProfileLoaded(true)
			end

			if localPlayer:GetAttribute("IsTraining") == true and gameApi.TrainingRemote then
				pcall(function()
					gameApi.TrainingRemote:FireServer("Exit", 99999)
				end)
				task.wait(0.2)
			end

			local character, _, root = findAliveCharacter()
			if not character or not root or isEggActionBlocked(character) then
				return false
			end

			local targetWorldId = catalog.GetMapId(state.selectedEggMap)
			local activeEggs = eggSys.GetActiveEggsForMap(targetWorldId)
			if #activeEggs == 0 then
				return false
			end

			local eggsSig = getSelectedEggsSig(activeEggs)
			local didAction = false
			local cooldown = (gameApi.PetEggConfig and tonumber(gameApi.PetEggConfig.Cooldown)) or 0.6

			for _, eggInfo in ipairs(activeEggs) do
				if not state.isRunning or not state.isAutoOpenEggOn then
					break
				end

				local eggId = eggInfo.Id

				-- 1. Mở toàn bộ trứng đã có sẵn trong túi (Profile.Eggs) bằng BackendClient.Call("HatchOwnedEgg", eggId)
				while state.isRunning and state.isAutoOpenEggOn do
					local ownedCount = getOwnedEggCount(eggId)
					if ownedCount <= 0 then
						break
					end

					local okCall, res = pcall(gameApi.BackendClient.Call, "HatchOwnedEgg", eggId)
					if not okCall or type(res) ~= "table" then
						break
					end
					if res.busy then
						task.wait(0.2)
						continue
					end
					if res.ok then
						didAction = true
						syncProfileFromResponse(res)
						if type(gameApi.BackendClient.Profile) == "table" and type(gameApi.BackendClient.Profile.Eggs) == "table" then
							if getOwnedEggCount(eggId) >= ownedCount then
								gameApi.BackendClient.Profile.Eggs[eggId] = math.max(0, ownedCount - 1)
							end
						end
						recordHatchOutcome(eggId, res.Results, 1)
						task.wait(math.max(0.25, cooldown))
					else
						eggStats.lastError = tostring(res.msg or "HatchOwnedEgg failed")
						break
					end
				end

				if not state.isRunning or not state.isAutoOpenEggOn then
					break
				end

				-- 2. Tự mua và mở trứng bằng Coins qua RemoteFunction HatchEgg:InvokeServer(eggId, count)
				local eggDef = gameApi.PetEggConfig and gameApi.PetEggConfig.Eggs and gameApi.PetEggConfig.Eggs[eggId]
				local eggPrice = (eggDef and tonumber(eggDef.Price)) or tonumber(eggInfo.Price) or 0
				local isRobuxOnly = (eggDef and eggDef.RobuxOnly == true) or (eggInfo.RobuxOnly == true)

				if not isRobuxOnly and eggPrice > 0 and gameApi.HatchEgg then
					if not isTargetWorldUnlocked(targetWorldId) then
						eggStats.lastError = "World " .. tostring(targetWorldId) .. " is locked"
						eggSkipCache.worldId = targetWorldId
						eggSkipCache.eggsSig = eggsSig
						eggSkipCache.lockedUntil = os.clock() + 8
						break
					end

					while state.isRunning and state.isAutoOpenEggOn and getPlayerCoins() >= eggPrice do
						character, _, root = findAliveCharacter()
						if not character or not root or isEggActionBlocked(character) then
							break
						end
						local eggModel = moveToMapEgg(character, root, eggId, targetWorldId)
						if not eggModel then
							eggStats.lastError = "Egg model not found in " .. catalog.GetMapName(targetWorldId)
							eggSkipCache.worldId = targetWorldId
							eggSkipCache.eggsSig = eggsSig
							eggSkipCache.noModelUntil = os.clock() + 15
							break
						end

						local coins = getPlayerCoins()
						local hatchCount = getPreferredMapHatchCount(eggDef or eggInfo, coins)
						local okInvoke, hatchRes = pcall(gameApi.HatchEgg.InvokeServer, gameApi.HatchEgg, eggId, hatchCount)
						if okInvoke and type(hatchRes) == "table" and hatchRes.ok then
							didAction = true
							syncProfileFromResponse(hatchRes)
							recordHatchOutcome(eggId, hatchRes.Results, hatchCount)
							task.wait(math.max(0.25, cooldown))
						elseif okInvoke and type(hatchRes) == "table" and hatchRes.busy then
							task.wait(0.25)
						elseif hatchCount > 1 then
							local okSingle, singleRes = pcall(gameApi.HatchEgg.InvokeServer, gameApi.HatchEgg, eggId, 1)
							if okSingle and type(singleRes) == "table" and singleRes.ok then
								didAction = true
								syncProfileFromResponse(singleRes)
								recordHatchOutcome(eggId, singleRes.Results, 1)
								task.wait(math.max(0.25, cooldown))
							else
								if type(singleRes) == "table" and singleRes.msg then
									eggStats.lastError = tostring(singleRes.msg)
								end
								break
							end
						else
							if type(hatchRes) == "table" and hatchRes.msg then
								eggStats.lastError = tostring(hatchRes.msg)
							end
							break
						end
					end
				end
			end

			-- Cập nhật cache giá tối thiểu nếu sau khi mở xong không còn đủ tiền mua tiếp
			local nextMinEgg = nil
			for _, eggInfo in ipairs(activeEggs) do
				local eggDef = gameApi.PetEggConfig and gameApi.PetEggConfig.Eggs and gameApi.PetEggConfig.Eggs[eggInfo.Id]
				local eggPrice = (eggDef and tonumber(eggDef.Price)) or tonumber(eggInfo.Price) or 0
				local isRobuxOnly = (eggDef and eggDef.RobuxOnly == true) or (eggInfo.RobuxOnly == true)
				if not isRobuxOnly and eggPrice > 0 then
					if not nextMinEgg or eggPrice < nextMinEgg then
						nextMinEgg = eggPrice
					end
				end
			end
			if not nextMinEgg or getPlayerCoins() < nextMinEgg then
				eggSkipCache.worldId = targetWorldId
				eggSkipCache.eggsSig = eggsSig
				eggSkipCache.minNeededPrice = nextMinEgg or math.huge
			end

			return didAction
		end
		return eggSys
	end)()

	-- ================= MODULE AUTO TRAINING & REBIRTH =================
	local trainSys = (function()
		local trainSys = {}
		local trainResetRequested = false

		function trainSys.NotifyToggleOn()
			trainResetRequested = true
		end

		function trainSys.ClickX2Button()
			pcall(function()
